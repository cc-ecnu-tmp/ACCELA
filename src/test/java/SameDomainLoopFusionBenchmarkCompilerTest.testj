import static org.junit.jupiter.api.Assertions.assertArrayEquals;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.pass.PassRegistry;
import accela.pass.PipelineProfile;
import accela.pass.SameDomainLoopFusionCandidate;
import accela.util.StrictJson;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.List;
import java.util.Map;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;

final class SameDomainLoopFusionBenchmarkCompilerTest {
  private static final String SOURCE = """
      int temporary[128];
      int output[128];
      int main() {
        int n = getint();
        int i = 0;
        while (i < n) {
          temporary[i] = i * 3 + 1;
          i = i + 1;
        }
        i = 0;
        while (i < n) {
          output[i] = temporary[i] * 5;
          i = i + 1;
        }
        int sum = 0;
        i = 0;
        while (i < n) {
          sum = sum + output[i];
          i = i + 1;
        }
        putint(sum);
        putch(10);
        return 0;
      }
      """;

  @TempDir Path temporaryDirectory;

  @Test
  void enabledCandidateRunsThroughTheRealDevelopmentCompilerAndRv64gcBackend()
      throws Exception {
    PassRegistry registry = PassRegistry.standard();
    Path input = temporaryDirectory.resolve("fusion.sy");
    Path profile = temporaryDirectory.resolve("enabled.json");
    Path assembly = temporaryDirectory.resolve("enabled.s");
    Path remarks = temporaryDirectory.resolve("enabled.jsonl");
    Files.writeString(input, SOURCE, StandardCharsets.UTF_8);
    PipelineProfile.builder(registry)
        .enableCandidate(SameDomainLoopFusionCandidate.ID)
        .build()
        .writeJson(profile);
    BenchmarkCompiler.main(new String[] {
        input.toString(), "-o", assembly.toString(), "--profile", profile.toString(),
        "--remarks", remarks.toString()
    });

    assertTrue(Files.readString(assembly, StandardCharsets.UTF_8).contains("main:"));
    List<Map<?, ?>> candidateEvents = Files.readAllLines(remarks).stream()
        .map(StrictJson::parse).<Map<?, ?>>map(value -> (Map<?, ?>) value)
        .filter(event -> SameDomainLoopFusionCandidate.ID.equals(event.get("pass")))
        .toList();
    assertTrue(candidateEvents.stream()
        .anyMatch(event -> "applied".equals(event.get("decision"))));
    assertEquals("pass_summary", candidateEvents.getLast().get("event_type"));
    assertEquals(Boolean.TRUE, candidateEvents.getLast().get("changed"));
  }

  @Test
  void disabledCandidateIsSilentAndKeepsJudgeAssemblyIdentical()
      throws Exception {
    PassRegistry registry = PassRegistry.standard();
    Path input = temporaryDirectory.resolve("disabled.sy");
    Path profile = temporaryDirectory.resolve("disabled.json");
    Path assembly = temporaryDirectory.resolve("disabled.s");
    Path judgeAssembly = temporaryDirectory.resolve("judge.s");
    Path remarks = temporaryDirectory.resolve("disabled.jsonl");
    Files.writeString(input, SOURCE, StandardCharsets.UTF_8);
    PipelineProfile.full(registry).writeJson(profile);
    BenchmarkCompiler.main(new String[] {
        input.toString(), "-o", assembly.toString(), "--profile", profile.toString(),
        "--remarks", remarks.toString()
    });
    Compiler.main(new String[] {
        input.toString(), "-S", "-o", judgeAssembly.toString(), "-O1"
    });

    assertArrayEquals(Files.readAllBytes(judgeAssembly), Files.readAllBytes(assembly));
    assertTrue(Files.readAllLines(remarks).stream()
        .map(StrictJson::parse).map(value -> (Map<?, ?>) value)
        .noneMatch(event -> SameDomainLoopFusionCandidate.ID.equals(event.get("pass"))));
  }

  @Test
  void allFourFrozenOracleStructuresReachTheRealCandidateTransform() throws Exception {
    PassRegistry registry = PassRegistry.standard();
    Path profile = temporaryDirectory.resolve("oracles-enabled.json");
    PipelineProfile.builder(registry)
        .enableCandidate(SameDomainLoopFusionCandidate.ID)
        .build()
        .writeJson(profile);
    List<Path> sources = List.of(
        Path.of("benchmarks/oracles/fusion/single_temporary/baseline.sy"),
        Path.of("benchmarks/oracles/fusion/stencil_producer/baseline.sy"),
        Path.of("benchmarks/oracles/fusion/two_temporaries/baseline.sy"),
        Path.of("benchmarks/oracles/boom_ilp/independent_chains/baseline.sy"));
    for (int index = 0; index < sources.size(); index++) {
      Path assembly = temporaryDirectory.resolve("oracle-" + index + ".s");
      Path remarks = temporaryDirectory.resolve("oracle-" + index + ".jsonl");
      BenchmarkCompiler.main(new String[] {
          sources.get(index).toString(), "-o", assembly.toString(),
          "--profile", profile.toString(), "--remarks", remarks.toString()
      });
      assertTrue(Files.readAllLines(remarks).stream()
          .map(StrictJson::parse).map(value -> (Map<?, ?>) value)
          .filter(event -> SameDomainLoopFusionCandidate.ID.equals(event.get("pass")))
          .anyMatch(event -> "applied".equals(event.get("decision"))),
          "candidate did not transform " + sources.get(index));
    }
  }

  @Test
  void disabledCandidateAlsoKeepsFloatingPointJudgeAssemblyIdentical() throws Exception {
    PassRegistry registry = PassRegistry.standard();
    Path input = temporaryDirectory.resolve("floating.sy");
    Path profile = temporaryDirectory.resolve("floating-disabled.json");
    Path assembly = temporaryDirectory.resolve("floating-disabled.s");
    Path judgeAssembly = temporaryDirectory.resolve("floating-judge.s");
    Path remarks = temporaryDirectory.resolve("floating-disabled.jsonl");
    Files.writeString(input, """
        float transform(float value) { return value * 1.5 + 2.0; }
        int main() { putfloat(transform(getfloat())); return 0; }
        """, StandardCharsets.UTF_8);
    PipelineProfile.full(registry).writeJson(profile);
    BenchmarkCompiler.main(new String[] {
        input.toString(), "-o", assembly.toString(), "--profile", profile.toString(),
        "--remarks", remarks.toString()
    });
    Compiler.main(new String[] {
        input.toString(), "-S", "-o", judgeAssembly.toString(), "-O1"
    });

    assertArrayEquals(Files.readAllBytes(judgeAssembly), Files.readAllBytes(assembly));
    assertTrue(Files.readAllLines(remarks).stream()
        .map(StrictJson::parse).map(value -> (Map<?, ?>) value)
        .noneMatch(event -> SameDomainLoopFusionCandidate.ID.equals(event.get("pass"))));
  }

}
