import static org.junit.jupiter.api.Assertions.assertArrayEquals;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.backend.BackendCompiler;
import accela.backend.instrument.BackendPassInstrumentation;
import accela.pass.FiniteStateAccelerationCandidate;
import accela.pass.FiniteStateAccelerationCandidatePassBuilder;
import accela.pass.FiniteStateAccelerationCandidateRegistry;
import accela.pass.PassBuilder;
import accela.pass.PassRegistry;
import accela.pass.PipelineProfile;
import accela.pass.ir.instrument.PassInstrumentation;
import accela.util.StrictJson;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.atomic.AtomicInteger;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;

final class FiniteStateAccelerationBenchmarkCompilerTest {
  private static final Map<String, String> SOURCES = sources();

  @TempDir Path temporaryDirectory;

  @Test
  void allThreeFrozenStructuresRunThroughTheRealDevelopmentCompilerAndBackend()
      throws Exception {
    PassRegistry registry = FiniteStateAccelerationCandidateRegistry.create();
    for (Map.Entry<String, String> source : SOURCES.entrySet()) {
      Path input = temporaryDirectory.resolve(source.getKey() + ".sy");
      Path profile = temporaryDirectory.resolve(source.getKey() + ".json");
      Path assembly = temporaryDirectory.resolve(source.getKey() + ".s");
      Path remarks = temporaryDirectory.resolve(source.getKey() + ".jsonl");
      Files.writeString(input, source.getValue(), StandardCharsets.UTF_8);
      PipelineProfile.builder(registry)
          .enableCandidate(FiniteStateAccelerationCandidate.ID)
          .build()
          .writeJson(profile);
      CandidateDevelopmentPipeline pipeline = new CandidateDevelopmentPipeline(registry);

      BenchmarkCompiler.runForTesting(new String[] {
          input.toString(), "-o", assembly.toString(), "--profile", profile.toString(),
          "--remarks", remarks.toString()
      }, pipeline);

      assertEquals(1, pipeline.passFactoryInvocations.get());
      String emittedAssembly = Files.readString(assembly, StandardCharsets.UTF_8);
      assertTrue(emittedAssembly.contains("main:"));
      assertTrue(emittedAssembly.contains("__accela_fsa_main_"));
      List<Map<?, ?>> candidateEvents = Files.readAllLines(remarks).stream()
          .map(StrictJson::parse).<Map<?, ?>>map(value -> (Map<?, ?>) value)
          .filter(event -> FiniteStateAccelerationCandidate.ID.equals(event.get("pass")))
          .toList();
      assertEquals(java.util.Arrays.asList("candidate", "applied", null), candidateEvents.stream()
          .map(event -> event.get("decision")).toList());
      assertEquals("pass_summary", candidateEvents.getLast().get("event_type"));
      assertEquals(Boolean.TRUE, candidateEvents.getLast().get("changed"));
    }
  }

  @Test
  void disabledCandidateNeverConstructsFactoryAndKeepsJudgeAssemblyIdentical()
      throws Exception {
    PassRegistry registry = FiniteStateAccelerationCandidateRegistry.create();
    Path input = temporaryDirectory.resolve("disabled.sy");
    Path profile = temporaryDirectory.resolve("disabled.json");
    Path assembly = temporaryDirectory.resolve("disabled.s");
    Path judgeAssembly = temporaryDirectory.resolve("judge.s");
    Path remarks = temporaryDirectory.resolve("disabled.jsonl");
    Files.writeString(input, SOURCES.get("affine_mod97"), StandardCharsets.UTF_8);
    PipelineProfile.full(registry).writeJson(profile);
    CandidateDevelopmentPipeline pipeline = new CandidateDevelopmentPipeline(registry);

    BenchmarkCompiler.runForTesting(new String[] {
        input.toString(), "-o", assembly.toString(), "--profile", profile.toString(),
        "--remarks", remarks.toString()
    }, pipeline);
    Compiler.main(new String[] {
        input.toString(), "-S", "-o", judgeAssembly.toString(), "-O1"
    });

    assertEquals(0, pipeline.passFactoryInvocations.get());
    assertArrayEquals(Files.readAllBytes(judgeAssembly), Files.readAllBytes(assembly));
    assertTrue(Files.readAllLines(remarks).stream()
        .map(StrictJson::parse).map(value -> (Map<?, ?>) value)
        .noneMatch(event -> FiniteStateAccelerationCandidate.ID.equals(event.get("pass"))));
  }

  private static Map<String, String> sources() {
    LinkedHashMap<String, String> sources = new LinkedHashMap<>();
    sources.put("affine_mod97", source("return (state * 5 + 1) % 97;", 97));
    sources.put("branch_mod53", source(
        "if (state % 3 == 0) { return (state + 17) % 53; } "
            + "return (state * 2 + 7) % 53;",
        53));
    sources.put("quadratic_mod31", source("return (state * state + 3) % 31;", 31));
    return Map.copyOf(sources);
  }

  private static String source(String transitionBody, int domain) {
    return """
        int transition(int state) {
          %s
        }
        int main() {
          int bound = getint();
          int seed = getint();
          int state = seed %% %d;
          int index = 0;
          while (index < bound) {
            state = transition(state);
            index = index + 1;
          }
          putint(state);
          putch(10);
          return 0;
        }
        """.formatted(transitionBody, domain);
  }

  private static final class CandidateDevelopmentPipeline
      implements BenchmarkCompiler.DevelopmentPipeline {
    private final PassRegistry registry;
    private final AtomicInteger passFactoryInvocations = new AtomicInteger();

    CandidateDevelopmentPipeline(PassRegistry registry) {
      this.registry = registry;
    }

    @Override
    public PassRegistry registry() {
      return registry;
    }

    @Override
    public PassBuilder passBuilder(PassInstrumentation instrumentation) {
      return FiniteStateAccelerationCandidatePassBuilder.create(
          instrumentation, passFactoryInvocations);
    }

    @Override
    public BackendCompiler backendCompiler(
        PipelineProfile profile, BackendPassInstrumentation instrumentation) {
      return new BackendCompiler(profile, instrumentation);
    }
  }
}
