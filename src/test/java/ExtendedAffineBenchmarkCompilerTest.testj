import static org.junit.jupiter.api.Assertions.assertArrayEquals;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNotEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.pass.PassRegistry;
import accela.pass.PipelineProfile;
import accela.pass.candidate.ExtendedAffineSummarizationCandidate;
import accela.util.StrictJson;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.List;
import java.util.Map;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;

final class ExtendedAffineBenchmarkCompilerTest {
  @TempDir Path temporaryDirectory;

  @Test
  void realDevelopmentEntryExecutesOnlyWhenExplicitlyEnabled() throws Exception {
    Path input = temporaryDirectory.resolve("extended-affine.sy");
    Files.writeString(input, """
        int main() {
          int n = getint();
          int seed = getint();
          int state = seed;
          int i = 0;
          while (i < n) {
            state = state + i * i + 2 * i + 1;
            i = i + 1;
          }
          putint(state);
          return 0;
        }
        """, StandardCharsets.UTF_8);
    PassRegistry registry = PassRegistry.standard();

    Path enabledProfile = temporaryDirectory.resolve("enabled.json");
    Path enabledAssembly = temporaryDirectory.resolve("enabled.s");
    Path enabledRemarks = temporaryDirectory.resolve("enabled.jsonl");
    PipelineProfile.builder(registry)
        .enableCandidate(ExtendedAffineSummarizationCandidate.ID)
        .build().writeJson(enabledProfile);
    BenchmarkCompiler.main(new String[] {
        input.toString(), "-o", enabledAssembly.toString(),
        "--profile", enabledProfile.toString(), "--remarks", enabledRemarks.toString()
    });

    Path disabledProfile = temporaryDirectory.resolve("disabled.json");
    Path disabledAssembly = temporaryDirectory.resolve("disabled.s");
    Path disabledRemarks = temporaryDirectory.resolve("disabled.jsonl");
    Path judgeAssembly = temporaryDirectory.resolve("judge.s");
    PipelineProfile.full(registry).writeJson(disabledProfile);
    BenchmarkCompiler.main(new String[] {
        input.toString(), "-o", disabledAssembly.toString(),
        "--profile", disabledProfile.toString(), "--remarks", disabledRemarks.toString()
    });
    Compiler.main(new String[] {
        input.toString(), "-S", "-o", judgeAssembly.toString(), "-O1"
    });

    assertArrayEquals(Files.readAllBytes(judgeAssembly), Files.readAllBytes(disabledAssembly));
    assertNotEquals(Files.readString(disabledAssembly), Files.readString(enabledAssembly));
    List<Map<?, ?>> enabledEvents = records(enabledRemarks).stream()
        .filter(event -> ExtendedAffineSummarizationCandidate.ID.equals(event.get("pass")))
        .toList();
    assertTrue(enabledEvents.stream().anyMatch(event -> "candidate".equals(event.get("decision"))));
    assertTrue(enabledEvents.stream().anyMatch(event -> "applied".equals(event.get("decision"))));
    assertTrue(enabledEvents.stream().anyMatch(event ->
        "pass_summary".equals(event.get("event_type")) && Boolean.TRUE.equals(event.get("changed"))));
    assertTrue(records(disabledRemarks).stream().noneMatch(event ->
        ((String) event.get("pass")).startsWith("candidate.")));
  }

  private static List<Map<?, ?>> records(Path path) throws Exception {
    return Files.readAllLines(path).stream()
        .map(StrictJson::parse).<Map<?, ?>>map(value -> (Map<?, ?>) value).toList();
  }

}
