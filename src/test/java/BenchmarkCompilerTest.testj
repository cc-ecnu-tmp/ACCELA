final class BenchmarkCompilerTest {
  private static final String CANDIDATE_EMPTY_BASELINE_REVISION =
      "0c957676856e7209deb15d1fefa3f10429c9d277";

  @TempDir Path tempDirectory;

  @Test
  void compilesWithProfileAndEmitsStructuredIrAndBackendRemarks() throws Exception {
    Path input = tempDirectory.resolve("case.sy");
    Path profile = tempDirectory.resolve("profile.json");
    Path assembly = tempDirectory.resolve("case.s");
    Path remarks = tempDirectory.resolve("case.jsonl");
    Files.writeString(input, "int main() { return 0; }", StandardCharsets.UTF_8);
    Files.writeString(profile, """
        {
          "schema_version": 2,
          "base": "FULL",
          "disable": [
            {"pass": "ir.loop-interchange"},
            {"pass": "backend.machine-licm"}
          ],
          "enable_candidates": []
        }
        """, StandardCharsets.UTF_8);

    BenchmarkCompiler.main(new String[] {
        input.toString(), "-o", assembly.toString(), "--profile", profile.toString(),
        "--remarks", remarks.toString()
    });

    assertTrue(Files.readString(assembly).contains("main:"));
    List<Map<?, ?>> records = Files.readAllLines(remarks).stream()
        .map(StrictJson::parse)
        .<Map<?, ?>>map(value -> (Map<?, ?>) value)
        .toList();
    assertFalse(records.isEmpty());
    assertTrue(records.stream().anyMatch(record -> "ir.sroa".equals(record.get("pass"))));
    assertTrue(records.stream().anyMatch(record ->
        "backend.register-allocation".equals(record.get("pass"))
            && ((Map<?, ?>) record.get("details")).containsKey("stack_locations")));
    assertTrue(records.stream().noneMatch(record ->
        "ir.loop-interchange".equals(record.get("pass"))
            || "backend.machine-licm".equals(record.get("pass"))));
    assertTrue(records.stream().allMatch(record -> record.containsKey("elapsed_ns")
        && record.containsKey("before") && record.containsKey("after")
        && record.containsKey("delta")));
    assertTrue(records.stream().allMatch(record ->
        PassRegistry.standard().find((String) record.get("pass")) != null));
    assertEquals(List.of(1, 2, 3, 4, 5, 6, 7), records.stream()
        .filter(record -> "ir.early-cse".equals(record.get("pass")))
        .map(record -> ((BigDecimal) record.get("occurrence")).intValueExact())
        .toList());
    assertTrue(records.stream().allMatch(record ->
        "optimization-remark.v2".equals(record.get("schema_version"))
            && "pass_summary".equals(record.get("event_type"))));
    assertTrue(records.stream().filter(record -> Set.of(
            PassRegistry.IR_AFFINE_LOOP_SUMMARIZATION,
            PassRegistry.IR_RANKED_RECURRENCE_TABULATION).contains(record.get("pass")))
        .allMatch(record -> "available".equals(record.get("decision_observability"))));
    assertTrue(records.stream().filter(record -> !Set.of(
            PassRegistry.IR_AFFINE_LOOP_SUMMARIZATION,
            PassRegistry.IR_RANKED_RECURRENCE_TABULATION).contains(record.get("pass")))
        .allMatch(record -> "unavailable".equals(record.get("decision_observability"))));
  }

  @Test
  void fullProfileIsByteIdenticalToTheJudgeFacingCompiler() throws Exception {
    Path input = tempDirectory.resolve("parity.sy");
    Path profile = tempDirectory.resolve("full.json");
    Path production = tempDirectory.resolve("production.s");
    Path benchmark = tempDirectory.resolve("benchmark.s");
    Path remarks = tempDirectory.resolve("parity.jsonl");
    Files.writeString(input, """
        int main() {
          int value = getint();
          return value % 8;
        }
        """, StandardCharsets.UTF_8);
    PipelineProfile.full().writeJson(profile);

    Compiler.main(new String[] {
        input.toString(), "-S", "-o", production.toString(), "-O1"
    });
    BenchmarkCompiler.main(new String[] {
        input.toString(), "-o", benchmark.toString(), "--profile", profile.toString(),
        "--remarks", remarks.toString()
    });

    assertArrayEquals(Files.readAllBytes(production), Files.readAllBytes(benchmark));
    assertTrue(Files.readAllLines(remarks).stream()
        .map(StrictJson::parse)
        .map(value -> (Map<?, ?>) value)
        .noneMatch(record -> ((String) record.get("pass")).startsWith("candidate.")));
  }

  @Test
  void fullProfileIsByteIdenticalForFloatingPointCode() throws Exception {
    Path input = tempDirectory.resolve("float-parity.sy");
    Path profile = tempDirectory.resolve("float-full.json");
    Path production = tempDirectory.resolve("float-production.s");
    Path benchmark = tempDirectory.resolve("float-benchmark.s");
    Path remarks = tempDirectory.resolve("float-parity.jsonl");
    Files.writeString(input, """
        float transform(float value) {
          return value * 1.5 + 2.0;
        }
        int main() {
          putfloat(transform(getfloat()));
          return 0;
        }
        """, StandardCharsets.UTF_8);
    PipelineProfile.full().writeJson(profile);

    Compiler.main(new String[] {
        input.toString(), "-S", "-o", production.toString(), "-O1"
    });
    BenchmarkCompiler.main(new String[] {
        input.toString(), "-o", benchmark.toString(), "--profile", profile.toString(),
        "--remarks", remarks.toString()
    });

    assertArrayEquals(Files.readAllBytes(production), Files.readAllBytes(benchmark));
    assertTrue(Files.readAllLines(remarks).stream()
        .map(StrictJson::parse)
        .map(value -> (Map<?, ?>) value)
        .noneMatch(record -> ((String) record.get("pass")).startsWith("candidate.")));
  }

  @Test
  void candidateEmptyIntegerAndFloatingAssemblyMatchFrozenBaselineRevision() throws Exception {
    assertEquals(
        CANDIDATE_EMPTY_BASELINE_REVISION + "\n",
        new String(baselineResource("REVISION"), StandardCharsets.UTF_8));
    Map<String, String> checksums = new HashMap<>();
    for (String line : new String(
        baselineResource("SHA256SUMS"), StandardCharsets.UTF_8).lines().toList()) {
      String[] fields = line.split("\\s+", 2);
      checksums.put(fields[1], fields[0]);
    }

    assertBaselineFixture("integer", checksums);
    assertBaselineFixture("floating", checksums);
  }

  @Test
  void rejectsUnknownOrIncompleteArguments() {
    assertThrows(IllegalArgumentException.class,
        () -> BenchmarkCompiler.parseArguments(new String[] {"case.sy", "--unknown", "x"}));
    assertThrows(IllegalArgumentException.class,
        () -> BenchmarkCompiler.parseArguments(new String[] {"case.sy", "-o", "case.s"}));
  }

  @Test
  void exportsTheCanonicalRegistryWithoutCompileArguments() throws Exception {
    Path registry = tempDirectory.resolve("pass-registry.json");

    BenchmarkCompiler.main(new String[] {"--export-registry", registry.toString()});

    assertEquals(PassRegistry.standard().toJson() + "\n",
        Files.readString(registry, StandardCharsets.UTF_8));
    Map<?, ?> document = (Map<?, ?>) StrictJson.parse(Files.readString(registry));
    assertEquals("pass-registry.v2", document.get("schema_version"));
    assertEquals(PassRegistry.standard().all().size(), ((List<?>) document.get("passes")).size());
    assertThrows(IllegalArgumentException.class,
        () -> BenchmarkCompiler.parseRegistryExport(
            new String[] {"--export-registry", registry.toString(), "extra"}));
  }

  @Test
  void mandatoryOnlyProfileCompilesAndRunsOnlyRequiredStages() throws Exception {
    Path input = tempDirectory.resolve("mandatory.sy");
    Path profile = tempDirectory.resolve("mandatory.json");
    Path assembly = tempDirectory.resolve("mandatory.s");
    Path remarks = tempDirectory.resolve("mandatory.jsonl");
    Files.writeString(input, "int main() { return 0; }", StandardCharsets.UTF_8);
    PipelineProfile.mandatoryOnly().writeJson(profile);

    BenchmarkCompiler.main(new String[] {
        input.toString(), "-o", assembly.toString(), "--profile", profile.toString(),
        "--remarks", remarks.toString()
    });

    Set<String> passes = Files.readAllLines(remarks).stream()
        .map(StrictJson::parse)
        .map(value -> (Map<?, ?>) value)
        .map(record -> (String) record.get("pass"))
        .collect(Collectors.toSet());
    assertEquals(Set.of(
        PassRegistry.IR_MEM2REG,
        PassRegistry.BACKEND_IR_LOWERING,
        PassRegistry.BACKEND_PHI_ELIMINATION,
        PassRegistry.BACKEND_REGISTER_ALLOCATION,
        PassRegistry.BACKEND_ASM_EMISSION), passes);
    assertTrue(Files.readString(assembly).contains("main:"));
  }

  @Test
  void writesTypedDecisionEventsAndRejectsInvalidDecisionSequences() throws Exception {
    Path output = tempDirectory.resolve("decisions.jsonl");
    try (JsonlRemarkWriter writer = new JsonlRemarkWriter(output)) {
      var descriptor = PassRegistry.standard().require(PassRegistry.IR_AFFINE_LOOP_SUMMARIZATION);
      var invalid = writer.decisionEmitter(descriptor, 1, "function", "@candidate");
      assertThrows(IllegalStateException.class,
          () -> invalid.applied(DecisionReasonCode.APPLIED_PROFITABLE));

      var decision = writer.decisionEmitter(descriptor, 1, "function", "@candidate");
      decision.candidate(DecisionReasonCode.CANDIDATE_MATCHED);
      decision.rejected(DecisionReasonCode.REJECTED_PROFITABILITY);
      assertThrows(IllegalStateException.class,
          () -> decision.applied(DecisionReasonCode.APPLIED_PROFITABLE));
    }
    List<Map<?, ?>> events = Files.readAllLines(output).stream()
        .map(StrictJson::parse).<Map<?, ?>>map(value -> (Map<?, ?>) value).toList();
    assertEquals(List.of("candidate", "rejected"),
        events.stream().map(event -> event.get("decision")).toList());
    assertTrue(events.stream().allMatch(event ->
        "optimization-remark.v2".equals(event.get("schema_version"))
            && "decision".equals(event.get("event_type"))
            && event.containsKey("legality_obligation_id")
            && event.get("legality_obligation_id") == null));
  }

  @Test
  void writesDeclaredCandidateLegalityObligation() throws Exception {
    Path output = tempDirectory.resolve("candidate-legality.jsonl");
    String obligation = "candidate.ir.test-pass.no-overflow";
    PassDescriptor descriptor = new PassDescriptor(
        "candidate.ir.test-pass", "candidate.ir.test-pass", "Test candidate",
        PassDescriptor.Stage.IR_FUNCTION, 1, PassDescriptor.Lifecycle.CANDIDATE, true,
        new PassDescriptor.CandidateAnchor(
            PassRegistry.IR_INST_COMBINE, 1, PassDescriptor.AnchorPosition.AFTER),
        List.of(obligation));
    try (JsonlRemarkWriter writer = new JsonlRemarkWriter(output)) {
      var decision = writer.decisionEmitter(descriptor, 1, "function", "@candidate");
      decision.candidate(DecisionReasonCode.CANDIDATE_MATCHED);
      decision.rejectedLegality(obligation);
    }

    List<Map<?, ?>> events = Files.readAllLines(output).stream()
        .map(StrictJson::parse).<Map<?, ?>>map(value -> (Map<?, ?>) value).toList();
    assertEquals(2, events.size());
    assertEquals("optimization-remark.v2", events.getLast().get("schema_version"));
    assertEquals("rejected_legality", events.getLast().get("reason"));
    assertEquals(obligation, events.getLast().get("legality_obligation_id"));
  }

  @Test
  void closingRemarkWriterRejectsUnterminatedCandidate() throws Exception {
    Path output = tempDirectory.resolve("unterminated.jsonl");
    JsonlRemarkWriter writer = new JsonlRemarkWriter(output);
    var descriptor = PassRegistry.standard().require(PassRegistry.IR_AFFINE_LOOP_SUMMARIZATION);
    writer.decisionEmitter(descriptor, 1, "function", "@candidate")
        .candidate(DecisionReasonCode.CANDIDATE_MATCHED);

    IllegalStateException exception = assertThrows(IllegalStateException.class, writer::close);
    assertTrue(exception.getMessage().contains("unterminated optimization candidate"));
  }

  @Test
  void fullDevelopmentEntryExecutesSyntheticIrAndBackendCandidates() throws Exception {
    Path input = tempDirectory.resolve("candidate-enabled.sy");
    Path profilePath = tempDirectory.resolve("candidate-enabled.json");
    Path assembly = tempDirectory.resolve("candidate-enabled.s");
    Path judgeAssembly = tempDirectory.resolve("candidate-enabled-judge.s");
    Path remarks = tempDirectory.resolve("candidate-enabled.jsonl");
    Files.writeString(input, "int main() { return 0; }", StandardCharsets.UTF_8);
    PassRegistry registry = SyntheticCandidateRegistry.createCombined();
    PipelineProfile.builder(registry)
        .enableCandidate(SyntheticCandidateRegistry.IR_CANDIDATE)
        .enableCandidate(SyntheticCandidateRegistry.BACKEND_CANDIDATE)
        .build()
        .writeJson(profilePath);
    SyntheticDevelopmentPipeline pipeline = new SyntheticDevelopmentPipeline(registry);

    BenchmarkCompiler.runForTesting(new String[] {
        input.toString(), "-o", assembly.toString(), "--profile", profilePath.toString(),
        "--remarks", remarks.toString()
    }, pipeline);
    Compiler.main(new String[] {
        input.toString(), "-S", "-o", judgeAssembly.toString(), "-O1"
    });

    assertTrue(PassRegistry.standard().find(SyntheticCandidateRegistry.IR_CANDIDATE) == null);
    assertTrue(PassRegistry.standard().find(SyntheticCandidateRegistry.BACKEND_CANDIDATE) == null);
    assertEquals(1, pipeline.irFactoryConstructions.get());
    assertEquals(1, pipeline.backendFactoryConstructions.get());
    String assemblyText = Files.readString(assembly);
    assertTrue(assemblyText.contains("main:"));
    assertTrue(hasLoadImmediate(assemblyText, SyntheticCandidatePassBuilder.IR_RETURN_MARKER));
    assertTrue(hasLoadImmediate(
        assemblyText, SyntheticCandidateBackendCompiler.MACHINE_CONSTANT_MARKER));
    assertNotEquals(Files.readString(judgeAssembly), assemblyText);
    List<Map<?, ?>> events = Files.readAllLines(remarks).stream()
        .map(StrictJson::parse).<Map<?, ?>>map(value -> (Map<?, ?>) value).toList();
    assertTrue(events.stream().allMatch(
        event -> registry.find((String) event.get("pass")) != null));
    assertCandidateLifecycle(events, SyntheticCandidateRegistry.IR_CANDIDATE);
    assertCandidateLifecycle(events, SyntheticCandidateRegistry.BACKEND_CANDIDATE);
  }

  @Test
  void fullDevelopmentEntryDoesNotInstantiateDisabledCandidateFactories() throws Exception {
    Path input = tempDirectory.resolve("candidate-disabled.sy");
    Path profilePath = tempDirectory.resolve("candidate-disabled.json");
    Path assembly = tempDirectory.resolve("candidate-disabled.s");
    Path judgeAssembly = tempDirectory.resolve("candidate-disabled-judge.s");
    Path remarks = tempDirectory.resolve("candidate-disabled.jsonl");
    Files.writeString(input, "int main() { return 0; }", StandardCharsets.UTF_8);
    PassRegistry registry = SyntheticCandidateRegistry.createCombined();
    PipelineProfile.full(registry).writeJson(profilePath);
    SyntheticDevelopmentPipeline pipeline = new SyntheticDevelopmentPipeline(registry);

    BenchmarkCompiler.runForTesting(new String[] {
        input.toString(), "-o", assembly.toString(), "--profile", profilePath.toString(),
        "--remarks", remarks.toString()
    }, pipeline);
    Compiler.main(new String[] {
        input.toString(), "-S", "-o", judgeAssembly.toString(), "-O1"
    });

    assertEquals(0, pipeline.irFactoryConstructions.get());
    assertEquals(0, pipeline.backendFactoryConstructions.get());
    assertArrayEquals(Files.readAllBytes(judgeAssembly), Files.readAllBytes(assembly));
    assertTrue(Files.readAllLines(remarks).stream()
        .map(StrictJson::parse)
        .map(value -> (Map<?, ?>) value)
        .noneMatch(event -> ((String) event.get("pass")).startsWith("candidate.")));
  }

  @Test
  void fullDevelopmentEntryRejectsMissingEnabledFactoryBeforeAnyPassRuns() throws Exception {
    Path input = tempDirectory.resolve("candidate-missing.sy");
    Path profilePath = tempDirectory.resolve("candidate-missing.json");
    Path assembly = tempDirectory.resolve("candidate-missing.s");
    Path remarks = tempDirectory.resolve("candidate-missing.jsonl");
    Files.writeString(input, "int main() { return 0; }", StandardCharsets.UTF_8);
    PassRegistry registry = SyntheticCandidateRegistry.createCombined();
    PipelineProfile.builder(registry)
        .enableCandidate(SyntheticCandidateRegistry.BACKEND_CANDIDATE)
        .build()
        .writeJson(profilePath);
    BenchmarkCompiler.DevelopmentPipeline missingProvider =
        new BenchmarkCompiler.DevelopmentPipeline() {
          @Override
          public PassRegistry registry() {
            return registry;
          }

          @Override
          public PassBuilder passBuilder(PassInstrumentation instrumentation) {
            return new PassBuilder();
          }

          @Override
          public BackendCompiler backendCompiler(
              PipelineProfile profile, BackendPassInstrumentation instrumentation) {
            return new BackendCompiler(profile, instrumentation);
          }
        };

    IllegalStateException error = assertThrows(
        IllegalStateException.class,
        () -> BenchmarkCompiler.runForTesting(new String[] {
            input.toString(), "-o", assembly.toString(), "--profile", profilePath.toString(),
            "--remarks", remarks.toString()
        }, missingProvider));

    assertTrue(error.getMessage().contains("has no registered BACKEND_FUNCTION factory"));
    assertFalse(Files.exists(assembly));
    assertEquals("", Files.readString(remarks));
  }

  private static void assertCandidateLifecycle(
      List<Map<?, ?>> events, String candidateId) {
    List<Map<?, ?>> candidateEvents = events.stream()
        .filter(event -> candidateId.equals(event.get("pass")))
        .toList();
    assertEquals(3, candidateEvents.size());
    assertEquals(List.of("candidate", "applied"), candidateEvents.subList(0, 2).stream()
        .map(event -> event.get("decision"))
        .toList());
    assertEquals("pass_summary", candidateEvents.get(2).get("event_type"));
    assertEquals(Boolean.TRUE, candidateEvents.get(2).get("changed"));
    assertEquals("available", candidateEvents.get(2).get("decision_observability"));
  }

  private static boolean hasLoadImmediate(String assembly, int value) {
    String suffix = ", " + value;
    return assembly.lines().anyMatch(line -> line.stripLeading().startsWith("li ")
        && line.endsWith(suffix));
  }

  private void assertBaselineFixture(String fixture, Map<String, String> checksums)
      throws Exception {
    Path input = tempDirectory.resolve(fixture + ".sy");
    Path profile = tempDirectory.resolve(fixture + "-baseline-profile.json");
    Path judgeAssembly = tempDirectory.resolve(fixture + "-judge.s");
    Path developmentAssembly = tempDirectory.resolve(fixture + "-development.s");
    Path remarks = tempDirectory.resolve(fixture + "-baseline.jsonl");
    Files.write(input, baselineResource(fixture + ".sy"));
    PipelineProfile.full().writeJson(profile);

    Compiler.main(new String[] {
        input.toString(), "-S", "-o", judgeAssembly.toString(), "-O1"
    });
    BenchmarkCompiler.main(new String[] {
        input.toString(), "-o", developmentAssembly.toString(), "--profile", profile.toString(),
        "--remarks", remarks.toString()
    });

    byte[] expected = baselineResource(fixture + ".s");
    String digest = HexFormat.of().formatHex(
        MessageDigest.getInstance("SHA-256").digest(expected));
    assertEquals(checksums.get(fixture + ".s"), digest);
    assertArrayEquals(expected, Files.readAllBytes(judgeAssembly));
    assertArrayEquals(expected, Files.readAllBytes(developmentAssembly));
    assertTrue(Files.readAllLines(remarks).stream()
        .map(StrictJson::parse)
        .map(value -> (Map<?, ?>) value)
        .noneMatch(event -> ((String) event.get("pass")).startsWith("candidate.")));
  }

  private static byte[] baselineResource(String name) throws IOException {
    String resource = "/candidate-empty-baseline/" + name;
    try (InputStream stream = BenchmarkCompilerTest.class.getResourceAsStream(resource)) {
      if (stream == null) throw new IOException("missing test resource " + resource);
      return stream.readAllBytes();
    }
  }

  private static final class SyntheticDevelopmentPipeline
      implements BenchmarkCompiler.DevelopmentPipeline {
    private final PassRegistry registry;
    private final AtomicInteger irFactoryConstructions = new AtomicInteger();
    private final AtomicInteger backendFactoryConstructions = new AtomicInteger();

    private SyntheticDevelopmentPipeline(PassRegistry registry) {
      this.registry = registry;
    }

    @Override
    public PassRegistry registry() {
      return registry;
    }

    @Override
    public PassBuilder passBuilder(PassInstrumentation instrumentation) {
      return SyntheticCandidatePassBuilder.create(instrumentation, irFactoryConstructions);
    }

    @Override
    public BackendCompiler backendCompiler(
        PipelineProfile profile, BackendPassInstrumentation instrumentation) {
      return SyntheticCandidateBackendCompiler.create(
          profile, instrumentation, backendFactoryConstructions);
    }
  }
}
