package accela.parse;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ast.Node;
import accela.ast.Ty;
import accela.backend.BackendCompiler;
import accela.ir.AST2IR;
import accela.ir.Function;
import accela.ir.Instruction;
import accela.ir.Module;
import accela.ir.Type;
import accela.pass.ir.verify.IRVerifier;
import org.junit.jupiter.api.Test;

final class VectorFrontendTest {
  @Test
  void parsesBothVectorTypeSpellings() {
    Node unit = parseAndAnalyze(
        "int4 explicit_width = {1, 2, 3, 4};"
            + " vector float inferred_width = {1, 2, 3, 4, 5, 6};"
            + " vector int default_width = {}; ");

    assertEquals(Ty.vector(Ty.INT, 4), unit.kids.get(0).ty);
    assertEquals(Ty.vector(Ty.FLOAT, 6), unit.kids.get(1).ty);
    assertEquals(6, unit.kids.get(1).kids.get(0).kids.size());
    assertEquals(Ty.vector(Ty.INT, 4), unit.kids.get(2).ty);
    assertEquals(4, unit.kids.get(2).kids.get(0).kids.size());
  }

  @Test
  void lowersArbitraryContextualVectorWidths() {
    Module module = new AST2IR().convert(parseAndAnalyze(
        "int main() {"
            + " vector int a = {1,2,3,4,5};"
            + " vector float b = {0.5,1.5,2.5,3.5,4.5,5.5,6.5};"
            + " a = a + 1;"
            + " return a[4] + b[6];"
            + "}"));

    IRVerifier.verifyModule(module);
    assertTrue(module.getFunctions().getFirst().getBlocks().stream()
        .flatMap(block -> block.getInstructions().stream())
        .anyMatch(instruction -> instruction.getType().equals(Type.vector(Type.INT, 5))));
    assertTrue(new BackendCompiler().compileToAssembly(module).contains("main:"));
  }

  @Test
  void lowersBroadcastArithmeticAndLaneAccessThroughCodegen() {
    String source =
        "int main() {"
            + " int x = 1;"
            + " int4 a = {x, 2, 3, 4};"
            + " vector int b = {10, 20, 30, 40};"
            + " float4 f = {1.5, 2.5, 3.5, 4.5};"
            + " int4 c = 1 + a + b;"
            + " int4 d = 1.0 + a;"
            + " c[2] = c[1] + 5;"
            + " return c[2] + d[0] + (f[1] > 2.0);"
            + "}";
    Module module = new AST2IR().convert(parseAndAnalyze(source));
    Function main = module.getFunctions().get(0);

    IRVerifier.verifyModule(module);
    assertTrue(count(main, Instruction.Opcode.BUILD_VECTOR) > 0);
    assertTrue(count(main, Instruction.Opcode.EXTRACT_ELEMENT) >= 4);
    assertTrue(count(main, Instruction.Opcode.INSERT_ELEMENT) == 1);

    String assembly = new BackendCompiler().compileToAssembly(module);
    assertTrue(assembly.contains("main:"));
    assertTrue(assembly.contains("  ret"));
  }

  @Test
  void keepsIntegralFloatLiteralsFloatingInScalarArithmetic() {
    Module module = new AST2IR().convert(parseAndAnalyze(
        "float half() { return 1. / 2.; }"
            + "int main() { int4 a = {1,2,3,4}; int4 b = a + 1.0; return b[0]; }"));

    Function half = module.getFunctions().stream()
        .filter(function -> function.getName().equals("half"))
        .findFirst()
        .orElseThrow();
    assertEquals(1, count(half, Instruction.Opcode.FDIV));

    Function main = module.getFunctions().stream()
        .filter(function -> function.getName().equals("main"))
        .findFirst()
        .orElseThrow();
    assertTrue(main.getBlocks().stream()
        .flatMap(block -> block.getInstructions().stream())
        .anyMatch(instruction -> instruction.getOpcode() == Instruction.Opcode.ADD
            && instruction.getType().equals(Type.vector(Type.INT, 4))));
  }

  @Test
  void preservesVectorLeavesInCStyleArrays() {
    Module module = new AST2IR().convert(parseAndAnalyze(
        "int main() {"
            + " int4 rows[2] = {{1,2,3,4},{5,6,7,8}};"
            + " rows[1][2] = rows[1][2] + 3;"
            + " return rows[1][2];"
            + "}"));

    IRVerifier.verifyModule(module);
    assertTrue(module.getFunctions().getFirst().getBlocks().stream()
        .flatMap(block -> block.getInstructions().stream())
        .filter(instruction -> instruction.getOpcode() == Instruction.Opcode.LOAD)
        .anyMatch(instruction -> instruction.getType().equals(Type.vector(Type.INT, 4))));
  }

  @Test
  void passesVectorsByExpandingScalarAbiLanes() {
    Node unit = parseAndAnalyze(
        "int consume(int prefix, int4 a, vector float b) {"
            + " return prefix + a[3] + b[1];"
            + "}"
            + "int main() {"
            + " int4 a = {1,2,3,4}; float4 b = {1.5,2.5,3.5,4.5};"
            + " return consume(10, a, b);"
            + "}");
    assertEquals(Ty.vector(Ty.INT, 4), unit.kids.get(0).kids.get(1).ty);
    assertEquals(Ty.vector(Ty.FLOAT, 4), unit.kids.get(0).kids.get(2).ty);

    Module module = new AST2IR().convert(unit);
    IRVerifier.verifyModule(module);
    assertTrue(module.getFunctions().getFirst().getArguments().stream()
        .anyMatch(argument -> argument.getType().isVector()));
    String assembly = new BackendCompiler().compileToAssembly(module);
    assertTrue(assembly.contains("call consume"));
    assertTrue(module.getFunctions().getFirst().getArguments().stream()
        .noneMatch(argument -> argument.getType().isVector()));
  }

  @Test
  void rejectsVectorConditionsAndFloatingRemainder() {
    assertThrows(RuntimeException.class, () -> parseAndAnalyze(
        "int main() { int4 a = {1,2,3,4}; if (a) return 1; return 0; }"));
    assertThrows(RuntimeException.class, () -> parseAndAnalyze(
        "int main() { float4 a = {1,2,3,4}; a = a % 2; return 0; }"));
  }

  private static Node parseAndAnalyze(String source) {
    Node unit = new Parser(new Lexer(source, "vector-frontend.sy").tokenize()).parse();
    new Sema().analyze(unit);
    return unit;
  }

  private static long count(Function function, Instruction.Opcode opcode) {
    return function.getBlocks().stream()
        .flatMap(block -> block.getInstructions().stream())
        .filter(instruction -> instruction.getOpcode() == opcode)
        .count();
  }
}
