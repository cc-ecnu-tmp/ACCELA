package accela.backend.regalloc;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.backend.frame.StackSlotKind;
import accela.backend.machine.ImmOperand;
import accela.backend.machine.MachineBasicBlock;
import accela.backend.machine.MachineFunction;
import accela.backend.machine.MachineInstr;
import accela.backend.machine.MachineOpcode;
import accela.backend.machine.MachineType;
import accela.backend.machine.StackSlotOperand;
import accela.backend.machine.SymbolOperand;
import accela.backend.machine.VRegOperand;
import accela.backend.machine.VirtualRegister;
import accela.backend.target.RISCVTarget;
import java.util.HashSet;
import java.util.Set;
import org.junit.jupiter.api.Test;

final class LocalSpillRewriterTest {
  private final LocalSpillRewriter rewriter = new LocalSpillRewriter();
  private final RISCVTarget target = new RISCVTarget();

  @Test
  void rewritesSpilledUsesWithStackAddressAndLoad() {
    MachineFunction function = new MachineFunction("spill_use", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");
    VirtualRegister spilled = function.createVirtualRegister(MachineType.I32, "spilled");
    VirtualRegister result = function.createVirtualRegister(MachineType.I32, "result");

    entry.addInstruction(add(result, spilled, spilled));
    entry.addInstruction(ret(result));

    rewriter.rewrite(function, Set.of(spilled), target);

    assertOpcodes(entry, MachineOpcode.STACK_ADDR, MachineOpcode.LOAD, MachineOpcode.ADD, MachineOpcode.RET);
    MachineInstr load = entry.getInstructions().get(1);
    MachineInstr add = entry.getInstructions().get(2);
    VirtualRegister reload = load.getDest();
    assertEquals(reload, ((VRegOperand) add.getOperands().get(0)).getRegister());
    assertEquals(reload, ((VRegOperand) add.getOperands().get(1)).getRegister());
    assertEquals(1, function.getFrameInfo().getSlots().size());
    assertEquals(StackSlotKind.SPILL, function.getFrameInfo().getSlots().get(0).getKind());
  }

  @Test
  void rewritesSpilledDefinitionsWithTemporaryDefinitionAndStore() {
    MachineFunction function = new MachineFunction("spill_def", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");
    VirtualRegister spilled = function.createVirtualRegister(MachineType.I32, "spilled");
    VirtualRegister result = function.createVirtualRegister(MachineType.I32, "result");

    entry.addInstruction(moveImm(spilled, 42));
    entry.addInstruction(addImm(result, spilled, 1));
    entry.addInstruction(ret(result));

    rewriter.rewrite(function, Set.of(spilled), target);

    assertOpcodes(
        entry,
        MachineOpcode.MOVE,
        MachineOpcode.STACK_ADDR,
        MachineOpcode.STORE,
        MachineOpcode.STACK_ADDR,
        MachineOpcode.LOAD,
        MachineOpcode.ADD,
        MachineOpcode.RET);
    MachineInstr rewrittenDef = entry.getInstructions().get(0);
    MachineInstr store = entry.getInstructions().get(2);
    MachineInstr load = entry.getInstructions().get(4);
    MachineInstr add = entry.getInstructions().get(5);

    assertTrue(!rewrittenDef.getDest().equals(spilled));
    assertEquals(rewrittenDef.getDest(), ((VRegOperand) store.getOperands().get(0)).getRegister());
    assertEquals(load.getDest(), ((VRegOperand) add.getOperands().get(0)).getRegister());
  }

  @Test
  void rematerializesSpilledGlobalAddressOncePerBlock() {
    MachineFunction function = new MachineFunction("remat_global", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");
    VirtualRegister address = function.createVirtualRegister(MachineType.PTR, "address");
    VirtualRegister first = function.createVirtualRegister(MachineType.I32, "first");
    VirtualRegister second = function.createVirtualRegister(MachineType.I32, "second");
    MachineInstr materialize = new MachineInstr(MachineOpcode.MOVE, address);
    materialize.addOperand(new SymbolOperand("global"));
    materialize.setType(MachineType.PTR);
    entry.addInstruction(materialize);
    entry.addInstruction(load(first, address));
    entry.addInstruction(load(second, address));
    entry.addInstruction(ret(second));

    rewriter.rewrite(function, Set.of(address), target);

    assertOpcodes(entry, MachineOpcode.MOVE, MachineOpcode.LOAD, MachineOpcode.LOAD, MachineOpcode.RET);
    assertEquals(0, function.getFrameInfo().getSlots().size());
    assertTrue(((SymbolOperand) entry.getInstructions().get(0).getOperands().getFirst())
        .getSymbol().equals("global"));
    assertEquals(
        ((VRegOperand) entry.getInstructions().get(1).getOperands().getFirst()).getRegister(),
        ((VRegOperand) entry.getInstructions().get(2).getOperands().getFirst()).getRegister());
  }

  @Test
  void leavesStackPassedSpilledCallArgumentsInTheirSpillSlots() {
    MachineFunction function = new MachineFunction("many_call_args", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");
    MachineInstr call = new MachineInstr(MachineOpcode.CALL, null);
    call.setCallee("callee");
    call.setType(MachineType.VOID);
    Set<VirtualRegister> spilled = new HashSet<>();

    for (int i = 0; i < 15; i++) {
      VirtualRegister argument =
          function.createVirtualRegister(MachineType.I32, "argument." + i);
      spilled.add(argument);
      call.addOperand(new VRegOperand(argument), MachineType.I32);
    }
    entry.addInstruction(call);
    MachineInstr ret = new MachineInstr(MachineOpcode.RET, null);
    ret.setType(MachineType.VOID);
    entry.addInstruction(ret);

    rewriter.rewrite(function, spilled, target);

    MachineInstr rewrittenCall =
        entry.getInstructions().stream()
            .filter(instruction -> instruction.getOpcode() == MachineOpcode.CALL)
            .findFirst()
            .orElseThrow();
    assertEquals(
        8,
        rewrittenCall.getOperands().stream()
            .filter(VRegOperand.class::isInstance)
            .count());
    assertEquals(
        7,
        rewrittenCall.getOperands().stream()
            .filter(StackSlotOperand.class::isInstance)
            .count());
    assertEquals(MachineType.I32, rewrittenCall.getOperandType(14));
  }

  @Test
  void rewritesTwentyFiveFloatCallArgumentsWithoutReloadingStackArguments() {
    MachineFunction function = new MachineFunction("many_float_call_args", MachineType.VOID);
    MachineBasicBlock entry = function.addBlock("entry");
    MachineInstr call = new MachineInstr(MachineOpcode.CALL, null);
    call.setCallee("callee");
    call.setType(MachineType.VOID);

    VirtualRegister selectedSpill =
        function.createVirtualRegister(MachineType.F32, "argument.0");
    call.addOperand(new VRegOperand(selectedSpill), MachineType.F32);
    for (int i = 1; i < 25; i++) {
      VirtualRegister argument =
          function.createVirtualRegister(MachineType.F32, "argument." + i);
      call.addOperand(new VRegOperand(argument), MachineType.F32);
    }
    entry.addInstruction(call);
    entry.addInstruction(retVoid());

    rewriter.rewrite(function, Set.of(selectedSpill), target);

    MachineInstr rewrittenCall =
        entry.getInstructions().stream()
            .filter(instruction -> instruction.getOpcode() == MachineOpcode.CALL)
            .findFirst()
            .orElseThrow();
    assertEquals(25, rewrittenCall.getOperands().size());
    for (int i = 0; i < 16; i++) {
      assertTrue(rewrittenCall.getOperands().get(i) instanceof VRegOperand);
      assertEquals(MachineType.F32, rewrittenCall.getOperandType(i));
    }
    for (int i = 16; i < 25; i++) {
      assertTrue(
          rewrittenCall.getOperands().get(i) instanceof StackSlotOperand,
          "operand "
              + i
              + " was "
              + rewrittenCall.getOperands().get(i).getClass().getSimpleName());
      assertEquals(MachineType.F32, rewrittenCall.getOperandType(i));
    }
  }

  @Test
  void rewritesRepeatedFloatArgumentForBothRegisterAndStackPositions() {
    MachineFunction function = new MachineFunction("repeated_float_call_arg", MachineType.VOID);
    MachineBasicBlock entry = function.addBlock("entry");
    MachineInstr call = new MachineInstr(MachineOpcode.CALL, null);
    call.setCallee("callee");
    call.setType(MachineType.VOID);

    VirtualRegister repeated =
        function.createVirtualRegister(MachineType.F32, "repeated");
    call.addOperand(new VRegOperand(repeated), MachineType.F32);
    for (int i = 1; i < 16; i++) {
      VirtualRegister argument =
          function.createVirtualRegister(MachineType.F32, "argument." + i);
      call.addOperand(new VRegOperand(argument), MachineType.F32);
    }
    call.addOperand(new VRegOperand(repeated), MachineType.F32);
    entry.addInstruction(call);
    entry.addInstruction(retVoid());

    rewriter.rewrite(function, Set.of(repeated), target);

    assertOpcodes(
        entry,
        MachineOpcode.STACK_ADDR,
        MachineOpcode.LOAD,
        MachineOpcode.CALL,
        MachineOpcode.RET);
    MachineInstr rewrittenCall = entry.getInstructions().get(2);
    assertTrue(rewrittenCall.getOperands().get(0) instanceof VRegOperand);
    assertTrue(
        !((VRegOperand) rewrittenCall.getOperands().get(0))
            .getRegister()
            .equals(repeated));
    assertTrue(rewrittenCall.getOperands().get(16) instanceof StackSlotOperand);
    assertEquals(MachineType.F32, rewrittenCall.getOperandType(0));
    assertEquals(MachineType.F32, rewrittenCall.getOperandType(16));
  }

  @Test
  void preservesCallOperandTypesAcrossRepeatedSpillRewrites() {
    MachineFunction function = new MachineFunction("repeated_spill_rewrite", MachineType.VOID);
    MachineBasicBlock entry = function.addBlock("entry");
    VirtualRegister first =
        function.createVirtualRegister(MachineType.F32, "first");
    VirtualRegister second =
        function.createVirtualRegister(MachineType.F32, "second");
    MachineInstr call = new MachineInstr(MachineOpcode.CALL, null);
    call.setCallee("callee");
    call.setType(MachineType.VOID);
    call.addOperand(new VRegOperand(first), MachineType.F32);
    call.addOperand(new VRegOperand(second), MachineType.F32);
    entry.addInstruction(call);
    entry.addInstruction(retVoid());

    rewriter.rewrite(function, Set.of(first), target);
    rewriter.rewrite(function, Set.of(second), target);

    MachineInstr rewrittenCall =
        entry.getInstructions().stream()
            .filter(instruction -> instruction.getOpcode() == MachineOpcode.CALL)
            .findFirst()
            .orElseThrow();
    assertEquals(MachineType.F32, rewrittenCall.getOperandType(0));
    assertEquals(MachineType.F32, rewrittenCall.getOperandType(1));
  }

  private static MachineInstr moveImm(VirtualRegister dest, int value) {
    MachineInstr instr = new MachineInstr(MachineOpcode.MOVE, dest);
    instr.addOperand(new ImmOperand(value));
    instr.setType(dest.getType());
    return instr;
  }

  private static MachineInstr add(VirtualRegister dest, VirtualRegister left, VirtualRegister right) {
    MachineInstr instr = new MachineInstr(MachineOpcode.ADD, dest);
    instr.addOperand(new VRegOperand(left));
    instr.addOperand(new VRegOperand(right));
    instr.setType(dest.getType());
    return instr;
  }

  private static MachineInstr addImm(VirtualRegister dest, VirtualRegister left, int right) {
    MachineInstr instr = new MachineInstr(MachineOpcode.ADD, dest);
    instr.addOperand(new VRegOperand(left));
    instr.addOperand(new ImmOperand(right));
    instr.setType(dest.getType());
    return instr;
  }

  private static MachineInstr load(VirtualRegister dest, VirtualRegister address) {
    MachineInstr instr = new MachineInstr(MachineOpcode.LOAD, dest);
    instr.addOperand(new VRegOperand(address));
    instr.setType(dest.getType());
    return instr;
  }

  private static MachineInstr ret(VirtualRegister value) {
    MachineInstr instr = new MachineInstr(MachineOpcode.RET, null);
    instr.addOperand(new VRegOperand(value));
    instr.setType(value.getType());
    return instr;
  }

  private static MachineInstr retVoid() {
    MachineInstr instr = new MachineInstr(MachineOpcode.RET, null);
    instr.setType(MachineType.VOID);
    return instr;
  }

  private static void assertOpcodes(MachineBasicBlock block, MachineOpcode... expected) {
    assertEquals(expected.length, block.getInstructions().size());
    for (int i = 0; i < expected.length; i++) {
      assertEquals(expected[i], block.getInstructions().get(i).getOpcode());
    }
  }
}
