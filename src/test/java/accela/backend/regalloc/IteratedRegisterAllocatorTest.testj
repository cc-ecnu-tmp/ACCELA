package accela.backend.regalloc;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.backend.machine.FloatImmOperand;
import accela.backend.machine.ImmOperand;
import accela.backend.machine.MachineBasicBlock;
import accela.backend.machine.MachineFunction;
import accela.backend.machine.MachineInstr;
import accela.backend.machine.MachineOpcode;
import accela.backend.machine.MachineType;
import accela.backend.machine.PhysicalRegOperand;
import accela.backend.machine.PhysicalRegister;
import accela.backend.machine.VRegOperand;
import accela.backend.machine.VirtualRegister;
import accela.backend.target.RISCVTarget;
import java.util.ArrayList;
import java.util.List;
import org.junit.jupiter.api.Test;

final class IteratedRegisterAllocatorTest {
  private final IteratedRegisterAllocator allocator = new IteratedRegisterAllocator();
  private final RISCVTarget target = new RISCVTarget();
  private final TargetRegisterInfo registerInfo = new TargetRegisterInfo();

  @Test
  void allocatesRegistersForSimpleFunctionWithoutSpills() {
    MachineFunction function = new MachineFunction("simple", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");

    VirtualRegister a = function.createVirtualRegister(MachineType.I32, "a");
    VirtualRegister b = function.createVirtualRegister(MachineType.I32, "b");
    VirtualRegister c = function.createVirtualRegister(MachineType.I32, "c");

    entry.addInstruction(moveImm(a, 1));
    entry.addInstruction(moveImm(b, 2));
    entry.addInstruction(add(c, a, b));
    entry.addInstruction(ret(c));

    AllocationResult result = allocator.allocate(function, target);

    assertTrue(result.locationOf(a).isRegister());
    assertTrue(result.locationOf(b).isRegister());
    assertTrue(result.locationOf(c).isRegister());
    assertTrue(
        !((RegisterLocation) result.locationOf(a))
            .getRegister()
            .getName()
            .equals(((RegisterLocation) result.locationOf(b)).getRegister().getName()));
  }

  @Test
  void coalescesMoveEndpointsIntoSameRegisterWhenSafe() {
    MachineFunction function = new MachineFunction("move", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");

    VirtualRegister a = function.createVirtualRegister(MachineType.I32, "a");
    VirtualRegister b = function.createVirtualRegister(MachineType.I32, "b");

    entry.addInstruction(moveImm(a, 1));
    entry.addInstruction(moveReg(b, a));
    entry.addInstruction(ret(b));

    AllocationResult result = allocator.allocate(function, target);

    assertEquals(
        ((RegisterLocation) result.locationOf(a)).getRegister().getName(),
        ((RegisterLocation) result.locationOf(b)).getRegister().getName());
  }

  @Test
  void allocatesValuesLiveAcrossCallsToCalleeSavedRegisters() {
    MachineFunction function = new MachineFunction("call_live", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");

    VirtualRegister live = function.createVirtualRegister(MachineType.I32, "live");
    VirtualRegister callResult = function.createVirtualRegister(MachineType.I32, "call.result");
    VirtualRegister sum = function.createVirtualRegister(MachineType.I32, "sum");

    entry.addInstruction(moveImm(live, 1));

    MachineInstr call = new MachineInstr(MachineOpcode.CALL, callResult);
    call.setCallee("callee");
    call.setType(MachineType.I32);
    entry.addInstruction(call);

    entry.addInstruction(add(sum, live, callResult));
    entry.addInstruction(ret(sum));

    AllocationResult result = allocator.allocate(function, target);

    PhysicalRegister allocated = allocatedRegister(result, live);
    assertTrue(registerInfo.isCalleeSaved(allocated));
    assertTrue(
        result.getUsedCalleeSavedRegisters().stream()
            .anyMatch(register -> register.getName().equals(allocated.getName())));
  }

  @Test
  void allowsCallResultToUseCallerSavedRegister() {
    MachineFunction function = new MachineFunction("call_result", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");
    VirtualRegister callResult = function.createVirtualRegister(MachineType.I32, "call.result");

    MachineInstr call = new MachineInstr(MachineOpcode.CALL, callResult);
    call.setCallee("callee");
    call.setType(MachineType.I32);
    entry.addInstruction(call);
    entry.addInstruction(ret(callResult));

    AllocationResult result = allocator.allocate(function, target);

    assertTrue(
        registerInfo.isCallerSaved(allocatedRegister(result, callResult)));
  }

  @Test
  void allowsFloatCallResultToUseCallerSavedRegister() {
    MachineFunction function = new MachineFunction("float_call_result", MachineType.F32);
    MachineBasicBlock entry = function.addBlock("entry");
    VirtualRegister callResult =
        function.createVirtualRegister(MachineType.F32, "call.result");

    MachineInstr call = new MachineInstr(MachineOpcode.CALL, callResult);
    call.setCallee("callee");
    call.setType(MachineType.F32);
    entry.addInstruction(call);
    entry.addInstruction(ret(callResult));

    AllocationResult result = allocator.allocate(function, target);

    assertTrue(
        registerInfo.isCallerSaved(allocatedRegister(result, callResult)));
  }

  @Test
  void splitsLiveCallArgumentsBetweenAbiAndCalleeSavedRegisters() {
    MachineFunction function = new MachineFunction("mixed_call_live", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");
    VirtualRegister integerArgument =
        function.createVirtualRegister(MachineType.I32, "integer.argument");
    VirtualRegister floatArgument =
        function.createVirtualRegister(MachineType.F32, "float.argument");
    VirtualRegister integerUse =
        function.createVirtualRegister(MachineType.I32, "integer.use");
    VirtualRegister floatUse =
        function.createVirtualRegister(MachineType.F32, "float.use");

    entry.addInstruction(moveImm(integerArgument, 1));
    entry.addInstruction(moveFloatImm(floatArgument, 2.0f));
    MachineInstr call = new MachineInstr(MachineOpcode.CALL, null);
    call.setCallee("callee");
    call.setType(MachineType.VOID);
    call.addOperand(new VRegOperand(integerArgument), MachineType.I32);
    call.addOperand(new VRegOperand(floatArgument), MachineType.F32);
    entry.addInstruction(call);
    entry.addInstruction(add(integerUse, integerArgument, integerArgument));
    entry.addInstruction(fadd(floatUse, floatArgument, floatArgument));
    entry.addInstruction(ret(integerUse));

    AllocationResult result = allocator.allocate(function, target);

    assertEquals("a0", allocatedRegister(result, integerArgument).getName());
    assertEquals("fa0", allocatedRegister(result, floatArgument).getName());
    List<VirtualRegister> preserved = preservedCopies(entry);
    assertEquals(2, preserved.size());
    assertTrue(
        preserved.stream()
            .allMatch(value -> registerInfo.isCalleeSaved(allocatedRegister(result, value))));
  }

  @Test
  void assignsDeadCallArgumentsAndResultToTheirAbiRegisters() {
    MachineFunction function = new MachineFunction("call_affinity", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");
    VirtualRegister integer = function.createVirtualRegister(MachineType.I32, "integer");
    VirtualRegister floating = function.createVirtualRegister(MachineType.F32, "floating");
    VirtualRegister result = function.createVirtualRegister(MachineType.I32, "result");
    entry.addInstruction(moveImm(integer, 1));
    entry.addInstruction(moveFloatImm(floating, 2.0f));
    MachineInstr call = new MachineInstr(MachineOpcode.CALL, result);
    call.setCallee("callee");
    call.setType(MachineType.I32);
    call.addOperand(new VRegOperand(integer), MachineType.I32);
    call.addOperand(new VRegOperand(floating), MachineType.F32);
    entry.addInstruction(call);
    entry.addInstruction(ret(result));

    AllocationResult allocation = allocator.allocate(function, target);

    assertEquals("a0", allocatedRegister(allocation, integer).getName());
    assertEquals("fa0", allocatedRegister(allocation, floating).getName());
    assertEquals("a0", allocatedRegister(allocation, result).getName());
  }

  @Test
  void assignsFunctionArgumentAndReturnToTheirAbiRegister() {
    MachineFunction function = new MachineFunction("argument_affinity", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");
    VirtualRegister argument = function.createVirtualRegister(MachineType.I32, "argument");
    function.addArgument(argument, MachineType.I32);
    MachineInstr input = new MachineInstr(MachineOpcode.ARG_IN, argument);
    input.addOperand(new PhysicalRegOperand(target.getArgRegister(0, MachineType.I32)));
    input.setType(MachineType.I32);
    entry.addInstruction(input);
    entry.addInstruction(ret(argument));

    AllocationResult allocation = allocator.allocate(function, target);

    assertEquals("a0", allocatedRegister(allocation, argument).getName());
  }

  @Test
  void rejectsConflictingCallArgumentAffinities() {
    MachineFunction function = new MachineFunction("conflicting_affinity", MachineType.VOID);
    MachineBasicBlock entry = function.addBlock("entry");
    VirtualRegister value = function.createVirtualRegister(MachineType.I32, "value");
    entry.addInstruction(moveImm(value, 1));
    MachineInstr call = new MachineInstr(MachineOpcode.CALL, null);
    call.setCallee("callee");
    call.setType(MachineType.VOID);
    call.addOperand(new VRegOperand(value), MachineType.I32);
    call.addOperand(new VRegOperand(value), MachineType.I32);
    entry.addInstruction(call);
    entry.addInstruction(retVoid());

    String register = allocatedRegister(allocator.allocate(function, target), value).getName();

    assertTrue(!register.matches("a[0-3]"));
  }

  @Test
  void splitsRegisterArgumentsAndConvergesUnderCallPressure() {
    MachineFunction function =
        new MachineFunction("call_live_pressure", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");
    List<VirtualRegister> liveThrough = new ArrayList<>();
    int valueCount =
        registerInfo.calleeSavedRegisters(MachineType.I32).size() + 1;
    MachineInstr call = new MachineInstr(MachineOpcode.CALL, null);
    call.setCallee("callee");
    call.setType(MachineType.VOID);

    for (int i = 0; i < valueCount; i++) {
      VirtualRegister value =
          function.createVirtualRegister(MachineType.I32, "live." + i);
      liveThrough.add(value);
      entry.addInstruction(moveImm(value, i));
      call.addOperand(new VRegOperand(value), MachineType.I32);
    }
    entry.addInstruction(call);

    VirtualRegister sum =
        function.createVirtualRegister(MachineType.I32, "sum.1");
    entry.addInstruction(add(sum, liveThrough.get(0), liveThrough.get(1)));
    for (int i = 2; i < liveThrough.size(); i++) {
      VirtualRegister next =
          function.createVirtualRegister(MachineType.I32, "sum." + i);
      entry.addInstruction(add(next, sum, liveThrough.get(i)));
      sum = next;
    }
    entry.addInstruction(ret(sum));

    AllocationResult result = allocator.allocate(function, target);

    assertTrue(
        liveThrough.stream().allMatch(value -> result.locationOf(value) != null));
    assertFalse(result.getUsedCalleeSavedRegisters().isEmpty());
  }

  @Test
  void convergesAndRetainsLocationsForMoreCallArgumentsThanRegisters() {
    MachineFunction function =
        new MachineFunction("many_call_arguments", MachineType.VOID);
    MachineBasicBlock entry = function.addBlock("entry");
    List<VirtualRegister> arguments = new ArrayList<>();
    MachineInstr call = new MachineInstr(MachineOpcode.CALL, null);
    call.setCallee("callee");
    call.setType(MachineType.VOID);
    int argumentCount =
        new TargetRegisterInfo().registerCount(MachineType.I32) + 1;

    for (int i = 0; i < argumentCount; i++) {
      VirtualRegister argument =
          function.createVirtualRegister(MachineType.I32, "argument." + i);
      arguments.add(argument);
      entry.addInstruction(moveImm(argument, i));
      call.addOperand(new VRegOperand(argument), MachineType.I32);
    }
    entry.addInstruction(call);
    MachineInstr ret = new MachineInstr(MachineOpcode.RET, null);
    ret.setType(MachineType.VOID);
    entry.addInstruction(ret);

    AllocationResult result = allocator.allocate(function, target);

    assertTrue(
        arguments.stream().allMatch(argument -> result.locationOf(argument) != null));
    assertTrue(
        arguments.stream().anyMatch(argument -> result.locationOf(argument).isStack()));
  }

  @Test
  void allocatesTwentyFiveFloatCallArgumentsAndRetainsOperandTypes() {
    MachineFunction function =
        new MachineFunction("many_float_call_arguments", MachineType.VOID);
    MachineBasicBlock entry = function.addBlock("entry");
    List<VirtualRegister> arguments = new ArrayList<>();
    MachineInstr call = new MachineInstr(MachineOpcode.CALL, null);
    call.setCallee("callee");
    call.setType(MachineType.VOID);

    for (int i = 0; i < 25; i++) {
      VirtualRegister argument =
          function.createVirtualRegister(MachineType.F32, "argument." + i);
      arguments.add(argument);
      entry.addInstruction(moveFloatImm(argument, i));
      call.addOperand(new VRegOperand(argument), MachineType.F32);
    }
    entry.addInstruction(call);
    MachineInstr ret = new MachineInstr(MachineOpcode.RET, null);
    ret.setType(MachineType.VOID);
    entry.addInstruction(ret);

    AllocationResult result = allocator.allocate(function, target);

    assertTrue(
        arguments.stream().allMatch(argument -> result.locationOf(argument) != null));
    assertTrue(
        arguments.stream().allMatch(argument -> result.locationOf(argument).isRegister()));
    MachineInstr rewrittenCall =
        entry.getInstructions().stream()
            .filter(instruction -> instruction.getOpcode() == MachineOpcode.CALL)
            .findFirst()
            .orElseThrow();
    assertEquals(25, rewrittenCall.getOperands().size());
    for (int i = 0; i < rewrittenCall.getOperands().size(); i++) {
      assertEquals(MachineType.F32, rewrittenCall.getOperandType(i));
    }
  }

  private static MachineInstr moveImm(VirtualRegister dest, int value) {
    MachineInstr instr = new MachineInstr(MachineOpcode.MOVE, dest);
    instr.addOperand(new ImmOperand(value));
    instr.setType(dest.getType());
    return instr;
  }

  private static MachineInstr moveFloatImm(VirtualRegister dest, float value) {
    MachineInstr instr = new MachineInstr(MachineOpcode.MOVE, dest);
    instr.addOperand(new FloatImmOperand(value), MachineType.F32);
    instr.setType(MachineType.F32);
    return instr;
  }

  private static MachineInstr moveReg(VirtualRegister dest, VirtualRegister src) {
    MachineInstr instr = new MachineInstr(MachineOpcode.MOVE, dest);
    instr.addOperand(new VRegOperand(src));
    instr.setType(dest.getType());
    return instr;
  }

  private static MachineInstr add(
      VirtualRegister dest, VirtualRegister left, VirtualRegister right) {
    MachineInstr instr = new MachineInstr(MachineOpcode.ADD, dest);
    instr.addOperand(new VRegOperand(left));
    instr.addOperand(new VRegOperand(right));
    instr.setType(dest.getType());
    return instr;
  }

  private static MachineInstr fadd(
      VirtualRegister dest, VirtualRegister left, VirtualRegister right) {
    MachineInstr instr = new MachineInstr(MachineOpcode.FADD, dest);
    instr.addOperand(new VRegOperand(left));
    instr.addOperand(new VRegOperand(right));
    instr.setType(MachineType.F32);
    return instr;
  }

  private static MachineInstr ret(VirtualRegister value) {
    MachineInstr instr = new MachineInstr(MachineOpcode.RET, null);
    instr.addOperand(new VRegOperand(value));
    instr.setType(value.getType());
    return instr;
  }

  private static MachineInstr retVoid() {
    MachineInstr instr = new MachineInstr(MachineOpcode.RET, null);
    instr.setType(MachineType.VOID);
    return instr;
  }

  private static PhysicalRegister allocatedRegister(
      AllocationResult result, VirtualRegister register) {
    return ((RegisterLocation) result.locationOf(register)).getRegister();
  }

  private static List<VirtualRegister> preservedCopies(MachineBasicBlock block) {
    return block.getInstructions().stream()
        .filter(instruction -> !instruction.isCoalescable())
        .map(MachineInstr::getDest)
        .toList();
  }
}
