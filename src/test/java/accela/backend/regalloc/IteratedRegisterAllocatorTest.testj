package accela.backend.regalloc;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.backend.machine.ImmOperand;
import accela.backend.machine.MachineBasicBlock;
import accela.backend.machine.MachineFunction;
import accela.backend.machine.MachineInstr;
import accela.backend.machine.MachineOpcode;
import accela.backend.machine.MachineType;
import accela.backend.machine.VRegOperand;
import accela.backend.machine.VirtualRegister;
import accela.backend.target.RISCVTarget;
import org.junit.jupiter.api.Test;

final class IteratedRegisterAllocatorTest {
  private final IteratedRegisterAllocator allocator = new IteratedRegisterAllocator();
  private final RISCVTarget target = new RISCVTarget();

  @Test
  void allocatesRegistersForSimpleFunctionWithoutSpills() {
    MachineFunction function = new MachineFunction("simple", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");

    VirtualRegister a = function.createVirtualRegister(MachineType.I32, "a");
    VirtualRegister b = function.createVirtualRegister(MachineType.I32, "b");
    VirtualRegister c = function.createVirtualRegister(MachineType.I32, "c");

    entry.addInstruction(moveImm(a, 1));
    entry.addInstruction(moveImm(b, 2));
    entry.addInstruction(add(c, a, b));
    entry.addInstruction(ret(c));

    AllocationResult result = allocator.allocate(function, target);

    assertTrue(result.locationOf(a).isRegister());
    assertTrue(result.locationOf(b).isRegister());
    assertTrue(result.locationOf(c).isRegister());
    assertTrue(
        !((RegisterLocation) result.locationOf(a))
            .getRegister()
            .getName()
            .equals(((RegisterLocation) result.locationOf(b)).getRegister().getName()));
  }

  @Test
  void coalescesMoveEndpointsIntoSameRegisterWhenSafe() {
    MachineFunction function = new MachineFunction("move", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");

    VirtualRegister a = function.createVirtualRegister(MachineType.I32, "a");
    VirtualRegister b = function.createVirtualRegister(MachineType.I32, "b");

    entry.addInstruction(moveImm(a, 1));
    entry.addInstruction(moveReg(b, a));
    entry.addInstruction(ret(b));

    AllocationResult result = allocator.allocate(function, target);

    assertEquals(
        ((RegisterLocation) result.locationOf(a)).getRegister().getName(),
        ((RegisterLocation) result.locationOf(b)).getRegister().getName());
  }

  @Test
  void allocatesValuesLiveAcrossCallsToCalleeSavedRegisters() {
    MachineFunction function = new MachineFunction("call_live", MachineType.I32);
    MachineBasicBlock entry = function.addBlock("entry");

    VirtualRegister live = function.createVirtualRegister(MachineType.I32, "live");
    VirtualRegister callResult = function.createVirtualRegister(MachineType.I32, "call.result");
    VirtualRegister sum = function.createVirtualRegister(MachineType.I32, "sum");

    entry.addInstruction(moveImm(live, 1));

    MachineInstr call = new MachineInstr(MachineOpcode.CALL, callResult);
    call.setCallee("callee");
    call.setType(MachineType.I32);
    entry.addInstruction(call);

    entry.addInstruction(add(sum, live, callResult));
    entry.addInstruction(ret(sum));

    AllocationResult result = allocator.allocate(function, target);

    String registerName = ((RegisterLocation) result.locationOf(live)).getRegister().getName();
    assertTrue(registerName.startsWith("s"));
    assertTrue(
        result.getUsedCalleeSavedRegisters().stream()
            .anyMatch(register -> register.getName().equals(registerName)));
  }

  private static MachineInstr moveImm(VirtualRegister dest, int value) {
    MachineInstr instr = new MachineInstr(MachineOpcode.MOVE, dest);
    instr.addOperand(new ImmOperand(value));
    instr.setType(dest.getType());
    return instr;
  }

  private static MachineInstr moveReg(VirtualRegister dest, VirtualRegister src) {
    MachineInstr instr = new MachineInstr(MachineOpcode.MOVE, dest);
    instr.addOperand(new VRegOperand(src));
    instr.setType(dest.getType());
    return instr;
  }

  private static MachineInstr add(VirtualRegister dest, VirtualRegister left, VirtualRegister right) {
    MachineInstr instr = new MachineInstr(MachineOpcode.ADD, dest);
    instr.addOperand(new VRegOperand(left));
    instr.addOperand(new VRegOperand(right));
    instr.setType(dest.getType());
    return instr;
  }

  private static MachineInstr ret(VirtualRegister value) {
    MachineInstr instr = new MachineInstr(MachineOpcode.RET, null);
    instr.addOperand(new VRegOperand(value));
    instr.setType(value.getType());
    return instr;
  }
}
