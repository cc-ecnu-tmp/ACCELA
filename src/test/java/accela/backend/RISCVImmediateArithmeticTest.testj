package accela.backend;

import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.Function;
import accela.ir.IRBuilder;
import accela.ir.Module;
import accela.ir.Type;
import accela.ir.Value;
import accela.pass.ir.transform.StrengthReduction;
import org.junit.jupiter.api.Test;

final class RISCVImmediateArithmeticTest {
  @Test
  void selectsShortIntegerArithmeticSequences() {
    Module module = new Module();
    Function function = new Function("arithmetic", Type.INT);
    module.addFunction(function);
    Value argument = function.addArgument(Type.INT, "argument");
    BasicBlock entry = function.addBlock("entry");
    IRBuilder builder = new IRBuilder(entry);
    Value seven = Constant.intConst(7);
    builder.createAdd(argument, seven);
    builder.createAdd(seven, argument);
    builder.createSub(argument, seven);
    builder.createSub(Constant.intConst(0), argument);
    builder.createMul(argument, Constant.intConst(32));
    builder.createMul(Constant.intConst(5), argument);
    builder.createSDiv(argument, Constant.intConst(8));
    builder.createSRem(argument, Constant.intConst(8));
    builder.createSDiv(argument, Constant.intConst(3));
    builder.createSDiv(argument, Constant.intConst(7));
    builder.createSRem(argument, Constant.intConst(10));
    builder.createAnd(seven, argument);
    builder.createXor(argument, seven);
    Value result = builder.createXor(seven, argument);
    builder.createRet(result);
    StrengthReduction.runOnFunction(function);

    String assembly = new BackendCompiler().compileToAssembly(module);

    assertTrue(assembly.matches("(?s).*  addiw [a-z0-9]+, [a-z0-9]+, 7.*"));
    assertTrue(assembly.matches("(?s).*  addiw [a-z0-9]+, [a-z0-9]+, -7.*"));
    assertTrue(assembly.matches("(?s).*  negw [a-z0-9]+, [a-z0-9]+.*"));
    assertTrue(assembly.matches("(?s).*  xori [a-z0-9]+, [a-z0-9]+, 7.*"));
    assertTrue(assembly.matches("(?s).*  andi [a-z0-9]+, [a-z0-9]+, 7.*"));
    assertTrue(assembly.matches("(?s).*  sext\\.w [a-z0-9]+, [a-z0-9]+.*"));
    assertTrue(assembly.matches("(?s).*  slliw [a-z0-9]+, [a-z0-9]+, 5.*"));
    assertTrue(assembly.matches("(?s).*  slliw [a-z0-9]+, [a-z0-9]+, 2.*"));
    assertTrue(assembly.matches("(?s).*  sraiw [a-z0-9]+, [a-z0-9]+, 31.*"));
    assertTrue(assembly.matches("(?s).*  srliw [a-z0-9]+, [a-z0-9]+, 29.*"));
    assertTrue(assembly.matches("(?s).*  mul a5, [a-z0-9]+, [a-z0-9]+.*"));
    assertTrue(assembly.matches("(?s).*  srai [a-z0-9]+, a5, 32.*"));
    assertTrue(assembly.matches("(?s).*  remw [a-z0-9]+, [a-z0-9]+, [a-z0-9]+.*"));
    assertFalse(assembly.matches("(?s).*  li [a-z0-9]+, 7.*"));
    assertFalse(assembly.matches("(?s).*  (mulw|divw) .*"));
    assertFalse(assembly.matches("(?s).*  xor [a-z0-9]+, [a-z0-9]+, [a-z0-9]+.*"));
  }
}
