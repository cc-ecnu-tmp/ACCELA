package accela.backend.target;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.backend.machine.MachineFunction;
import accela.backend.machine.MachineType;
import accela.backend.machine.PhysicalRegister;
import java.util.ArrayList;
import java.util.List;
import org.junit.jupiter.api.Test;

final class RISCVFrameLoweringTest {
  private final RISCVTarget target = new RISCVTarget();
  private final RISCVFrameLowering lowering = new RISCVFrameLowering(target);

  @Test
  void omitsTheFrameForAnEmptyLeaf() {
    MachineFunction function = new MachineFunction("leaf", MachineType.I32);
    assertFalse(lowering.finalizeFrame(function));

    List<String> lines = new ArrayList<>();
    lowering.emitPrologue(function, lines);
    lowering.emitEpilogue(function, lines);

    assertEquals(0, function.getFrameInfo().getFrameSize());
    assertEquals(List.of("  ret"), lines);
  }

  @Test
  void reportsFrameLayoutModificationOnlyWhenStateChanges() {
    MachineFunction function = new MachineFunction("local", MachineType.I32);
    function.getFrameInfo().createLocalSlot(MachineType.I32, 4, 4);

    assertTrue(lowering.finalizeFrame(function));
    assertFalse(lowering.finalizeFrame(function));
    assertEquals(16, function.getFrameInfo().getFrameSize());
  }

  @Test
  void savesAndRestoresUsedIntegerCalleeSavedRegisters() {
    MachineFunction function = new MachineFunction("callee_saved_int", MachineType.I32);
    function.getFrameInfo().addCalleeSavedRegister(new PhysicalRegister("s0", MachineType.I32));
    lowering.finalizeFrame(function);

    List<String> lines = new ArrayList<>();
    lowering.emitPrologue(function, lines);
    lowering.emitEpilogue(function, lines);

    assertTrue(lines.stream().anyMatch(line -> line.matches("  sd s0, [0-9]+\\(sp\\)")));
    assertTrue(lines.stream().anyMatch(line -> line.matches("  ld s0, [0-9]+\\(sp\\)")));
  }

  @Test
  void savesAndRestoresUsedFloatCalleeSavedRegisters() {
    MachineFunction function = new MachineFunction("callee_saved_float", MachineType.F32);
    function.getFrameInfo().addCalleeSavedRegister(new PhysicalRegister("fs1", MachineType.F32));
    function.getFrameInfo().addCalleeSavedRegister(new PhysicalRegister("fs2", MachineType.F32));
    lowering.finalizeFrame(function);

    List<String> lines = new ArrayList<>();
    lowering.emitPrologue(function, lines);
    lowering.emitEpilogue(function, lines);

    assertEquals(
        8,
        function.getFrameInfo().getCalleeSavedRegisterSaves().get(1).getOffset()
            - function.getFrameInfo().getCalleeSavedRegisterSaves().get(0).getOffset());
    assertTrue(lines.stream().anyMatch(line -> line.matches("  fsd fs1, [0-9]+\\(sp\\)")));
    assertTrue(lines.stream().anyMatch(line -> line.matches("  fld fs1, [0-9]+\\(sp\\)")));
    assertTrue(lines.stream().anyMatch(line -> line.matches("  fsd fs2, [0-9]+\\(sp\\)")));
    assertTrue(lines.stream().anyMatch(line -> line.matches("  fld fs2, [0-9]+\\(sp\\)")));
  }
}
