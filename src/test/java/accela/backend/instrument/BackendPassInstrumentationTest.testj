package accela.backend.instrument;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.backend.machine.MachineFunction;
import accela.backend.machine.MachineModule;
import accela.backend.machine.MachineType;
import accela.pass.PassDescriptor;
import accela.pass.PassRegistry;
import accela.pass.instrument.DecisionObservability;
import accela.pass.instrument.DecisionReasonCode;
import accela.pass.instrument.DecisionRemark;
import accela.pass.instrument.OptimizationRemark;
import accela.pass.instrument.PassRemark;
import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.atomic.AtomicBoolean;
import java.util.concurrent.atomic.AtomicLong;
import org.junit.jupiter.api.Test;

final class BackendPassInstrumentationTest {
  @Test
  void excludesPostTimingObservationAndReportsExplicitModification() {
    List<OptimizationRemark> remarks = new ArrayList<>();
    AtomicLong clock = new AtomicLong(100);
    AtomicBoolean postTimingObservationRan = new AtomicBoolean();
    MachineModule module = new MachineModule(new accela.ir.Module());
    PassDescriptor descriptor =
        PassRegistry.standard().require(PassRegistry.BACKEND_ASM_EMISSION);

    try (BackendPassInstrumentation instrumentation =
        BackendPassInstrumentation.observed(remarks::add, clock::get)) {
      String assembly = instrumentation.emitAssembly(
          descriptor,
          1,
          module,
          () -> {
            clock.addAndGet(40);
            return "assembly";
          },
          () -> true,
          () -> {
            postTimingObservationRan.set(true);
            clock.addAndGet(1_000);
          });
      assertEquals("assembly", assembly);
    }

    assertTrue(postTimingObservationRan.get());
    assertEquals(1, remarks.size());
    PassRemark remark = (PassRemark) remarks.getFirst();
    assertEquals(40, remark.elapsedNanos());
    assertTrue(remark.changed());
    assertEquals(1_140, clock.get());
  }

  @Test
  void candidateDecisionsRequireDeclaredObligationsAndRemainObservableInSummary() {
    String obligation = "candidate.backend.test-pass.valid-machine-shape";
    PassDescriptor descriptor = new PassDescriptor(
        "candidate.backend.test-pass", "candidate.backend.test-pass",
        "Test backend candidate", PassDescriptor.Stage.BACKEND_FUNCTION, 1,
        PassDescriptor.Lifecycle.CANDIDATE, true,
        new PassDescriptor.CandidateAnchor(
            PassRegistry.BACKEND_MACHINE_CSE, 1, PassDescriptor.AnchorPosition.AFTER),
        List.of(obligation));
    MachineFunction function = new MachineFunction("candidate", MachineType.I32);
    function.addBlock("entry");
    List<OptimizationRemark> remarks = new ArrayList<>();

    assertThrows(IllegalStateException.class,
        () -> BackendPassInstrumentation.noop().decisionEmitter(
            descriptor, 1, "machine_function", "@candidate"));
    try (BackendPassInstrumentation instrumentation =
        BackendPassInstrumentation.observed(remarks::add)) {
      assertThrows(IllegalArgumentException.class,
          () -> instrumentation.decisionEmitter(
              PassRegistry.standard().require(PassRegistry.BACKEND_MACHINE_CSE),
              1, "machine_function", "@candidate"));
      var decisions = instrumentation.decisionEmitter(
          descriptor, 1, "machine_function", "@candidate");
      decisions.candidate(DecisionReasonCode.CANDIDATE_MATCHED);
      assertThrows(IllegalArgumentException.class,
          () -> decisions.rejectedLegality("candidate.backend.test-pass.unknown"));
      decisions.rejectedLegality(obligation);
      instrumentation.runFunction(descriptor, 1, function, () -> false);
    }

    assertEquals(3, remarks.size());
    DecisionRemark terminal = (DecisionRemark) remarks.get(1);
    assertEquals(DecisionReasonCode.REJECTED_LEGALITY, terminal.reason());
    assertEquals(obligation, terminal.legalityObligationId());
    PassRemark summary = (PassRemark) remarks.getLast();
    assertEquals(DecisionObservability.AVAILABLE, summary.decisionObservability());
  }
}
