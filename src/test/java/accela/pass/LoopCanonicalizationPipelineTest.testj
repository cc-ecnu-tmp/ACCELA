package accela.pass;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.Function;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Module;
import accela.ir.Type;
import accela.pass.ir.instrument.PassInstrumentation;
import org.junit.jupiter.api.Test;

final class LoopCanonicalizationPipelineTest {
  @Test
  void defaultPipelineRunsCanonicalizationAndLegacyCleanup() {
    Module module = new Module();
    Function function = new Function("main", Type.INT);
    module.addFunction(function);
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock latch = function.addBlock("latch");
    BasicBlock exit = function.addBlock("exit");
    new IRBuilder(entry).createBr(header);
    IRBuilder headerBuilder = new IRBuilder(header);
    Instruction induction = headerBuilder.createPhi(Type.INT);
    induction.addOperand(Constant.intConst(0));
    induction.addOperand(entry);
    headerBuilder.createCondBr(
        headerBuilder.createICmp("slt", induction, Constant.intConst(10)), latch, exit);
    IRBuilder latchBuilder = new IRBuilder(latch);
    Instruction next = latchBuilder.createAdd(induction, Constant.intConst(1));
    latchBuilder.createBr(header);
    induction.addOperand(next);
    induction.addOperand(latch);
    new IRBuilder(exit).createRet(induction);

    PassBuilder builder = new PassBuilder();
    PassInstrumentation instrumentation = builder.buildIRInstrumentation(false);
    builder.buildIRO0Pipeline(instrumentation)
        .run(module, builder.buildModuleAnalysisManager(), builder.buildFunctionAnalysisManager());

    var names = instrumentation.getReports().stream().map(report -> report.passName).toList();
    assertTrue(names.contains("LoopCanonicalization.Pass"));
    assertTrue(names.contains("LoopCanonicalizationCleanup.Pass"));
    assertEquals(1, names.stream().filter("LoopDeletion.Pass"::equals).count());
  }
}
