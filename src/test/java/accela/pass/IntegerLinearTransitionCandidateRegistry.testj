package accela.pass;

import java.util.ArrayList;

/** Test integration registry containing the production integer-linear-transition descriptor. */
public final class IntegerLinearTransitionCandidateRegistry {
  private IntegerLinearTransitionCandidateRegistry() {}

  public static PassRegistry create() {
    ArrayList<PassDescriptor> descriptors = new ArrayList<>(PassRegistry.standard().all());
    descriptors.add(IntegerLinearTransitionCandidate.descriptor());
    return PassRegistry.of(descriptors);
  }
}
