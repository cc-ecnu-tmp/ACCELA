import java.util.ArrayList;
import java.util.List;
import org.junit.jupiter.api.Test;

/** Focused legality, transform, and near-miss checks for the six experiment candidates. */
final class NewCandidateSmokeTest {
  @Test
  void regionForwardingUsesExactObjectRegionsAndRejectsDynamicProvenance() {
    Module module = new Module();
    Type arrayType = Type.array(Type.INT, 2);
    GlobalVariable global = new GlobalVariable(
        "region", arrayType,
        Constant.array(arrayType, List.of(Constant.intConst(7), Constant.intConst(9))), false);
    module.addGlobal(global);
    Function function = new Function("region_forward", Type.INT);
    module.addFunction(function);
    BasicBlock entry = function.addBlock("entry");
    IRBuilder builder = new IRBuilder(entry);
    Instruction pointer = builder.createGEP(
        arrayType, global, new Value[] {Constant.intConst(0), Constant.intConst(0)}, true);
    Instruction first = builder.createLoad(Type.INT, pointer);
    Instruction second = builder.createLoad(Type.INT, pointer);
    builder.createRet(second);

    List<OptimizationRemark> remarks = new ArrayList<>();
    try (var instrumentation = accela.pass.ir.instrument.PassInstrumentation.observed(
        false, remarks::add)) {
      new SysYRegionMemoryForwarding.Pass(
          instrumentation, SysYRegionMemoryForwardingCandidate.descriptor(), 1)
          .run(function, new FunctionAnalysisManager());
    }
    assertEquals(null, second.getParent());
    assertEquals(first, entry.getTerminator().getOperand(0));
    assertTrue(decisions(remarks).stream().anyMatch(
        decision -> decision.decision() == DecisionStatus.APPLIED));
    IRVerifier.verifyModule(module);

    Function dynamic = new Function("region_dynamic", Type.INT);
    Value index = dynamic.addArgument(Type.INT, "index");
    module.addFunction(dynamic);
    BasicBlock dynamicEntry = dynamic.addBlock("entry");
    IRBuilder dynamicBuilder = new IRBuilder(dynamicEntry);
    Value dynamicPointer = dynamicBuilder.createGEP(
        arrayType, global, new Value[] {Constant.intConst(0), index}, false);
    Instruction dynamicLoad = dynamicBuilder.createLoad(Type.INT, dynamicPointer);
    dynamicBuilder.createRet(dynamicLoad);
    List<OptimizationRemark> dynamicRemarks = new ArrayList<>();
    try (var instrumentation = accela.pass.ir.instrument.PassInstrumentation.observed(
        false, dynamicRemarks::add)) {
      new SysYRegionMemoryForwarding.Pass(
          instrumentation, SysYRegionMemoryForwardingCandidate.descriptor(), 1)
          .run(dynamic, new FunctionAnalysisManager());
    }
    assertNotNull(dynamicLoad.getParent());
    assertEquals("candidate.sysy-region-memory-forwarding.object-provenance",
        decisions(dynamicRemarks).getLast().legalityObligationId());
  }

  @Test
  void specializationClonesOnlyDirectNonRecursiveConstantCalls() {
    Module module = new Module();
    Function helper = new Function("specialize", Type.INT);
    module.addFunction(helper);
    Value argument = helper.addArgument(Type.INT, "value");
    BasicBlock helperEntry = helper.addBlock("entry");
    IRBuilder helperBuilder = new IRBuilder(helperEntry);
    helperBuilder.createRet(helperBuilder.createAdd(argument, Constant.intConst(1)));

    Function caller = new Function("caller", Type.INT);
    module.addFunction(caller);
    BasicBlock callerEntry = caller.addBlock("entry");
    Instruction call = new IRBuilder(callerEntry).createCall(
        helper, Type.INT, Constant.intConst(4));
    new IRBuilder(callerEntry).createRet(call);
    Function filler = new Function("filler", Type.INT);
    module.addFunction(filler);
    Value fillerValue = filler.addArgument(Type.INT, "value");
    BasicBlock fillerEntry = filler.addBlock("entry");
    IRBuilder fillerBuilder = new IRBuilder(fillerEntry);
    for (int index = 0; index < 20; index++) {
      fillerValue = fillerBuilder.createAdd(fillerValue, Constant.intConst(index));
    }
    fillerBuilder.createRet(fillerValue);

    List<OptimizationRemark> remarks = new ArrayList<>();
    try (var instrumentation = accela.pass.ir.instrument.PassInstrumentation.observed(
        false, remarks::add)) {
      new FunctionSpecialization.Pass(
          instrumentation, FunctionSpecializationCandidate.descriptor(), 1)
          .run(module, new ModuleAnalysisManager(), new FunctionAnalysisManager());
    }
    assertTrue(module.getFunctions().stream()
        .anyMatch(function -> function.getName().equals("specialize.spec.0")));
    assertEquals("specialize.spec.0", call.getCallee().getName());
    IRVerifier.verifyModule(module);

    Function recursive = new Function("recursive", Type.INT);
    module.addFunction(recursive);
    BasicBlock recursiveEntry = recursive.addBlock("entry");
    Instruction recursiveCall = new IRBuilder(recursiveEntry).createCall(
        recursive, Type.INT, Constant.intConst(1));
    new IRBuilder(recursiveEntry).createRet(recursiveCall);
    List<OptimizationRemark> recursiveRemarks = new ArrayList<>();
    try (var instrumentation = accela.pass.ir.instrument.PassInstrumentation.observed(
        false, recursiveRemarks::add)) {
      new FunctionSpecialization.Pass(
          instrumentation, FunctionSpecializationCandidate.descriptor(), 1)
          .run(module, new ModuleAnalysisManager(), new FunctionAnalysisManager());
    }
    assertEquals("recursive", recursiveCall.getCallee().getName());
  }

  @Test
  void arrayPromotionFoldsImmutableGlobalsAndLeavesDynamicIndexNearMisses() {
    Module module = new Module();
    Type arrayType = Type.array(Type.INT, 2);
    GlobalVariable global = new GlobalVariable(
        "constant_array", arrayType,
        Constant.array(arrayType, List.of(Constant.intConst(11), Constant.intConst(13))), true);
    module.addGlobal(global);
    Function function = new Function("promote", Type.INT);
    module.addFunction(function);
    BasicBlock entry = function.addBlock("entry");
    IRBuilder builder = new IRBuilder(entry);
    Value pointer = builder.createGEP(
        arrayType, global, new Value[] {Constant.intConst(0), Constant.intConst(1)}, true);
    Instruction load = builder.createLoad(Type.INT, pointer);
    builder.createRet(load);

    List<OptimizationRemark> remarks = new ArrayList<>();
    try (var instrumentation = accela.pass.ir.instrument.PassInstrumentation.observed(
        false, remarks::add)) {
      new ArrayObjectPromotion.Pass(
          instrumentation, ArrayObjectPromotionCandidate.descriptor(), 1)
          .run(function, new FunctionAnalysisManager());
    }
    assertEquals(null, load.getParent());
    assertEquals(13L, ((Constant.Int) entry.getTerminator().getOperand(0)).value);
    IRVerifier.verifyModule(module);

    Function dynamic = new Function("promote_dynamic", Type.INT);
    Value index = dynamic.addArgument(Type.INT, "index");
    module.addFunction(dynamic);
    BasicBlock dynamicEntry = dynamic.addBlock("entry");
    IRBuilder dynamicBuilder = new IRBuilder(dynamicEntry);
    Value dynamicPointer = dynamicBuilder.createGEP(
        arrayType, global, new Value[] {Constant.intConst(0), index}, false);
    Instruction dynamicLoad = dynamicBuilder.createLoad(Type.INT, dynamicPointer);
    dynamicBuilder.createRet(dynamicLoad);
    List<OptimizationRemark> dynamicRemarks = new ArrayList<>();
    try (var instrumentation = accela.pass.ir.instrument.PassInstrumentation.observed(
        false, dynamicRemarks::add)) {
      new ArrayObjectPromotion.Pass(
          instrumentation, ArrayObjectPromotionCandidate.descriptor(), 1)
          .run(dynamic, new FunctionAnalysisManager());
    }
    assertNotNull(dynamicLoad.getParent());
  }

  @Test
  void nestedRecurrenceAndTilingFailClosedOnNonLoopShapes() {
    Function function = new Function("no_loop", Type.INT);
    BasicBlock entry = function.addBlock("entry");
    new IRBuilder(entry).createRet(Constant.intConst(0));
    List<OptimizationRemark> recurrenceRemarks = new ArrayList<>();
    FunctionAnalysisManager analyses = new PassBuilder().buildFunctionAnalysisManager();
    try (var instrumentation = accela.pass.ir.instrument.PassInstrumentation.observed(
        false, recurrenceRemarks::add)) {
      new NestedAddressRecurrence.Pass(
          instrumentation, NestedAddressRecurrenceCandidate.descriptor(), 1)
          .run(function, analyses);
    }
    assertEquals("candidate.nested-address-recurrence.canonical-nest",
        decisions(recurrenceRemarks).getLast().legalityObligationId());

    List<OptimizationRemark> tilingRemarks = new ArrayList<>();
    try (var instrumentation = accela.pass.ir.instrument.PassInstrumentation.observed(
        false, tilingRemarks::add)) {
      new CostModelLoopTiling.Pass(
          instrumentation, CostModelLoopTilingCandidate.descriptor(), 1)
          .run(function, analyses);
    }
    assertEquals(DecisionStatus.REJECTED, decisions(tilingRemarks).getLast().decision());
  }

  @Test
  void rv64WordPressureTracksKnownSext32AndRematerializableConstants() {
    MachineFunction function = new MachineFunction("word_pressure", MachineType.I64);
    MachineBasicBlock block = function.addBlock("entry");
    VirtualRegister value32 = function.createVirtualRegister(MachineType.I32, "value");
    MachineInstr constant = new MachineInstr(MachineOpcode.CONST_INT, value32);
    constant.setType(MachineType.I32);
    constant.addOperand(new ImmOperand(7));
    block.addInstruction(constant);
    VirtualRegister value64 = function.createVirtualRegister(MachineType.I64, "sext");
    MachineInstr first = new MachineInstr(MachineOpcode.SEXT, value64);
    first.setType(MachineType.I64);
    first.addOperand(new VRegOperand(value32));
    block.addInstruction(first);
    VirtualRegister redundant = function.createVirtualRegister(MachineType.I64, "redundant");
    MachineInstr second = new MachineInstr(MachineOpcode.SEXT, redundant);
    second.setType(MachineType.I64);
    second.addOperand(new VRegOperand(value64));
    block.addInstruction(second);
    MachineInstr ret = new MachineInstr(MachineOpcode.RET, null);
    ret.addOperand(new VRegOperand(redundant));
    block.addInstruction(ret);

    List<OptimizationRemark> remarks = new ArrayList<>();
    try (var instrumentation = BackendPassInstrumentation.observed(remarks::add)) {
      new Rv64WordPressurePass(
          instrumentation, Rv64WordPressureCandidate.descriptor(), 1).run(function);
    }
    assertTrue(function.isKnownSext32(value64));
    assertTrue(function.rematerializationRecipes().containsKey(value32));
    assertEquals(3, block.getInstructions().size());
    assertEquals(value64,
        ((VRegOperand) block.getInstructions().getLast().getOperands().getFirst()).getRegister());
    assertTrue(remarks.stream().anyMatch(remark -> remark instanceof DecisionRemark decision
        && decision.decision() == DecisionStatus.APPLIED));
  }

  private static List<DecisionRemark> decisions(List<OptimizationRemark> remarks) {
    return remarks.stream().filter(DecisionRemark.class::isInstance)
        .map(DecisionRemark.class::cast).toList();
  }
}
