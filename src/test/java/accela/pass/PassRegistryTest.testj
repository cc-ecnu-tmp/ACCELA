final class PassRegistryTest {
  @Test
  void registersEveryCurrentIrAndBackendTransformation() {
    PassRegistry registry = PassRegistry.standard();
    assertEquals(58, registry.all().size());
    assertEquals(58, registry.all().stream().map(PassDescriptor::id)
        .collect(Collectors.toSet()).size());
    assertEquals(40, registry.families().size());
    assertEquals(7, registry.require(PassRegistry.IR_EARLY_CSE).fullPipelineOccurrences());
    assertEquals(5, registry.require(PassRegistry.IR_SIMPLIFY_CFG).fullPipelineOccurrences());
    assertEquals(2, registry.require(PassRegistry.BACKEND_BLOCK_PLACEMENT)
        .fullPipelineOccurrences());
    assertEquals(Set.of(
            PassRegistry.BACKEND_IR_LOWERING,
            PassRegistry.BACKEND_PHI_ELIMINATION,
            PassRegistry.BACKEND_REGISTER_ALLOCATION,
            PassRegistry.BACKEND_ASM_EMISSION,
            PassRegistry.IR_MEM2REG),
        registry.all().stream().filter(PassDescriptor::required).map(PassDescriptor::id)
            .collect(Collectors.toSet()));
    assertTrue(registry.all().stream().allMatch(pass -> pass.id().startsWith("ir.")
        || pass.id().startsWith("backend.") || pass.id().startsWith("candidate.")));
    assertEquals(Set.of(PassRegistry.IR_SROA, PassRegistry.IR_GLOBAL_SROA),
        registry.forFamily(PassRegistry.FAMILY_IR_AGGREGATE_SCALARIZATION).stream()
            .map(PassDescriptor::id).collect(Collectors.toSet()));
    assertEquals(Set.of(PassRegistry.IR_LOOP_UNROLL, PassRegistry.IR_LOOP_UNROLL_AND_JAM),
        registry.forFamily(PassRegistry.FAMILY_IR_LOOP_UNROLLING).stream()
            .map(PassDescriptor::id).collect(Collectors.toSet()));
    assertEquals(PassRegistry.FAMILY_IR_AFFINE_LOOP_SUMMARIZATION,
        registry.require(PassRegistry.IR_AFFINE_LOOP_SUMMARIZATION).logicalFamilyId());
    assertEquals(PassRegistry.FAMILY_IR_RANKED_RECURRENCE_TABULATION,
        registry.require(PassRegistry.IR_RANKED_RECURRENCE_TABULATION).logicalFamilyId());
    assertEquals(PassRegistry.FAMILY_IR_REDUCTION_PUSHDOWN,
        registry.require(PassRegistry.IR_REDUCTION_PUSHDOWN).logicalFamilyId());
    assertEquals(PassRegistry.FAMILY_IR_LOOP_INTERCHANGE,
        registry.require(PassRegistry.IR_LOOP_INTERCHANGE).logicalFamilyId());
    assertEquals(PassRegistry.FAMILY_IR_LOOP_ROTATION,
        registry.require(PassRegistry.IR_LOOP_ROTATE).logicalFamilyId());
    assertEquals(PassRegistry.FAMILY_INTEGER_CONSTANT_ARITHMETIC_STRENGTH_REDUCTION,
        registry.require(PassRegistry.IR_STRENGTH_REDUCTION).logicalFamilyId());
    assertEquals(PassRegistry.FAMILY_INTEGER_CONSTANT_ARITHMETIC_STRENGTH_REDUCTION,
        registry.require(PassRegistry.BACKEND_RISCV_STRENGTH_REDUCTION).logicalFamilyId());
    assertEquals(Set.of(
            PassRegistry.IR_STRENGTH_REDUCTION,
            PassRegistry.BACKEND_RISCV_STRENGTH_REDUCTION),
        registry.forFamily(
                PassRegistry.FAMILY_INTEGER_CONSTANT_ARITHMETIC_STRENGTH_REDUCTION)
            .stream().map(PassDescriptor::id).collect(Collectors.toSet()));
    assertEquals(Set.of(
            PassRegistry.IR_AFFINE_LOOP_SUMMARIZATION,
            PassRegistry.IR_RANKED_RECURRENCE_TABULATION,
            ExtendedAffineSummarizationCandidate.ID,
            FiniteStateAccelerationCandidate.ID,
            SameDomainLoopFusionCandidate.ID,
            IntegerLinearTransitionCandidate.ID,
            Rrt2OnDemandMemoizationCandidate.ID,
            PrefixScanReuse.ID,
            SysYRegionMemoryForwardingCandidate.ID,
            FunctionSpecializationCandidate.ID,
            ArrayObjectPromotionCandidate.ID,
            NestedAddressRecurrenceCandidate.ID,
            CostModelLoopTilingCandidate.ID,
            Rv64WordPressureCandidate.ID),
        registry.all().stream().filter(PassDescriptor::decisionObservable)
            .map(PassDescriptor::id).collect(Collectors.toSet()));

    List<PassDescriptor> candidates = registry.candidates();
    assertEquals(List.of(
        "candidate.extended-affine-summarization",
        "candidate.finite-state-acceleration",
        "candidate.same-domain-loop-fusion",
        "candidate.integer-linear-transition",
        "candidate.rrt2-on-demand-memoization",
        "candidate.prefix-scan-reuse",
        SysYRegionMemoryForwardingCandidate.ID,
        FunctionSpecializationCandidate.ID,
        ArrayObjectPromotionCandidate.ID,
        NestedAddressRecurrenceCandidate.ID,
        CostModelLoopTilingCandidate.ID,
        Rv64WordPressureCandidate.ID),
        candidates.stream().map(PassDescriptor::id).toList());
    assertEquals(List.of(
        ExtendedAffineSummarizationCandidate.descriptor(),
        FiniteStateAccelerationCandidate.descriptor(),
        SameDomainLoopFusionCandidate.descriptor(),
        IntegerLinearTransitionCandidate.descriptor(),
        Rrt2OnDemandMemoizationCandidate.descriptor(),
        PrefixScanReuse.descriptor(),
        SysYRegionMemoryForwardingCandidate.descriptor(),
        FunctionSpecializationCandidate.descriptor(),
        ArrayObjectPromotionCandidate.descriptor(),
        NestedAddressRecurrenceCandidate.descriptor(),
        CostModelLoopTilingCandidate.descriptor(),
        Rv64WordPressureCandidate.descriptor()), candidates);
    assertEquals(List.of(
        "ir.affine-loop-summarization#1:after",
        "ir.affine-loop-summarization#1:before",
        "ir.indvar-domain-simplify#1:before",
        "ir.affine-loop-summarization#1:before",
        "ir.ranked-recurrence-tabulation#1:before",
        "ir.indvar-domain-simplify#1:before",
        "ir.gvn#1:before",
        "ir.inliner#1:before",
        "ir.sroa#1:before",
        "ir.loop-strength-reduce#1:before",
        "ir.loop-interchange#1:before",
        "backend.register-allocation#1:before"),
        candidates.stream().map(PassRegistryTest::anchorIdentity).toList());
    assertEquals(expectedCandidateObligations(),
        candidates.stream().map(PassDescriptor::legalityObligationIds).toList());
    assertTrue(candidates.stream().allMatch(candidate ->
        candidate.fullPipelineOccurrences() == 1
            && candidate.decisionObservable()
            && !candidate.defaultEnabled()
            && !candidate.legalityObligationIds().isEmpty()));
  }

  @Test
  void fullPipelineConstructionChecksRegistryOccurrenceCounts() {
    new PassBuilder().buildIRO0Pipeline();
