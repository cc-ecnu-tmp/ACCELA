package accela.pass.ir.analysis.dependence;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.GlobalVariable;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Type;
import accela.ir.Value;
import java.util.List;
import org.junit.jupiter.api.Test;

final class DependenceAnalysisTest {
  private static final Type MATRIX = Type.array(Type.array(Type.INT, 32), 32);

  @Test
  void rejectsAColumnSwapThatMakesTheDependenceNegative() {
    Fixture fixture = new Fixture();
    IRBuilder builder = fixture.builder;
    Value outerMinusOne =
        builder.createSub(fixture.outer, Constant.intConst(1));
    Value innerPlusOne =
        builder.createAdd(fixture.inner, Constant.intConst(1));
    builder.createStore(
        Constant.intConst(1), fixture.address(fixture.outer, fixture.inner));
    builder.createStore(
        Constant.intConst(2), fixture.address(outerMinusOne, innerPlusOne));

    var result = fixture.analyze();
    var ordered = result.dependences().stream()
        .filter(dependence -> dependence.source() != dependence.sink())
        .findFirst()
        .orElseThrow();

    assertEquals(
        List.of(
            DependenceAnalysis.Direction.LESS,
            DependenceAnalysis.Direction.GREATER),
        ordered.directions());
    assertFalse(result.isLegalToInterchange(0, 1));
  }

  @Test
  void provesDistinctOuterLanesForARegularMatrixStore() {
    Fixture fixture = new Fixture();
    fixture.builder.createStore(
        Constant.intConst(1), fixture.address(fixture.outer, fixture.inner));

    assertTrue(fixture.analyze().isSafeToJam(0, 1, 1, 4));
  }

  @Test
  void rejectsJammingWhenTheAddressDoesNotDependOnTheOuterLoop() {
    Fixture fixture = new Fixture();
    fixture.builder.createStore(
        Constant.intConst(1),
        fixture.address(Constant.intConst(0), fixture.inner));

    assertFalse(fixture.analyze().isSafeToJam(0, 1, 1, 4));
  }

  @Test
  void provesSameIterationFusionAndRejectsFutureProducerDependence() {
    GlobalVariable values =
        new GlobalVariable("values", Type.array(Type.INT, 32),
            Constant.zero(Type.array(Type.INT, 32)), false);
    BasicBlock first = new BasicBlock("first");
    BasicBlock second = new BasicBlock("second");
    Instruction firstIv = Instruction.createPhi(Type.INT);
    Instruction secondIv = Instruction.createPhi(Type.INT);
    first.addInstruction(firstIv);
    second.addInstruction(secondIv);
    IRBuilder firstBuilder = new IRBuilder(first);
    IRBuilder secondBuilder = new IRBuilder(second);
    Value firstAddress = firstBuilder.createGEP(
        values.getValueType(), values,
        new Value[] {Constant.int64Const(0), firstIv}, true);
    firstBuilder.createStore(Constant.intConst(7), firstAddress);
    Value sameAddress = secondBuilder.createGEP(
        values.getValueType(), values,
        new Value[] {Constant.int64Const(0), secondIv}, true);
    secondBuilder.createLoad(Type.INT, sameAddress);

    assertEquals(
        DependenceAnalysis.FusionSafety.SAFE,
        DependenceAnalysis.classifySequentialFusion(
            firstIv, List.of(first), secondIv, List.of(second)));
    assertTrue(DependenceAnalysis.isSameIterationAddress(
        firstAddress, firstIv, sameAddress, secondIv));

    BasicBlock futureSecond = new BasicBlock("future.second");
    Instruction futureIv = Instruction.createPhi(Type.INT);
    futureSecond.addInstruction(futureIv);
    IRBuilder futureBuilder = new IRBuilder(futureSecond);
    Value next = futureBuilder.createAdd(futureIv, Constant.intConst(1));
    Value futureAddress = futureBuilder.createGEP(
        values.getValueType(), values,
        new Value[] {Constant.int64Const(0), next}, true);
    futureBuilder.createLoad(Type.INT, futureAddress);
    assertEquals(
        DependenceAnalysis.FusionSafety.ORDER_VIOLATION,
        DependenceAnalysis.classifySequentialFusion(
            firstIv, List.of(first), futureIv, List.of(futureSecond)));
  }

  @Test
  void rejectsPotentiallyAliasingArgumentRootsForFusion() {
    accela.ir.Function function = new accela.ir.Function("alias", Type.INT);
    Value leftRoot = function.addArgument(Type.PTR, "left");
    Value rightRoot = function.addArgument(Type.PTR, "right");
    BasicBlock first = function.addBlock("first");
    BasicBlock second = function.addBlock("second");
    Instruction firstIv = Instruction.createPhi(Type.INT);
    Instruction secondIv = Instruction.createPhi(Type.INT);
    first.addInstruction(firstIv);
    second.addInstruction(secondIv);
    IRBuilder firstBuilder = new IRBuilder(first);
    IRBuilder secondBuilder = new IRBuilder(second);
    firstBuilder.createStore(
        Constant.intConst(1),
        firstBuilder.createGEP(Type.INT, leftRoot, new Value[] {firstIv}, true));
    secondBuilder.createLoad(
        Type.INT,
        secondBuilder.createGEP(Type.INT, rightRoot, new Value[] {secondIv}, true));

    assertEquals(
        DependenceAnalysis.FusionSafety.UNKNOWN_ALIAS_OR_MODREF,
        DependenceAnalysis.classifySequentialFusion(
            firstIv, List.of(first), secondIv, List.of(second)));
  }

  @Test
  void rejectsCrossIterationAntiDependenceForFusion() {
    Type array = Type.array(Type.INT, 32);
    GlobalVariable values =
        new GlobalVariable("anti", array, Constant.zero(array), false);
    BasicBlock first = new BasicBlock("anti.first");
    BasicBlock second = new BasicBlock("anti.second");
    Instruction firstIv = Instruction.createPhi(Type.INT);
    Instruction secondIv = Instruction.createPhi(Type.INT);
    first.addInstruction(firstIv);
    second.addInstruction(secondIv);
    IRBuilder firstBuilder = new IRBuilder(first);
    IRBuilder secondBuilder = new IRBuilder(second);
    firstBuilder.createLoad(
        Type.INT,
        firstBuilder.createGEP(
            array, values, new Value[] {Constant.int64Const(0), firstIv}, true));
    Value futureIndex = secondBuilder.createAdd(secondIv, Constant.intConst(1));
    secondBuilder.createStore(
        Constant.intConst(9),
        secondBuilder.createGEP(
            array, values, new Value[] {Constant.int64Const(0), futureIndex}, true));

    assertEquals(
        DependenceAnalysis.FusionSafety.ORDER_VIOLATION,
        DependenceAnalysis.classifySequentialFusion(
            firstIv, List.of(first), secondIv, List.of(second)));
  }

  private static final class Fixture {
    final GlobalVariable matrix =
        new GlobalVariable("matrix", MATRIX, Constant.zero(MATRIX), false);
    final BasicBlock block = new BasicBlock("body");
    final IRBuilder builder = new IRBuilder(block);
    final Instruction outer = Instruction.createPhi(Type.INT);
    final Instruction inner = Instruction.createPhi(Type.INT);

    Fixture() {
      block.addInstruction(outer);
      block.addInstruction(inner);
    }

    Value address(Value row, Value column) {
      return builder.createGEP(
          MATRIX,
          matrix,
          new Value[] {Constant.int64Const(0), row, column},
          true);
    }

    DependenceAnalysis.Result analyze() {
      return DependenceAnalysis.analyze(
          List.of(outer, inner), List.of(block));
    }
  }
}
