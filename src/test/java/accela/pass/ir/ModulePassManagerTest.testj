package accela.pass.ir;

import static org.junit.jupiter.api.Assertions.assertEquals;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.Function;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Type;
import accela.pass.PreservedAnalyses;
import java.util.concurrent.atomic.AtomicInteger;
import org.junit.jupiter.api.Test;

final class ModulePassManagerTest {
  @Test
  void modifiedModulePassInvalidatesAllCachedFunctionAnalyses() {
    Fixture fixture = new Fixture();
    assertEquals(1, fixture.analysisResult());

    ModulePassManager manager = new ModulePassManager();
    manager.addPass((module, mam, fam) -> {
      fixture.returnInstruction.setOperand(0, Constant.intConst(1));
      return PreservedAnalyses.none();
    });
    manager.run(fixture.module, new ModuleAnalysisManager(), fixture.fam);

    assertEquals(2, fixture.analysisResult());
    assertEquals(2, fixture.computations.get());
  }

  @Test
  void unmodifiedModulePassPreservesCachedFunctionAnalyses() {
    Fixture fixture = new Fixture();
    assertEquals(1, fixture.analysisResult());

    ModulePassManager manager = new ModulePassManager();
    manager.addPass((module, mam, fam) -> PreservedAnalyses.all());
    manager.run(fixture.module, new ModuleAnalysisManager(), fixture.fam);

    assertEquals(1, fixture.analysisResult());
    assertEquals(1, fixture.computations.get());
  }

  private static final class Fixture {
    final accela.ir.Module module = new accela.ir.Module();
    final Function function = new Function("analysis_target", Type.INT);
    final FunctionAnalysisManager fam = new FunctionAnalysisManager();
    final AtomicInteger computations = new AtomicInteger();
    final Instruction returnInstruction;

    Fixture() {
      BasicBlock entry = function.addBlock("entry");
      returnInstruction = new IRBuilder(entry).createRet(Constant.intConst(0));
      module.addFunction(function);
      fam.registerPass(CountingAnalysis.class, new CountingAnalysis(computations));
    }

    int analysisResult() {
      return fam.getResult(CountingAnalysis.class, function);
    }
  }

  private static final class CountingAnalysis implements FunctionAnalysis<Integer> {
    private final AtomicInteger computations;

    CountingAnalysis(AtomicInteger computations) {
      this.computations = computations;
    }

    @Override
    public Integer run(Function function, FunctionAnalysisManager fam) {
      return computations.incrementAndGet();
    }
  }
}
