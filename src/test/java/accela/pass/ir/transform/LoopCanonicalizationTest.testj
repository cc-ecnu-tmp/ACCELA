package accela.pass.ir.transform;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.Function;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Type;
import accela.pass.PassBuilder;
import accela.pass.ir.verify.IRVerifier;
import org.junit.jupiter.api.Test;

final class LoopCanonicalizationTest {
  @Test
  void formsLcssaForAnAlreadyCanonicalLoop() {
    Function function = new Function("canonical_phase", Type.INT);
    var repeat = function.addArgument(Type.I1, "repeat");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock latch = function.addBlock("latch");
    BasicBlock exit = function.addBlock("exit");
    new IRBuilder(entry).createBr(header);
    IRBuilder headerBuilder = new IRBuilder(header);
    Instruction value = headerBuilder.createPhi(Type.INT);
    value.addOperand(Constant.intConst(0));
    value.addOperand(entry);
    headerBuilder.createCondBr(repeat, latch, exit);
    IRBuilder latchBuilder = new IRBuilder(latch);
    Instruction next = latchBuilder.createAdd(value, Constant.intConst(1));
    latchBuilder.createBr(header);
    value.addOperand(next);
    value.addOperand(latch);
    Instruction ret = new IRBuilder(exit).createRet(value);

    var analyses = new PassBuilder().buildFunctionAnalysisManager();
    assertTrue(LoopCanonicalization.runOnFunction(function, analyses));
    IRVerifier.verifyFunction(function);
    assertEquals(Instruction.Opcode.PHI, exit.getInstructions().getFirst().getOpcode());
    assertEquals(exit.getInstructions().getFirst(), ret.getOperand(0));
  }

  @Test
  void leavesLateNoncanonicalCfgUnchanged() {
    Function function = new Function("late_noncanonical", Type.VOID);
    var enter = function.addArgument(Type.I1, "enter");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock latch = function.addBlock("latch");
    BasicBlock exit = function.addBlock("exit");
    new IRBuilder(entry).createCondBr(enter, header, exit);
    new IRBuilder(header).createBr(latch);
    new IRBuilder(latch).createCondBr(enter, header, exit);
    new IRBuilder(exit).createRetVoid();

    var analyses = new PassBuilder().buildFunctionAnalysisManager();
    assertFalse(LoopCanonicalization.runOnFunction(function, analyses));
    IRVerifier.verifyFunction(function);
    assertEquals(4, function.getBlocks().size());
  }
}
