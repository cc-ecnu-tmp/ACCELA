package accela.pass.ir.transform.simplifycfg;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertSame;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.Function;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Type;
import accela.ir.Value;
import accela.pass.ir.verify.IRVerifier;
import org.junit.jupiter.api.Test;

final class TailMergeTest {
  @Test
  void mergesEquivalentLoopLatchTails() {
    Function function = new Function("select", Type.INT);
    Value condition = function.addArgument(Type.I1, "condition");
    Value value = function.addArgument(Type.INT, "value");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock left = function.addBlock("left");
    BasicBlock right = function.addBlock("right");
    BasicBlock merge = function.addBlock("merge");
    new IRBuilder(entry).createCondBr(condition, left, right);

    IRBuilder leftBuilder = new IRBuilder(left);
    Instruction leftValue = leftBuilder.createAdd(value, Constant.intConst(1));
    leftBuilder.createBr(merge);
    IRBuilder rightBuilder = new IRBuilder(right);
    Instruction rightValue = rightBuilder.createAdd(value, Constant.intConst(1));
    rightBuilder.createBr(merge);
    IRBuilder mergeBuilder = new IRBuilder(merge);
    Instruction phi = mergeBuilder.createPhi(Type.INT);
    phi.addOperand(leftValue);
    phi.addOperand(left);
    phi.addOperand(rightValue);
    phi.addOperand(right);
    mergeBuilder.createRet(phi);

    assertTrue(TailMerge.run(function));
    IRVerifier.verifyFunction(function);
    assertEquals(3, function.getBlocks().size());
    assertSame(left, entry.getTerminator().getOperand(1));
    assertSame(left, entry.getTerminator().getOperand(2));
    assertSame(leftValue, phi.getOperand(0));
    assertSame(left, phi.getOperand(1));
  }

  @Test
  void mergesAllIndependentTailPairsInOneRun() {
    Function function = new Function("two_diamonds", Type.INT);
    Value condition = function.addArgument(Type.I1, "condition");
    Value value = function.addArgument(Type.INT, "value");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock left1 = function.addBlock("left1");
    BasicBlock right1 = function.addBlock("right1");
    BasicBlock merge1 = function.addBlock("merge1");
    BasicBlock left2 = function.addBlock("left2");
    BasicBlock right2 = function.addBlock("right2");
    BasicBlock exit = function.addBlock("exit");

    new IRBuilder(entry).createCondBr(condition, left1, right1);
    addTail(left1, value, merge1);
    addTail(right1, value, merge1);
    new IRBuilder(merge1).createCondBr(condition, left2, right2);
    Instruction leftValue = addTail(left2, value, exit);
    Instruction rightValue = addTail(right2, value, exit);
    IRBuilder exitBuilder = new IRBuilder(exit);
    Instruction result = exitBuilder.createPhi(Type.INT);
    result.addOperand(leftValue);
    result.addOperand(left2);
    result.addOperand(rightValue);
    result.addOperand(right2);
    exitBuilder.createRet(result);

    assertTrue(TailMerge.run(function));
    IRVerifier.verifyFunction(function);
    assertEquals(5, function.getBlocks().size());
  }

  private static Instruction addTail(BasicBlock block, Value value, BasicBlock successor) {
    IRBuilder builder = new IRBuilder(block);
    Instruction result = builder.createAdd(value, Constant.intConst(1));
    builder.createBr(successor);
    return result;
  }
}
