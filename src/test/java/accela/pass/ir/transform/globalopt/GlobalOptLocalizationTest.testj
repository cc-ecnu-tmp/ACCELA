package accela.pass.ir.transform;

import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.Constant;
import accela.ir.Function;
import accela.ir.GlobalVariable;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Module;
import accela.ir.Type;
import accela.pass.PassBuilder;
import accela.pass.ir.FunctionAnalysisManager;
import accela.pass.ir.ModuleAnalysisManager;
import accela.pass.ir.instrument.PassInstrumentation;
import accela.pass.ir.analysis.DominatorTreeAnalysis;
import accela.pass.ir.verify.IRVerifier;
import org.junit.jupiter.api.Test;

final class GlobalOptLocalizationTest {
  @Test
  void promotesMainLocalVectorGlobals() {
    Module module = new Module();
    Type int4 = Type.vector(Type.INT, 4);
    GlobalVariable vector =
        new GlobalVariable("vector", int4, Constant.zero(int4), false);
    module.addGlobal(vector);
    Function main = new Function("main", Type.INT);
    module.addFunction(main);
    IRBuilder builder = new IRBuilder(main.addBlock("entry"));
    Instruction load = builder.createLoad(int4, vector);
    Instruction updated =
        builder.createInsertElement(load, Constant.intConst(7), Constant.intConst(2));
    builder.createStore(updated, vector);
    builder.createRet(builder.createExtractElement(updated, Constant.intConst(2)));

    FunctionAnalysisManager fam = new FunctionAnalysisManager();
    fam.registerPass(DominatorTreeAnalysis.class, new DominatorTreeAnalysis());
    new GlobalOpt.Pass().run(module, new ModuleAnalysisManager(), fam);
    IRVerifier.verifyModule(module);

    assertFalse(vector.hasUses());
    assertTrue(load.getParent() == null);
    assertTrue(main.getBlocks().stream()
        .flatMap(block -> block.getInstructions().stream())
        .noneMatch(instruction -> instruction.getOpcode() == Instruction.Opcode.ALLOCA
            || instruction.getOpcode() == Instruction.Opcode.LOAD
            || instruction.getOpcode() == Instruction.Opcode.STORE));
  }

  @Test
  void promotesOnlyMainLocalScalarGlobals() {
    Module module = new Module();
    GlobalVariable local =
        new GlobalVariable("local", Type.INT, Constant.intConst(3), false);
    GlobalVariable shared =
        new GlobalVariable("shared", Type.INT, Constant.intConst(4), false);
    module.addGlobal(local);
    module.addGlobal(shared);

    Function helper = new Function("helper", Type.INT);
    module.addFunction(helper);
    IRBuilder helperBuilder = new IRBuilder(helper.addBlock("entry"));
    helperBuilder.createRet(helperBuilder.createLoad(Type.INT, shared));

    Function main = new Function("main", Type.INT);
    module.addFunction(main);
    IRBuilder builder = new IRBuilder(main.addBlock("entry"));
    Instruction load = builder.createLoad(Type.INT, local);
    builder.createStore(builder.createAdd(load, Constant.intConst(1)), local);
    builder.createRet(builder.createLoad(Type.INT, shared));

    FunctionAnalysisManager fam = new FunctionAnalysisManager();
    fam.registerPass(DominatorTreeAnalysis.class, new DominatorTreeAnalysis());
    new GlobalOpt.Pass().run(module, new ModuleAnalysisManager(), fam);
    IRVerifier.verifyModule(module);

    assertFalse(local.hasUses());
    assertTrue(shared.hasUses());
    assertTrue(load.getParent() == null);
    assertTrue(main.getBlocks().stream()
        .flatMap(block -> block.getInstructions().stream())
        .noneMatch(instruction -> instruction.getOpcode() == Instruction.Opcode.ALLOCA));
  }

  @Test
  void localizesGlobalsExposedByInlining() {
    Module module = new Module();
    GlobalVariable global =
        new GlobalVariable("state", Type.INT, Constant.intConst(0), false);
    GlobalVariable local =
        new GlobalVariable("local", Type.INT, Constant.intConst(1), false);
    module.addGlobal(global);
    module.addGlobal(local);

    Function getint = new Function("getint", Type.INT);
    module.addFunction(getint);
    Function helper = new Function("helper", Type.VOID);
    module.addFunction(helper);
    var argument = helper.addArgument(Type.INT, "value");
    IRBuilder helperBuilder = new IRBuilder(helper.addBlock("entry"));
    helperBuilder.createStore(argument, global);
    helperBuilder.createRetVoid();

    Function main = new Function("main", Type.INT);
    module.addFunction(main);
    IRBuilder builder = new IRBuilder(main.addBlock("entry"));
    var input = builder.createCall(getint, Type.INT);
    builder.createStore(input, local);
    builder.createCall(helper, Type.VOID, input);
    builder.createRet(builder.createLoad(Type.INT, local));

    PassBuilder passBuilder = new PassBuilder();
    passBuilder.buildIRO0Pipeline(PassInstrumentation.noop()).run(
        module,
        passBuilder.buildModuleAnalysisManager(),
        passBuilder.buildFunctionAnalysisManager());
    IRVerifier.verifyModule(module);

    assertFalse(global.hasUses());
    assertFalse(local.hasUses());
    assertFalse(module.getFunctions().contains(helper));
  }
}
