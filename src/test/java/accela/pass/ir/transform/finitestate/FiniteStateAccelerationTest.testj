package accela.pass.ir.transform.finitestate;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertNotSame;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.ExactI32;
import accela.ir.Function;
import accela.ir.GlobalVariable;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Type;
import accela.ir.Value;
import accela.pass.FiniteStateAccelerationCandidate;
import accela.pass.PassDescriptor;
import accela.pass.PreservedAnalyses;
import accela.pass.instrument.DecisionRemark;
import accela.pass.instrument.DecisionStatus;
import accela.pass.instrument.OptimizationRemark;
import accela.pass.ir.FunctionAnalysisManager;
import accela.pass.ir.FunctionPassManager;
import accela.pass.ir.analysis.DominatorTreeAnalysis;
import accela.pass.ir.analysis.InductionVariableAnalysis;
import accela.pass.ir.analysis.LoopAnalysis;
import accela.pass.ir.analysis.ScalarEvolutionAnalysis;
import accela.pass.ir.instrument.PassInstrumentation;
import accela.pass.ir.verify.IRVerifier;
import java.util.ArrayList;
import java.util.List;
import org.junit.jupiter.api.Test;

final class FiniteStateAccelerationTest {
  @Test
  void descriptorExactlyMatchesTheFrozenScreeningContract() {
    PassDescriptor descriptor = FiniteStateAccelerationCandidate.descriptor();

    assertEquals(FiniteStateAccelerationCandidate.ID, descriptor.id());
    assertEquals(FiniteStateAccelerationCandidate.ID, descriptor.logicalFamilyId());
    assertEquals(PassDescriptor.Stage.IR_FUNCTION, descriptor.stage());
    assertEquals(PassDescriptor.Lifecycle.CANDIDATE, descriptor.lifecycle());
    assertEquals(1, descriptor.fullPipelineOccurrences());
    assertTrue(descriptor.candidate());
    assertTrue(descriptor.decisionObservable());
    assertFalse(descriptor.defaultEnabled());
    assertEquals("ir.affine-loop-summarization", descriptor.candidateAnchor().passId());
    assertEquals(1, descriptor.candidateAnchor().occurrence());
    assertEquals(PassDescriptor.AnchorPosition.BEFORE, descriptor.candidateAnchor().position());
    assertEquals(
        List.of(
            "candidate.finite-state-acceleration.constant-finite-domain",
            "candidate.finite-state-acceleration.transition-closure",
            "candidate.finite-state-acceleration.deterministic-pure-transition",
            "candidate.finite-state-acceleration.iteration-domain",
            "candidate.finite-state-acceleration.exact-state-encoding",
            "candidate.finite-state-acceleration.modulo-i32-equivalence",
            "candidate.finite-state-acceleration.storage-code-size",
            "candidate.finite-state-acceleration.profitability"),
        descriptor.legalityObligationIds());
  }

  @Test
  void exactI32UtilityNormalizesEveryBoundaryOperation() {
    assertEquals(Integer.MIN_VALUE, ExactI32.add(Integer.MAX_VALUE, 1));
    assertEquals(Integer.MAX_VALUE, ExactI32.subtract(Integer.MIN_VALUE, 1));
    assertEquals(-2, ExactI32.multiply(Integer.MAX_VALUE, 2));
    assertEquals(-1, ExactI32.multiplyHigh(Integer.MIN_VALUE, 2));
    assertEquals(Integer.MIN_VALUE, ExactI32.divide(Integer.MIN_VALUE, -1));
    assertEquals(0, ExactI32.remainder(Integer.MIN_VALUE, -1));
    assertEquals(7, ExactI32.normalize(0x1_0000_0007L));
    assertThrows(ArithmeticException.class, () -> ExactI32.divide(1, 0));
    assertThrows(ArithmeticException.class, () -> ExactI32.shiftLeft(1, 32));
  }

  @Test
  void matchesAffineBranchingAndQuadraticClosedDomains() {
    Fixture affine = affineFixture(97, 5, 1, null, 0, 1);
    assertMapping(affine, state -> (state * 5 + 1) % 97);

    Fixture quadratic = quadraticFixture(31);
    assertMapping(quadratic, state -> (state * state + 3) % 31);

    Fixture branch = branchFixture(53);
    assertMapping(branch,
        state -> state % 3 == 0 ? (state + 17) % 53 : (state * 2 + 7) % 53);
  }

  @Test
  void normalizedLongConstantsDoNotLeakSccpLongArithmeticIntoTheProof() {
    Fixture fixture = affineFixture(7, 3, 1, null, 0, 1);
    fixture.nextState().setOperand(1, Constant.intConst(0x1_0000_0007L));
    fixture.induction().setOperand(0, Constant.intConst(0x1_0000_0000L));

    FiniteStateAccelerationMatcher.MatchResult result = match(fixture);

    assertTrue(result.candidate() != null);
    assertEquals(7, result.candidate().domainSize());
    assertEquals(List.of(1, 4, 0, 3, 6, 2, 5),
        java.util.Arrays.stream(result.candidate().transition()).boxed().toList());
  }

  @Test
  void transformationBuildsAConstantBoundedJumpTableAndCollisionSafeNames() {
    Fixture fixture = affineFixture(7, 3, 1, null, 0, 1);
    fixture.module().addGlobal(new GlobalVariable(
        "__accela_fsa_finite_state_header", Type.INT, Constant.intConst(0), false));
    BasicBlock collision = fixture.function().addBlock("header.finite.state.guard");
    new IRBuilder(collision).createRet(Constant.intConst(0));
    FunctionAnalysisManager analyses = analysisManager();
    LoopAnalysis.Result before = analyses.getResult(LoopAnalysis.class, fixture.function());
    List<OptimizationRemark> remarks = new ArrayList<>();

    try (PassInstrumentation instrumentation =
        PassInstrumentation.observed(false, remarks::add)) {
      FunctionPassManager manager = new FunctionPassManager(instrumentation);
      manager.addPass(
          new FiniteStateAcceleration.Pass(
              instrumentation, FiniteStateAccelerationCandidate.descriptor(), 1),
          FiniteStateAccelerationCandidate.descriptor(),
          1);
      PreservedAnalyses preserved = manager.run(fixture.function(), analyses);
      assertTrue(preserved.preservesNone());
    }

    IRVerifier.verifyModule(fixture.module());
    LoopAnalysis.Result after = analyses.getResult(LoopAnalysis.class, fixture.function());
    assertNotSame(before, after);
    assertEquals(2, fixture.module().getGlobals().size());
    GlobalVariable table = fixture.module().getGlobals().getLast();
    assertEquals("__accela_fsa_finite_state_header.1", table.getName());
    assertTrue(table.isConstant());
    assertEquals(31, table.getValueType().size);
    assertEquals(7, table.getValueType().innerType.size);
    Constant.Array tableInitializer = (Constant.Array) table.getInitializer();
    assertEquals(31, tableInitializer.elements.size());
    Constant.Array firstRow = (Constant.Array) tableInitializer.elements.getFirst();
    assertEquals(List.of(1, 4, 0, 3, 6, 2, 5), firstRow.elements.stream()
        .map(Constant.Int.class::cast).map(value -> (int) value.value).toList());
    assertTrue(fixture.function().getBlocks().stream()
        .anyMatch(block -> block.getLabel().equals("header.finite.state.1.guard")));
    assertEquals(
        List.of(DecisionStatus.CANDIDATE, DecisionStatus.APPLIED),
        remarks.stream().filter(DecisionRemark.class::isInstance)
            .map(DecisionRemark.class::cast).map(DecisionRemark::decision).toList());
  }

  @Test
  void rejectedCandidateEmitsItsExactTerminalObligationAndPreservesAnalyses() {
    Fixture identity = affineFixture(7, 1, 0, null, 0, 1);
    List<OptimizationRemark> remarks = new ArrayList<>();
    PreservedAnalyses preserved;
    try (PassInstrumentation instrumentation =
        PassInstrumentation.observed(false, remarks::add)) {
      preserved = new FiniteStateAcceleration.Pass(
          instrumentation, FiniteStateAccelerationCandidate.descriptor(), 1)
          .run(identity.function(), analysisManager());
    }

    assertTrue(preserved.preservesAll());
    assertEquals(
        List.of(DecisionStatus.CANDIDATE, DecisionStatus.REJECTED),
        remarks.stream().map(DecisionRemark.class::cast).map(DecisionRemark::decision).toList());
    assertEquals(
        FiniteStateAccelerationCandidate.PROFITABILITY,
        ((DecisionRemark) remarks.getLast()).legalityObligationId());
  }

  @Test
  void rejectsEveryFrozenLegalityBoundaryWithItsExactObligation() {
    Fixture variableDomain = affineFixture(7, 3, 1, null, 0, 1);
    variableDomain.nextState().setOperand(1, variableDomain.bound());
    assertRejected(variableDomain, FiniteStateAccelerationCandidate.CONSTANT_FINITE_DOMAIN);

    Fixture nonClosed = affineFixture(7, 1, -5, null, 0, 1);
    assertRejected(nonClosed, FiniteStateAccelerationCandidate.TRANSITION_CLOSURE);

    Fixture effectful = affineFixture(7, 3, 1, null, 0, 1);
    IRBuilder entryBuilder = new IRBuilder();
    entryBuilder.setInsertPointBefore(effectful.function().getEntryBlock().getTerminator());
    Instruction storage = entryBuilder.createAlloca(Type.INT);
    beforeTerminator(effectful.body()).createStore(effectful.state(), storage);
    assertRejected(
        effectful, FiniteStateAccelerationCandidate.DETERMINISTIC_PURE_TRANSITION);

    Fixture floating = affineFixture(7, 3, 1, null, 0, 1);
    beforeTerminator(floating.body()).createSIToFP(floating.state(), Type.FLOAT);
    assertRejected(
        floating, FiniteStateAccelerationCandidate.DETERMINISTIC_PURE_TRANSITION);

    Fixture inductionDependent = affineFixture(7, 3, 1, null, 0, 1);
    IRBuilder dependentBuilder = new IRBuilder();
    dependentBuilder.setInsertPointBefore(inductionDependent.nextState());
    Value iterationSpecific = dependentBuilder.createAdd(
        inductionDependent.state(), inductionDependent.induction().getOperand(2));
    inductionDependent.nextState().setOperand(0, iterationSpecific);
    assertRejected(
        inductionDependent, FiniteStateAccelerationCandidate.DETERMINISTIC_PURE_TRANSITION);

    Fixture wrongStep = affineFixture(7, 3, 1, null, 0, 2);
    assertRejected(wrongStep, FiniteStateAccelerationCandidate.ITERATION_DOMAIN);

    Fixture multipleStates = affineFixture(7, 3, 1, null, 0, 1);
    addSecondState(multipleStates);
    assertRejected(multipleStates, FiniteStateAccelerationCandidate.EXACT_STATE_ENCODING);

    Fixture undefinedI32 = affineFixture(7, 3, 1, null, 0, 1);
    IRBuilder undefinedBuilder = new IRBuilder();
    undefinedBuilder.setInsertPointBefore(undefinedI32.nextState());
    Value zero = undefinedBuilder.createSub(undefinedI32.state(), undefinedI32.state());
    Value division = undefinedBuilder.createSDiv(undefinedI32.state(), zero);
    undefinedI32.nextState().setOperand(0, division);
    assertRejected(undefinedI32, FiniteStateAccelerationCandidate.MODULO_I32_EQUIVALENCE);

    Fixture oversized = affineFixture(129, 3, 1, null, 0, 1);
    FiniteStateAccelerationMatcher.MatchResult oversizedMatch = match(oversized);
    assertTrue(oversizedMatch.candidate() != null);
    assertEquals(
        FiniteStateAccelerationCandidate.STORAGE_CODE_SIZE,
        FiniteStateAccelerationProfitability.evaluate(oversizedMatch.candidate(), 0)
            .rejectedObligationId());

    Fixture withinPerTableLimit = affineFixture(128, 3, 1, null, 0, 1);
    FiniteStateAccelerationMatcher.MatchResult budgetMatch = match(withinPerTableLimit);
    assertTrue(budgetMatch.candidate() != null);
    assertEquals(
        FiniteStateAccelerationCandidate.STORAGE_CODE_SIZE,
        FiniteStateAccelerationProfitability.evaluate(
            budgetMatch.candidate(), FiniteStateAccelerationProfitability.MAX_PASS_TABLE_BYTES)
            .rejectedObligationId());

    Fixture identity = affineFixture(7, 1, 0, null, 0, 1);
    FiniteStateAccelerationMatcher.MatchResult identityMatch = match(identity);
    assertTrue(identityMatch.candidate() != null);
    assertEquals(
        FiniteStateAccelerationCandidate.PROFITABILITY,
        FiniteStateAccelerationProfitability.evaluate(identityMatch.candidate(), 0)
            .rejectedObligationId());
  }

  @Test
  void descriptorAndFactoryValidationFailFast() {
    PassDescriptor expected = FiniteStateAccelerationCandidate.descriptor();
    PassDescriptor altered = new PassDescriptor(
        expected.id(),
        expected.logicalFamilyId(),
        expected.displayName() + " altered",
        expected.stage(),
        expected.fullPipelineOccurrences(),
        expected.lifecycle(),
        expected.decisionObservable(),
        expected.candidateAnchor(),
        expected.legalityObligationIds());
    try (PassInstrumentation instrumentation = PassInstrumentation.enabled(false)) {
      assertThrows(
          IllegalArgumentException.class,
          () -> new FiniteStateAcceleration.Pass(instrumentation, altered, 1));
      assertThrows(
          IllegalArgumentException.class,
          () -> new FiniteStateAcceleration.Pass(instrumentation, expected, 2));
    }
    assertThrows(
        IllegalArgumentException.class,
        () -> FiniteStateAccelerationCandidate.functionFactory(PassInstrumentation.noop()));
  }

  @Test
  void knownShortTripIsRejectedBeforeAnyTableIsAdded() {
    Fixture fixture = affineFixture(7, 3, 1, Constant.intConst(7), 0, 1);
    FiniteStateAccelerationMatcher.MatchResult matched = match(fixture);
    assertTrue(matched.candidate() != null);
    assertEquals(
        FiniteStateAccelerationCandidate.PROFITABILITY,
        FiniteStateAccelerationProfitability.evaluate(matched.candidate(), 0)
            .rejectedObligationId());
    assertFalse(FiniteStateAcceleration.run(fixture.function(), analysisManager()));
    assertTrue(fixture.module().getGlobals().isEmpty());
  }

  @Test
  void profitabilityRejectsUnrepresentableAndNonpositiveIterationGuards() {
    for (int start : List.of(Integer.MAX_VALUE, Integer.MAX_VALUE - 1)) {
      Fixture fixture = affineFixture(7, 3, 1, null, start, 1);
      FiniteStateAccelerationMatcher.MatchResult matched = match(fixture);
      assertTrue(matched.candidate() != null);
      assertEquals(
          FiniteStateAccelerationCandidate.PROFITABILITY,
          FiniteStateAccelerationProfitability.evaluate(matched.candidate(), 0)
              .rejectedObligationId());
      assertFalse(FiniteStateAcceleration.run(fixture.function(), analysisManager()));
      assertTrue(fixture.module().getGlobals().isEmpty());
    }

    Fixture boundAtStart = affineFixture(7, 3, 1, Constant.intConst(19), 19, 1);
    FiniteStateAccelerationMatcher.MatchResult matched = match(boundAtStart);
    assertTrue(matched.candidate() != null);
    assertEquals(
        FiniteStateAccelerationCandidate.PROFITABILITY,
        FiniteStateAccelerationProfitability.evaluate(matched.candidate(), 0)
            .rejectedObligationId());
    assertFalse(FiniteStateAcceleration.run(boundAtStart.function(), analysisManager()));
    assertTrue(boundAtStart.module().getGlobals().isEmpty());
  }

  private static void assertMapping(Fixture fixture, java.util.function.IntUnaryOperator expected) {
    IRVerifier.verifyModule(fixture.module());
    FiniteStateAccelerationMatcher.MatchResult result = match(fixture);
    assertTrue(result.candidate() != null, () -> result.rejectedObligationId());
    int[] mapping = result.candidate().transition();
    for (int state = 0; state < mapping.length; state++) {
      assertEquals(expected.applyAsInt(state), mapping[state], "state=" + state);
    }
  }

  private static void assertRejected(Fixture fixture, String obligation) {
    IRVerifier.verifyModule(fixture.module());
    FiniteStateAccelerationMatcher.MatchResult result = match(fixture);
    assertEquals(obligation, result.rejectedObligationId());
    assertFalse(FiniteStateAcceleration.run(fixture.function(), analysisManager()));
    IRVerifier.verifyModule(fixture.module());
  }

  private static FiniteStateAccelerationMatcher.MatchResult match(Fixture fixture) {
    FunctionAnalysisManager analyses = analysisManager();
    LoopAnalysis.Loop loop = analyses.getResult(LoopAnalysis.class, fixture.function())
        .loops().getFirst();
    return FiniteStateAccelerationMatcher.match(
        loop,
        analyses.getResult(InductionVariableAnalysis.class, fixture.function()),
        analyses.getResult(ScalarEvolutionAnalysis.class, fixture.function()));
  }

  private static Fixture affineFixture(
      int domain, int multiplier, int increment, Value fixedBound, int start, int step) {
    Function function = new Function("finite_state", Type.INT);
    Value bound = fixedBound == null ? function.addArgument(Type.INT, "bound") : fixedBound;
    Value initial = function.addArgument(Type.INT, "initial");
    accela.ir.Module module = new accela.ir.Module();
    module.addFunction(function);
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock body = function.addBlock("body");
    BasicBlock exit = function.addBlock("exit");
    new IRBuilder(entry).createBr(header);

    IRBuilder headerBuilder = new IRBuilder(header);
    Instruction induction = headerBuilder.createPhi(Type.INT);
    Instruction state = headerBuilder.createPhi(Type.INT);
    headerBuilder.createCondBr(
        headerBuilder.createICmp("slt", induction, bound), body, exit);

    IRBuilder bodyBuilder = new IRBuilder(body);
    Value numerator = multiplier == 1
        ? state : bodyBuilder.createMul(state, Constant.intConst(multiplier));
    if (increment != 0) numerator = bodyBuilder.createAdd(numerator, Constant.intConst(increment));
    Instruction nextState = bodyBuilder.createSRem(numerator, Constant.intConst(domain));
    Instruction nextInduction = bodyBuilder.createAdd(induction, Constant.intConst(step));
    bodyBuilder.createBr(header);

    induction.addOperand(Constant.intConst(start));
    induction.addOperand(entry);
    induction.addOperand(nextInduction);
    induction.addOperand(body);
    state.addOperand(initial);
    state.addOperand(entry);
    state.addOperand(nextState);
    state.addOperand(body);
    new IRBuilder(exit).createRet(state);
    return new Fixture(module, function, body, bound, induction, state, nextState);
  }

  private static Fixture quadraticFixture(int domain) {
    Fixture fixture = affineFixture(domain, 1, 0, null, 0, 1);
    IRBuilder builder = new IRBuilder();
    builder.setInsertPointBefore(fixture.nextState());
    Value square = builder.createMul(fixture.state(), fixture.state());
    Value numerator = builder.createAdd(square, Constant.intConst(3));
    fixture.nextState().setOperand(0, numerator);
    return fixture;
  }

  private static Fixture branchFixture(int domain) {
    Function function = new Function("finite_state_branch", Type.INT);
    Value bound = function.addArgument(Type.INT, "bound");
    Value initial = function.addArgument(Type.INT, "initial");
    accela.ir.Module module = new accela.ir.Module();
    module.addFunction(function);
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock body = function.addBlock("body");
    BasicBlock onDivisible = function.addBlock("divisible");
    BasicBlock onOther = function.addBlock("other");
    BasicBlock latch = function.addBlock("latch");
    BasicBlock exit = function.addBlock("exit");
    new IRBuilder(entry).createBr(header);
    IRBuilder headerBuilder = new IRBuilder(header);
    Instruction induction = headerBuilder.createPhi(Type.INT);
    Instruction state = headerBuilder.createPhi(Type.INT);
    headerBuilder.createCondBr(
        headerBuilder.createICmp("slt", induction, bound), body, exit);

    IRBuilder bodyBuilder = new IRBuilder(body);
    Value mod3 = bodyBuilder.createSRem(state, Constant.intConst(3));
    bodyBuilder.createCondBr(
        bodyBuilder.createICmp("eq", mod3, Constant.intConst(0)), onDivisible, onOther);
    IRBuilder divisibleBuilder = new IRBuilder(onDivisible);
    Value plus17 = divisibleBuilder.createAdd(state, Constant.intConst(17));
    Value divisibleNext = divisibleBuilder.createSRem(plus17, Constant.intConst(domain));
    divisibleBuilder.createBr(latch);
    IRBuilder otherBuilder = new IRBuilder(onOther);
    Value doubled = otherBuilder.createMul(state, Constant.intConst(2));
    Value plus7 = otherBuilder.createAdd(doubled, Constant.intConst(7));
    Value otherNext = otherBuilder.createSRem(plus7, Constant.intConst(domain));
    otherBuilder.createBr(latch);
    IRBuilder latchBuilder = new IRBuilder(latch);
    Instruction nextState = latchBuilder.createPhi(Type.INT);
    nextState.addOperand(divisibleNext);
    nextState.addOperand(onDivisible);
    nextState.addOperand(otherNext);
    nextState.addOperand(onOther);
    Instruction nextInduction = latchBuilder.createAdd(induction, Constant.intConst(1));
    latchBuilder.createBr(header);

    induction.addOperand(Constant.intConst(0));
    induction.addOperand(entry);
    induction.addOperand(nextInduction);
    induction.addOperand(latch);
    state.addOperand(initial);
    state.addOperand(entry);
    state.addOperand(nextState);
    state.addOperand(latch);
    new IRBuilder(exit).createRet(state);
    return new Fixture(module, function, body, bound, induction, state, nextState);
  }

  private static void addSecondState(Fixture fixture) {
    Instruction compare = (Instruction) fixture.function().getBlocks().get(1)
        .getTerminator().getOperand(0);
    IRBuilder headerBuilder = new IRBuilder();
    headerBuilder.setInsertPointBefore(compare);
    Instruction second = headerBuilder.createPhi(Type.INT);
    IRBuilder bodyBuilder = beforeTerminator(fixture.body());
    Instruction next = bodyBuilder.createAdd(second, Constant.intConst(1));
    second.addOperand(Constant.intConst(0));
    second.addOperand(fixture.function().getEntryBlock());
    second.addOperand(next);
    second.addOperand(fixture.body());
  }

  private static IRBuilder beforeTerminator(BasicBlock block) {
    IRBuilder builder = new IRBuilder();
    builder.setInsertPointBefore(block.getTerminator());
    return builder;
  }

  private static FunctionAnalysisManager analysisManager() {
    FunctionAnalysisManager analyses = new FunctionAnalysisManager();
    analyses.registerPass(DominatorTreeAnalysis.class, new DominatorTreeAnalysis());
    analyses.registerPass(LoopAnalysis.class, new LoopAnalysis());
    analyses.registerPass(InductionVariableAnalysis.class, new InductionVariableAnalysis());
    analyses.registerPass(ScalarEvolutionAnalysis.class, new ScalarEvolutionAnalysis());
    return analyses;
  }

  private record Fixture(
      accela.ir.Module module,
      Function function,
      BasicBlock body,
      Value bound,
      Instruction induction,
      Instruction state,
      Instruction nextState) {}
}
