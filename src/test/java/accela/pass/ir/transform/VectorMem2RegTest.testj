package accela.pass.ir.transform;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertSame;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.Function;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Type;
import accela.ir.Value;
import accela.pass.ir.analysis.DominatorTreeAnalysis;
import accela.pass.ir.verify.IRVerifier;
import java.util.List;
import org.junit.jupiter.api.Test;

final class VectorMem2RegTest {
  @Test
  void promotesVectorLoadsAndStoresAsOneSsaValue() {
    Function function = new Function("vector_mem2reg", Type.INT);
    BasicBlock entry = function.addBlock("entry");
    IRBuilder builder = new IRBuilder(entry);
    Type int4 = Type.vector(Type.INT, 4);
    Constant.Vector value = Constant.vector(
        int4,
        List.of(
            Constant.intConst(1), Constant.intConst(2),
            Constant.intConst(3), Constant.intConst(4)));
    Value slot = builder.createAlloca(int4);
    builder.createStore(value, slot);
    Instruction loaded = builder.createLoad(int4, slot);
    Instruction extracted = builder.createExtractElement(loaded, Constant.intConst(2));
    builder.createRet(extracted);

    assertTrue(PromoteMemoryToRegister.run(
        function, new DominatorTreeAnalysis().run(function, null)));
    IRVerifier.verifyFunction(function);
    assertSame(value, extracted.getOperand(0));
    assertEquals(0, entry.getInstructions().stream()
        .filter(instruction -> instruction.getOpcode() == Instruction.Opcode.ALLOCA
            || instruction.getOpcode() == Instruction.Opcode.LOAD
            || instruction.getOpcode() == Instruction.Opcode.STORE)
        .count());
  }

  @Test
  void createsVectorPhisForBranchingStores() {
    Function function = new Function("vector_mem2reg_phi", Type.INT);
    Value condition = function.addArgument(Type.I1, "condition");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock left = function.addBlock("left");
    BasicBlock right = function.addBlock("right");
    BasicBlock merge = function.addBlock("merge");
    Type int2 = Type.vector(Type.INT, 2);
    Constant.Vector leftValue = Constant.vector(
        int2, List.of(Constant.intConst(1), Constant.intConst(2)));
    Constant.Vector rightValue = Constant.vector(
        int2, List.of(Constant.intConst(3), Constant.intConst(4)));
    IRBuilder entryBuilder = new IRBuilder(entry);
    Value slot = entryBuilder.createAlloca(int2);
    entryBuilder.createCondBr(condition, left, right);
    IRBuilder leftBuilder = new IRBuilder(left);
    leftBuilder.createStore(leftValue, slot);
    leftBuilder.createBr(merge);
    IRBuilder rightBuilder = new IRBuilder(right);
    rightBuilder.createStore(rightValue, slot);
    rightBuilder.createBr(merge);
    IRBuilder mergeBuilder = new IRBuilder(merge);
    Value loaded = mergeBuilder.createLoad(int2, slot);
    mergeBuilder.createRet(mergeBuilder.createExtractElement(loaded, Constant.intConst(0)));

    assertTrue(PromoteMemoryToRegister.run(
        function, new DominatorTreeAnalysis().run(function, null)));
    IRVerifier.verifyFunction(function);

    Instruction phi = merge.getInstructions().getFirst();
    assertEquals(Instruction.Opcode.PHI, phi.getOpcode());
    assertEquals(int2, phi.getType());
    assertEquals(0, function.getBlocks().stream()
        .flatMap(block -> block.getInstructions().stream())
        .filter(instruction -> instruction.getOpcode() == Instruction.Opcode.ALLOCA
            || instruction.getOpcode() == Instruction.Opcode.LOAD
            || instruction.getOpcode() == Instruction.Opcode.STORE)
        .count());
  }
}
