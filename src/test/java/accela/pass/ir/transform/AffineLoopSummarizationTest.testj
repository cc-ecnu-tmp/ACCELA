package accela.pass.ir.transform;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.Function;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Type;
import accela.ir.Value;
import accela.pass.ir.FunctionAnalysisManager;
import accela.pass.ir.analysis.DominatorTreeAnalysis;
import accela.pass.ir.analysis.LoopAnalysis;
import accela.pass.ir.verify.IRVerifier;
import accela.pass.PassRegistry;
import accela.pass.instrument.DecisionRemark;
import accela.pass.instrument.DecisionStatus;
import accela.pass.instrument.OptimizationRemark;
import accela.pass.ir.instrument.PassInstrumentation;
import java.util.ArrayList;
import java.util.List;
import org.junit.jupiter.api.Test;

final class AffineLoopSummarizationTest {
  @Test
  void addsAClosedFormPathAndKeepsAnOverflowFallbackForRemainder() {
    Fixture fixture = fixture(true, false);

    assertTrue(AffineLoopSummarization.run(fixture.function, analysisManager()));
    IRVerifier.verifyFunction(fixture.function);
    assertEquals(6, fixture.state.getNumOperands());
    assertTrue(fixture.function.getBlocks().stream()
        .anyMatch(block -> block.getLabel().contains("affine.summary")));
    assertTrue(fixture.function.getBlocks().stream()
        .anyMatch(block -> block.getLabel().contains("affine.modrange")));
  }

  @Test
  void summarizesPlainIntegerAdditionWithoutASeparateGuard() {
    Fixture fixture = fixture(false, false);

    assertTrue(AffineLoopSummarization.run(fixture.function, analysisManager()));
    IRVerifier.verifyFunction(fixture.function);
    assertTrue(fixture.function.getBlocks().stream()
        .anyMatch(block -> block.getLabel().contains("affine.summary")));
    assertFalse(fixture.function.getBlocks().stream()
        .anyMatch(block -> block.getLabel().contains("affine.count")));
  }

  @Test
  void refusesLoopsWithMemorySideEffects() {
    Fixture fixture = fixture(true, true);

    assertFalse(AffineLoopSummarization.run(fixture.function, analysisManager()));
    assertEquals(4, fixture.function.getBlocks().size());
  }

  @Test
  void emitsRealCandidateAndAppliedDecisionsForMatchedLoops() {
    Fixture fixture = fixture(false, false);
    List<OptimizationRemark> remarks = new ArrayList<>();
    var descriptor = PassRegistry.standard().require(
        PassRegistry.IR_AFFINE_LOOP_SUMMARIZATION);
    var pass = new AffineLoopSummarization.Pass(
        PassInstrumentation.observed(false, remarks::add), descriptor, 1);

    pass.run(fixture.function, analysisManager());

    assertEquals(List.of(DecisionStatus.CANDIDATE, DecisionStatus.APPLIED), remarks.stream()
        .map(DecisionRemark.class::cast).map(DecisionRemark::decision).toList());
  }

  @Test
  void summarizesNonzeroInductionWithAStrideAndMultipleStates() {
    Function function = new Function("strided", Type.INT);
    Value bound = function.addArgument(Type.INT, "bound");
    Value dynamicStep = function.addArgument(Type.INT, "step");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock body = function.addBlock("body");
    BasicBlock exit = function.addBlock("exit");
    new IRBuilder(entry).createBr(header);

    IRBuilder hb = new IRBuilder(header);
    Instruction induction = hb.createPhi(Type.INT);
    Instruction first = hb.createPhi(Type.INT);
    Instruction second = hb.createPhi(Type.INT);
    hb.createCondBr(hb.createICmp("sgt", bound, induction), body, exit);

    IRBuilder bb = new IRBuilder(body);
    Instruction nextFirst = bb.createAdd(first, dynamicStep);
    Instruction nextSecond = bb.createAdd(second, Constant.intConst(-3));
    Instruction nextInduction = bb.createAdd(induction, Constant.intConst(4));
    bb.createBr(header);
    induction.addOperand(Constant.intConst(5));
    induction.addOperand(entry);
    induction.addOperand(nextInduction);
    induction.addOperand(body);
    first.addOperand(Constant.intConst(7));
    first.addOperand(entry);
    first.addOperand(nextFirst);
    first.addOperand(body);
    second.addOperand(Constant.intConst(11));
    second.addOperand(entry);
    second.addOperand(nextSecond);
    second.addOperand(body);
    new IRBuilder(exit).createRet(first);

    assertTrue(AffineLoopSummarization.run(function, analysisManager()));
    IRVerifier.verifyFunction(function);
    assertEquals(6, induction.getNumOperands());
    assertEquals(6, first.getNumOperands());
    assertEquals(6, second.getNumOperands());
  }

  @Test
  void refusesAnUnrecognizedLoopCarriedPhi() {
    Fixture fixture = fixture(false, false);
    BasicBlock header = fixture.function.getBlocks().get(1);
    IRBuilder builder = new IRBuilder();
    builder.setInsertPointBefore(header.getInstructions().stream()
        .filter(instruction -> instruction.getOpcode() != Instruction.Opcode.PHI)
        .findFirst()
        .orElseThrow());
    Instruction unknown = builder.createPhi(Type.INT);
    unknown.addOperand(Constant.intConst(0));
    unknown.addOperand(fixture.function.getBlocks().get(0));
    unknown.addOperand(unknown);
    unknown.addOperand(fixture.function.getBlocks().get(2));

    assertFalse(AffineLoopSummarization.run(fixture.function, analysisManager()));
  }

  private static Fixture fixture(boolean remainder, boolean sideEffect) {
    Function function = new Function("affine", Type.INT);
    Value start = function.addArgument(Type.INT, "start");
    Value bound = function.addArgument(Type.INT, "bound");
    Value storage = function.addArgument(Type.PTR, "storage");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock body = function.addBlock("body");
    BasicBlock exit = function.addBlock("exit");
    new IRBuilder(entry).createBr(header);

    IRBuilder headerBuilder = new IRBuilder(header);
    Instruction induction = headerBuilder.createPhi(Type.INT);
    Instruction state = headerBuilder.createPhi(Type.INT);
    Instruction compare = headerBuilder.createICmp("slt", induction, bound);
    headerBuilder.createCondBr(compare, body, exit);

    IRBuilder bodyBuilder = new IRBuilder(body);
    Instruction addition = bodyBuilder.createAdd(state, Constant.intConst(128));
    Instruction nextState = remainder
        ? bodyBuilder.createSRem(addition, Constant.intConst(65535))
        : addition;
    if (sideEffect) bodyBuilder.createStore(nextState, storage);
    Instruction nextInduction = bodyBuilder.createAdd(induction, Constant.intConst(1));
    bodyBuilder.createBr(header);

    induction.addOperand(Constant.intConst(0));
    induction.addOperand(entry);
    induction.addOperand(nextInduction);
    induction.addOperand(body);
    state.addOperand(start);
    state.addOperand(entry);
    state.addOperand(nextState);
    state.addOperand(body);
    new IRBuilder(exit).createRet(state);
    return new Fixture(function, state);
  }

  private static FunctionAnalysisManager analysisManager() {
    FunctionAnalysisManager fam = new FunctionAnalysisManager();
    fam.registerPass(DominatorTreeAnalysis.class, new DominatorTreeAnalysis());
    fam.registerPass(LoopAnalysis.class, new LoopAnalysis());
    return fam;
  }

  private record Fixture(Function function, Instruction state) {}
}
