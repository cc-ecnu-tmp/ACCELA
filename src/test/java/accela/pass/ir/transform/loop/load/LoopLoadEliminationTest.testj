package accela.pass.ir.transform.loop.load;

import static org.junit.jupiter.api.Assertions.assertNull;
import static org.junit.jupiter.api.Assertions.assertSame;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.Function;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Type;
import accela.ir.Value;
import accela.pass.ir.FunctionAnalysisManager;
import accela.pass.ir.analysis.DominatorTreeAnalysis;
import accela.pass.ir.analysis.LoopAnalysis;
import accela.pass.ir.verify.IRVerifier;
import org.junit.jupiter.api.Test;

final class LoopLoadEliminationTest {
  @Test
  void forwardsTheStoredValueAroundARotatedLoop() {
    Function function = new Function("forward", Type.VOID);
    Value condition = function.addArgument(Type.I1, "condition");
    Value base = function.addArgument(Type.PTR, "base");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock loop = function.addBlock("loop");
    BasicBlock exit = function.addBlock("exit");
    new IRBuilder(entry).createBr(loop);

    IRBuilder builder = new IRBuilder(loop);
    Instruction pointer = builder.createPhi(Type.PTR);
    pointer.addOperand(base);
    pointer.addOperand(entry);
    Instruction load = builder.createLoad(Type.INT, pointer);
    Instruction stored = builder.createAdd(load, Constant.intConst(1));
    Instruction next = builder.createGEP(
        Type.INT, pointer, new Value[] {Constant.int64Const(1)}, false);
    builder.createStore(stored, next);
    pointer.addOperand(next);
    pointer.addOperand(loop);
    builder.createCondBr(condition, loop, exit);
    new IRBuilder(exit).createRetVoid();

    FunctionAnalysisManager fam = analysisManager();
    assertTrue(LoopLoadElimination.run(function, fam));
    IRVerifier.verifyFunction(function);

    assertNull(load.getParent());
    Instruction forwarded = loop.getInstructions().stream()
        .filter(instruction -> instruction.getOpcode() == Instruction.Opcode.PHI)
        .filter(instruction -> instruction.getType() == Type.INT)
        .findFirst()
        .orElseThrow();
    assertSame(entry, ((Instruction) forwarded.getOperand(0)).getParent());
    assertSame(stored, forwarded.getOperand(2));
    assertSame(forwarded, stored.getOperand(0));
  }

  private static FunctionAnalysisManager analysisManager() {
    FunctionAnalysisManager fam = new FunctionAnalysisManager();
    fam.registerPass(DominatorTreeAnalysis.class, new DominatorTreeAnalysis());
    fam.registerPass(LoopAnalysis.class, new LoopAnalysis());
    return fam;
  }
}
