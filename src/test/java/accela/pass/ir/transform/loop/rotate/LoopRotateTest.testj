package accela.pass.ir.transform.loop.rotate;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertSame;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.Function;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Module;
import accela.ir.Type;
import accela.ir.Value;
import accela.pass.ir.FunctionAnalysisManager;
import accela.pass.ir.analysis.DominatorTreeAnalysis;
import accela.pass.ir.analysis.InductionVariableAnalysis;
import accela.pass.ir.analysis.LoopAnalysis;
import accela.pass.ir.transform.LICM;
import accela.pass.ir.verify.IRVerifier;
import org.junit.jupiter.api.Test;

final class LoopRotateTest {
  @Test
  void duplicatesVectorHeaderTestsIntoTheRotatedLatch() {
    Module module = new Module();
    Function function = new Function("vector_rotate", Type.INT);
    module.addFunction(function);
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock body = function.addBlock("body");
    BasicBlock exit = function.addBlock("exit");
    new IRBuilder(entry).createBr(header);
    IRBuilder headerBuilder = new IRBuilder(header);
    Instruction index = headerBuilder.createPhi(Type.INT);
    index.addOperand(Constant.intConst(0));
    index.addOperand(entry);
    Type int4 = Type.vector(Type.INT, 4);
    Instruction vector = headerBuilder.createSplat(int4, index);
    Instruction lane = headerBuilder.createExtractElement(vector, Constant.intConst(0));
    Instruction remainder = headerBuilder.createSRem(lane, Constant.intConst(4));
    headerBuilder.createCondBr(
        headerBuilder.createICmp("ne", remainder, Constant.intConst(3)), body, exit);
    IRBuilder bodyBuilder = new IRBuilder(body);
    Instruction next = bodyBuilder.createAdd(index, Constant.intConst(1));
    bodyBuilder.createBr(header);
    index.addOperand(next);
    index.addOperand(body);
    new IRBuilder(exit).createRet(Constant.intConst(0));

    assertTrue(LoopRotate.runOnFunction(function, analysisManager()));
    IRVerifier.verifyFunction(function);
    assertEquals(2, function.getBlocks().stream()
        .flatMap(block -> block.getInstructions().stream())
        .filter(instruction -> instruction.getOpcode() == Instruction.Opcode.SPLAT)
        .count());
  }

  @Test
  void formsAGuardedLoopAndEnablesPureCallLicm() {
    Module module = new Module();
    Function pure = new Function("pure", Type.INT);
    module.addFunction(pure);
    Value value = pure.addArgument(Type.INT, "value");
    new IRBuilder(pure.addBlock("entry")).createRet(value);

    Function function = new Function("loop", Type.VOID);
    module.addFunction(function);
    Value limit = function.addArgument(Type.INT, "limit");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock body = function.addBlock("body");
    BasicBlock exit = function.addBlock("exit");
    new IRBuilder(entry).createBr(header);
    IRBuilder headerBuilder = new IRBuilder(header);
    Instruction index = headerBuilder.createPhi(Type.INT);
    index.addOperand(Constant.intConst(0));
    index.addOperand(entry);
    Value condition = headerBuilder.createICmp("slt", index, limit);
    headerBuilder.createCondBr(condition, body, exit);
    IRBuilder bodyBuilder = new IRBuilder(body);
    Instruction call = bodyBuilder.createCall(pure, Type.INT, limit);
    Instruction next = bodyBuilder.createAdd(index, call);
    bodyBuilder.createBr(header);
    index.addOperand(next);
    index.addOperand(body);
    IRBuilder exitBuilder = new IRBuilder(exit);
    Instruction exitPhi = exitBuilder.createPhi(Type.INT);
    exitPhi.addOperand(Constant.intConst(0));
    exitPhi.addOperand(header);
    exitBuilder.createRetVoid();

    assertTrue(LoopRotate.runOnFunction(function, analysisManager()));
    IRVerifier.verifyFunction(function);
    BasicBlock guard = function.getBlocks().stream()
        .filter(block -> block.getLabel().contains(".lr.ph")).findFirst().orElseThrow();
    assertSame(guard, header.getSuccessors().getFirst());
    assertSame(body, guard.getSuccessors().getFirst());
    assertSame(Instruction.Opcode.PHI, body.getInstructions().getFirst().getOpcode());
    assertSame(Instruction.Opcode.CONDBR, body.getTerminator().getOpcode());
    assertSame(body, body.getSuccessors().get(0));
    assertSame(exit, body.getSuccessors().get(1));
    assertSame(body, exitPhi.getOperand(3));

    assertTrue(LICM.runOnFunction(function, analysisManager()));
    IRVerifier.verifyFunction(function);
    assertSame(guard, call.getParent());
  }

  @Test
  void rotatesPointerLoopWithLiveOutValue() {
    Module module = new Module();
    Function function = new Function("sum", Type.VOID);
    module.addFunction(function);
    Value enter = function.addArgument(Type.I1, "enter");
    Value limit = function.addArgument(Type.INT, "limit");
    Value base = function.addArgument(Type.PTR, "base");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock body = function.addBlock("body");
    BasicBlock exit = function.addBlock("exit");
    BasicBlock bypass = function.addBlock("bypass");
    new IRBuilder(entry).createCondBr(enter, header, bypass);

    IRBuilder headerBuilder = new IRBuilder(header);
    Instruction index = headerBuilder.createPhi(Type.INT);
    Instruction sum = headerBuilder.createPhi(Type.INT);
    index.addOperand(Constant.intConst(0));
    index.addOperand(entry);
    sum.addOperand(Constant.intConst(0));
    sum.addOperand(entry);
    headerBuilder.createCondBr(
        headerBuilder.createICmp("slt", index, limit), body, exit);

    IRBuilder bodyBuilder = new IRBuilder(body);
    Value address = bodyBuilder.createGEP(
        Type.INT, base, new Value[] {bodyBuilder.createSExt(index, Type.I64)}, false);
    Instruction nextSum = bodyBuilder.createAdd(sum, bodyBuilder.createLoad(Type.INT, address));
    Instruction nextIndex = bodyBuilder.createAdd(index, Constant.intConst(1));
    bodyBuilder.createBr(header);
    index.addOperand(nextIndex);
    index.addOperand(body);
    sum.addOperand(nextSum);
    sum.addOperand(body);
    Instruction liveOut = new IRBuilder(exit).createAdd(sum, Constant.intConst(1));
    new IRBuilder(exit).createRetVoid();
    new IRBuilder(bypass).createRetVoid();

    assertTrue(LoopRotate.runOnFunction(function, analysisManager()));
    IRVerifier.verifyFunction(function);
    assertSame(exit, ((Instruction) liveOut.getOperand(0)).getParent());
  }

  @Test
  void rotatesLoopVaryingRemainderCondition() {
    Module module = new Module();
    Function function = new Function("count", Type.INT);
    module.addFunction(function);
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock body = function.addBlock("body");
    BasicBlock exit = function.addBlock("exit");
    new IRBuilder(entry).createBr(header);

    IRBuilder headerBuilder = new IRBuilder(header);
    Instruction index = headerBuilder.createPhi(Type.INT);
    index.addOperand(Constant.intConst(0));
    index.addOperand(entry);
    Value remainder = headerBuilder.createSRem(index, Constant.intConst(4));
    headerBuilder.createCondBr(
        headerBuilder.createICmp("ne", remainder, Constant.intConst(3)), body, exit);

    IRBuilder bodyBuilder = new IRBuilder(body);
    Instruction next = bodyBuilder.createAdd(index, Constant.intConst(1));
    bodyBuilder.createBr(header);
    index.addOperand(next);
    index.addOperand(body);
    Instruction result = new IRBuilder(exit).createAdd(index, Constant.intConst(1));
    new IRBuilder(exit).createRet(result);

    assertTrue(LoopRotate.runOnFunction(function, analysisManager()));
    IRVerifier.verifyFunction(function);
    assertSame(body, body.getSuccessors().getFirst());
    assertSame(exit, ((Instruction) result.getOperand(0)).getParent());
  }

  private static FunctionAnalysisManager analysisManager() {
    FunctionAnalysisManager fam = new FunctionAnalysisManager();
    fam.registerPass(DominatorTreeAnalysis.class, new DominatorTreeAnalysis());
    fam.registerPass(LoopAnalysis.class, new LoopAnalysis());
    fam.registerPass(InductionVariableAnalysis.class, new InductionVariableAnalysis());
    return fam;
  }
}
