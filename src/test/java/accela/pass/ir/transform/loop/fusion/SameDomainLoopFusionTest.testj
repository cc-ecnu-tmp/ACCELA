package accela.pass.ir.transform.loop.fusion;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.Function;
import accela.ir.GlobalVariable;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Type;
import accela.ir.Value;
import accela.pass.PassDescriptor;
import accela.pass.PreservedAnalyses;
import accela.pass.SameDomainLoopFusionCandidate;
import accela.pass.instrument.DecisionRemark;
import accela.pass.instrument.DecisionStatus;
import accela.pass.instrument.OptimizationRemark;
import accela.pass.ir.FunctionAnalysisManager;
import accela.pass.ir.analysis.DominatorTreeAnalysis;
import accela.pass.ir.analysis.InductionVariableAnalysis;
import accela.pass.ir.analysis.LoopAnalysis;
import accela.pass.ir.instrument.PassInstrumentation;
import accela.pass.ir.verify.IRVerifier;
import java.util.ArrayList;
import java.util.List;
import org.junit.jupiter.api.Test;

final class SameDomainLoopFusionTest {
  @Test
  void descriptorMatchesTheFrozenScreeningContract() {
    PassDescriptor descriptor = SameDomainLoopFusionCandidate.descriptor();

    assertEquals(SameDomainLoopFusionCandidate.ID, descriptor.id());
    assertEquals(SameDomainLoopFusionCandidate.ID, descriptor.logicalFamilyId());
    assertEquals(1, descriptor.fullPipelineOccurrences());
    assertTrue(descriptor.candidate());
    assertTrue(descriptor.decisionObservable());
    assertFalse(descriptor.defaultEnabled());
    assertEquals("ir.indvar-domain-simplify", descriptor.candidateAnchor().passId());
    assertEquals(1, descriptor.candidateAnchor().occurrence());
    assertEquals(
        SameDomainLoopFusionCandidate.LEGALITY_OBLIGATION_IDS,
        descriptor.legalityObligationIds());
  }

  @Test
  void fusesAndContractsOneSameIterationTemporary() {
    Fixture fixture = Fixture.singleTemporary();
    IRVerifier.verifyFunction(fixture.function);

    assertTrue(SameDomainLoopFusion.run(fixture.function, analysisManager()));
    IRVerifier.verifyFunction(fixture.function);
    assertEquals(1, loopCount(fixture.function));
    assertEquals(0, accessesTo(fixture.module, fixture.firstTemporary, Instruction.Opcode.LOAD));
    assertEquals(0, accessesTo(fixture.module, fixture.firstTemporary, Instruction.Opcode.STORE));
  }

  @Test
  void repeatedlyFusesTwoTemporaryChainAfterLifetimeBecomesLocal() {
    Fixture fixture = Fixture.twoTemporaries();

    assertTrue(SameDomainLoopFusion.run(fixture.function, analysisManager()));
    IRVerifier.verifyFunction(fixture.function);
    assertEquals(1, loopCount(fixture.function));
    assertEquals(0, accessesTo(fixture.module, fixture.firstTemporary, Instruction.Opcode.LOAD));
    assertEquals(0, accessesTo(fixture.module, fixture.firstTemporary, Instruction.Opcode.STORE));
    assertEquals(0, accessesTo(fixture.module, fixture.secondTemporary, Instruction.Opcode.LOAD));
    assertEquals(0, accessesTo(fixture.module, fixture.secondTemporary, Instruction.Opcode.STORE));
  }

  @Test
  void repeatedlyFusesFourIndependentIntegerRecurrences() {
    Fixture fixture = Fixture.independentRecurrences(4);

    assertTrue(SameDomainLoopFusion.run(fixture.function, analysisManager()));
    IRVerifier.verifyFunction(fixture.function);
    assertEquals(1, loopCount(fixture.function));
    assertEquals(5, fixture.function.getBlocks().stream()
        .filter(block -> block.getLabel().startsWith("loop0.header"))
        .findFirst().orElseThrow().getInstructions().stream()
        .takeWhile(instruction -> instruction.getOpcode() == Instruction.Opcode.PHI)
        .count());
  }

  @Test
  void reportsAppliedDecisionAndInvalidatesEveryCfgAnalysis() {
    Fixture fixture = Fixture.singleTemporary();
    List<OptimizationRemark> remarks = new ArrayList<>();
    PreservedAnalyses preserved;
    try (PassInstrumentation instrumentation =
        PassInstrumentation.observed(false, remarks::add)) {
      preserved = new SameDomainLoopFusion.Pass(
          instrumentation, SameDomainLoopFusionCandidate.descriptor(), 1)
          .run(fixture.function, analysisManager());
    }

    assertTrue(preserved.preservesNone());
    assertTrue(remarks.stream().map(DecisionRemark.class::cast)
        .anyMatch(remark -> remark.decision() == DecisionStatus.APPLIED));
    assertPairedDecisions(remarks);
  }

  @Test
  void rejectsFirstRecurrenceFinalValueUsedInsideSecondLoopAndReportsObligation() {
    Fixture fixture = Fixture.independentRecurrences(2);
    IRBuilder builder = new IRBuilder();
    builder.setInsertPointBefore(fixture.bodies.get(1).getTerminator());
    builder.createStore(
        fixture.states.getFirst(),
        fixture.address(builder, fixture.output, fixture.inductions.get(1)));

    SameDomainLoopFusionMatcher.MatchResult matched = matchFirstPair(fixture);
    assertEquals(SameDomainLoopFusionCandidate.EXIT_LIVE_OUTS, matched.rejectedObligationId());

    List<OptimizationRemark> remarks = new ArrayList<>();
    PreservedAnalyses preserved;
    try (PassInstrumentation instrumentation =
        PassInstrumentation.observed(false, remarks::add)) {
      preserved = new SameDomainLoopFusion.Pass(
          instrumentation, SameDomainLoopFusionCandidate.descriptor(), 1)
          .run(fixture.function, analysisManager());
    }

    assertTrue(preserved.preservesAll());
    DecisionRemark rejection = remarks.stream()
        .map(DecisionRemark.class::cast)
        .filter(remark -> remark.decision() == DecisionStatus.REJECTED)
        .findFirst()
        .orElseThrow();
    assertEquals(SameDomainLoopFusionCandidate.EXIT_LIVE_OUTS,
        rejection.legalityObligationId());
    assertPairedDecisions(remarks);
  }

  @Test
  void rejectsFirstInductionFinalValueUsedInsideSecondLoop() {
    Fixture fixture = Fixture.singleTemporary();
    IRBuilder builder = new IRBuilder();
    builder.setInsertPointBefore(fixture.bodies.get(1).getTerminator());
    builder.createStore(
        fixture.inductions.getFirst(),
        fixture.address(builder, fixture.secondTemporary, fixture.inductions.get(1)));

    assertRejected(fixture, SameDomainLoopFusionCandidate.EXIT_LIVE_OUTS);
  }

  @Test
  void requiresTheExactDescriptorAndSingleOccurrence() {
    try (PassInstrumentation instrumentation = PassInstrumentation.enabled(false)) {
      PassDescriptor expected = SameDomainLoopFusionCandidate.descriptor();
      PassDescriptor altered = new PassDescriptor(
          expected.id(), expected.logicalFamilyId(), expected.displayName() + " altered",
          expected.stage(), expected.fullPipelineOccurrences(), expected.lifecycle(),
          expected.decisionObservable(), expected.candidateAnchor(),
          expected.legalityObligationIds());
      assertThrows(IllegalArgumentException.class,
          () -> new SameDomainLoopFusion.Pass(instrumentation, altered, 1));
      assertThrows(IllegalArgumentException.class,
          () -> new SameDomainLoopFusion.Pass(instrumentation, expected, 2));
    }
  }

  @Test
  void rejectsEveryFrozenLegalityBoundaryWithItsExactObligation() {
    Fixture nonCanonical = Fixture.singleTemporary();
    nonCanonical.bodies.get(1).addInstructionToFront(Instruction.createPhi(Type.INT));
    assertRejected(nonCanonical, SameDomainLoopFusionCandidate.ADJACENT_CANONICAL_LOOPS);

    Fixture differentDomain = Fixture.singleTemporary();
    differentDomain.compares.get(1).setOperand(1, Constant.intConst(31));
    assertRejected(differentDomain, SameDomainLoopFusionCandidate.IDENTICAL_ITERATION_DOMAIN);

    Fixture futureProducer = Fixture.singleTemporary();
    Instruction consumerLoad = futureProducer.bodies.get(1).getInstructions().stream()
        .filter(instruction -> instruction.getOpcode() == Instruction.Opcode.LOAD)
        .findFirst().orElseThrow();
    Instruction consumerAddress = (Instruction) consumerLoad.getOperand(0);
    IRBuilder futureAddressBuilder = new IRBuilder();
    futureAddressBuilder.setInsertPointBefore(consumerAddress);
    Value futureIndex = futureAddressBuilder.createAdd(
        futureProducer.inductions.get(1), Constant.intConst(1));
    consumerAddress.setOperand(2, futureIndex);
    assertRejected(futureProducer, SameDomainLoopFusionCandidate.DEPENDENCE_ORDER);

    Fixture unknownAlias = Fixture.singleTemporary();
    Value unknownRoot = unknownAlias.function.addArgument(Type.PTR, "unknown");
    Instruction aliasLoad = unknownAlias.bodies.get(1).getInstructions().stream()
        .filter(instruction -> instruction.getOpcode() == Instruction.Opcode.LOAD)
        .findFirst().orElseThrow();
    ((Instruction) aliasLoad.getOperand(0)).setOperand(0, unknownRoot);
    assertRejected(unknownAlias, SameDomainLoopFusionCandidate.ALIAS_MODREF);

    Fixture sideEffect = Fixture.singleTemporary();
    IRBuilder sideEffectBuilder = new IRBuilder();
    sideEffectBuilder.setInsertPointBefore(sideEffect.bodies.get(0).getTerminator());
    sideEffectBuilder.createCall(new Function("opaque", Type.INT), Type.INT);
    assertRejected(sideEffect, SameDomainLoopFusionCandidate.SIDE_EFFECT_ORDER);

    Fixture floating = Fixture.singleTemporary();
    IRBuilder floatingBuilder = new IRBuilder();
    floatingBuilder.setInsertPointBefore(floating.bodies.get(0).getTerminator());
    floatingBuilder.createFAdd(
        Constant.floatConst(1.0f), Constant.floatConst(2.0f));
    assertRejected(floating, SameDomainLoopFusionCandidate.SIDE_EFFECT_ORDER);

    Fixture liveTemporary = Fixture.singleTemporary();
    IRBuilder exitLoadBuilder = new IRBuilder();
    exitLoadBuilder.setInsertPointBefore(liveTemporary.exit.getTerminator());
    exitLoadBuilder.createLoad(
        Type.INT,
        liveTemporary.address(
            exitLoadBuilder, liveTemporary.firstTemporary, Constant.intConst(0)));
    assertRejected(liveTemporary, SameDomainLoopFusionCandidate.TEMPORARY_LIFETIME);

    Fixture overwrittenTemporary = Fixture.singleTemporary();
    Instruction overwrittenLoad = overwrittenTemporary.bodies.get(1).getInstructions().stream()
        .filter(instruction -> instruction.getOpcode() == Instruction.Opcode.LOAD)
        .findFirst().orElseThrow();
    IRBuilder overwriteBuilder = new IRBuilder();
    overwriteBuilder.setInsertPointBefore(overwrittenLoad);
    overwriteBuilder.createStore(Constant.intConst(7), overwrittenLoad.getOperand(0));
    assertRejected(overwrittenTemporary, SameDomainLoopFusionCandidate.TEMPORARY_LIFETIME);

    Fixture escaping = Fixture.singleTemporary();
    Instruction escapingValue = escaping.bodies.get(1).getInstructions().stream()
        .filter(instruction -> instruction.getOpcode() == Instruction.Opcode.MUL)
        .findFirst().orElseThrow();
    escaping.exit.getTerminator().setOperand(0, escapingValue);
    assertRejected(escaping, SameDomainLoopFusionCandidate.EXIT_LIVE_OUTS);

    Fixture expensive = Fixture.singleTemporary();
    IRBuilder expensiveBuilder = new IRBuilder();
    expensiveBuilder.setInsertPointBefore(expensive.bodies.get(0).getTerminator());
    for (int index = 0;
        index < SameDomainLoopFusionProfitability.MAX_FUSED_PAYLOAD_INSTRUCTIONS + 1;
        index++) {
      expensiveBuilder.createAdd(expensive.inductions.get(0), Constant.intConst(index));
    }
    SameDomainLoopFusionMatcher.MatchResult expensiveMatch = matchFirstPair(expensive);
    assertTrue(expensiveMatch.candidate() != null);
    assertEquals(
        SameDomainLoopFusionCandidate.PROFITABILITY,
        SameDomainLoopFusionProfitability.evaluate(expensiveMatch.candidate())
            .rejectedObligationId());
  }

  private static void assertRejected(Fixture fixture, String obligation) {
    SameDomainLoopFusionMatcher.MatchResult result = matchFirstPair(fixture);
    assertEquals(obligation, result.rejectedObligationId());
    assertFalse(SameDomainLoopFusion.run(fixture.function, analysisManager()));
  }

  private static SameDomainLoopFusionMatcher.MatchResult matchFirstPair(Fixture fixture) {
    FunctionAnalysisManager analyses = analysisManager();
    SameDomainLoopFusionMatcher.AdjacentPair pair =
        SameDomainLoopFusionMatcher.findAdjacentPairs(fixture.function, analyses).getFirst();
    return SameDomainLoopFusionMatcher.match(
        fixture.function,
        pair,
        analyses.getResult(InductionVariableAnalysis.class, fixture.function));
  }

  private static void assertPairedDecisions(List<OptimizationRemark> remarks) {
    List<DecisionStatus> decisions = remarks.stream()
        .map(DecisionRemark.class::cast)
        .map(DecisionRemark::decision)
        .toList();
    int candidates = 0;
    int terminals = 0;
    for (DecisionStatus decision : decisions) {
      if (decision == DecisionStatus.CANDIDATE) candidates++;
      else terminals++;
    }
    assertEquals(candidates, terminals);
  }

  private static int loopCount(Function function) {
    return analysisManager().getResult(LoopAnalysis.class, function).loops().size();
  }

  private static long accessesTo(
      accela.ir.Module module, GlobalVariable global, Instruction.Opcode opcode) {
    return module.getFunctions().stream()
        .flatMap(function -> function.getBlocks().stream())
        .flatMap(block -> block.getInstructions().stream())
        .filter(instruction -> instruction.getOpcode() == opcode)
        .filter(instruction -> {
          Value pointer = opcode == Instruction.Opcode.LOAD
              ? instruction.getOperand(0) : instruction.getOperand(1);
          return accela.pass.ir.analysis.alias.PointerProvenance.root(pointer) == global;
        })
        .count();
  }

  private static FunctionAnalysisManager analysisManager() {
    FunctionAnalysisManager analyses = new FunctionAnalysisManager();
    analyses.registerPass(DominatorTreeAnalysis.class, new DominatorTreeAnalysis());
    analyses.registerPass(LoopAnalysis.class, new LoopAnalysis());
    analyses.registerPass(InductionVariableAnalysis.class, new InductionVariableAnalysis());
    return analyses;
  }

  private static final class Fixture {
    private static final Type ARRAY = Type.array(Type.INT, 128);

    final accela.ir.Module module = new accela.ir.Module();
    final GlobalVariable input = global("input");
    final GlobalVariable firstTemporary = global("tmp1");
    final GlobalVariable secondTemporary = global("tmp2");
    final GlobalVariable output = global("output");
    final Function function = new Function("fusion_kernel", Type.INT);
    final Value bound = function.addArgument(Type.INT, "bound");
    final BasicBlock entry = function.addBlock("entry");
    final List<BasicBlock> headers = new ArrayList<>();
    final List<BasicBlock> bodies = new ArrayList<>();
    final List<Instruction> inductions = new ArrayList<>();
    final List<Instruction> compares = new ArrayList<>();
    final List<Instruction> states = new ArrayList<>();
    final BasicBlock exit;

    private Fixture(int loopCount, PayloadFactory payloadFactory) {
      module.addGlobal(input);
      module.addGlobal(firstTemporary);
      module.addGlobal(secondTemporary);
      module.addGlobal(output);
      module.addFunction(function);
      for (int index = 0; index < loopCount; index++) {
        headers.add(function.addBlock("loop" + index + ".header"));
        bodies.add(function.addBlock("loop" + index + ".body"));
      }
      exit = function.addBlock("exit");
      new IRBuilder(entry).createBr(headers.getFirst());
      for (int index = 0; index < loopCount; index++) {
        BasicBlock predecessor = index == 0 ? entry : headers.get(index - 1);
        BasicBlock next = index + 1 == loopCount ? exit : headers.get(index + 1);
        IRBuilder headerBuilder = new IRBuilder(headers.get(index));
        Instruction induction = headerBuilder.createPhi(Type.INT);
        Instruction state = payloadFactory.hasState(index)
            ? headerBuilder.createPhi(Type.INT) : null;
        Instruction compare = headerBuilder.createICmp("slt", induction, bound);
        headerBuilder.createCondBr(compare, bodies.get(index), next);
        inductions.add(induction);
        compares.add(compare);
        IRBuilder bodyBuilder = new IRBuilder(bodies.get(index));
        Value nextState = payloadFactory.build(this, index, bodyBuilder, induction, state);
        Instruction nextInduction = bodyBuilder.createAdd(induction, Constant.intConst(1));
        bodyBuilder.createBr(headers.get(index));
        induction.addOperand(Constant.intConst(0));
        induction.addOperand(predecessor);
        induction.addOperand(nextInduction);
        induction.addOperand(bodies.get(index));
        if (state != null) {
          state.addOperand(Constant.intConst(index + 1));
          state.addOperand(predecessor);
          state.addOperand(nextState);
          state.addOperand(bodies.get(index));
          states.add(state);
        }
      }
      Value result = Constant.intConst(0);
      IRBuilder exitBuilder = new IRBuilder(exit);
      for (Instruction state : states) result = exitBuilder.createAdd(result, state);
      exitBuilder.createRet(result);
    }

    static Fixture singleTemporary() {
      return new Fixture(2, new PayloadFactory() {
        @Override
        public Value build(
            Fixture fixture, int index, IRBuilder builder, Instruction induction,
            Instruction state) {
          if (index == 0) {
            builder.createStore(
                builder.createAdd(
                    builder.createMul(induction, Constant.intConst(3)), Constant.intConst(1)),
                fixture.address(builder, fixture.firstTemporary, induction));
          } else {
            Value loaded = builder.createLoad(
                Type.INT, fixture.address(builder, fixture.firstTemporary, induction));
            builder.createStore(
                builder.createMul(loaded, Constant.intConst(5)),
                fixture.address(builder, fixture.output, induction));
          }
          return null;
        }
      });
    }

    static Fixture twoTemporaries() {
      return new Fixture(3, new PayloadFactory() {
        @Override
        public Value build(
            Fixture fixture, int index, IRBuilder builder, Instruction induction,
            Instruction state) {
          if (index == 0) {
            builder.createStore(
                builder.createMul(induction, Constant.intConst(5)),
                fixture.address(builder, fixture.firstTemporary, induction));
          } else if (index == 1) {
            Value first = builder.createLoad(
                Type.INT, fixture.address(builder, fixture.firstTemporary, induction));
            builder.createStore(
                builder.createAdd(first, induction),
                fixture.address(builder, fixture.secondTemporary, induction));
          } else {
            Value first = builder.createLoad(
                Type.INT, fixture.address(builder, fixture.firstTemporary, induction));
            Value second = builder.createLoad(
                Type.INT, fixture.address(builder, fixture.secondTemporary, induction));
            builder.createStore(
                builder.createAdd(first, second),
                fixture.address(builder, fixture.output, induction));
          }
          return null;
        }
      });
    }

    static Fixture independentRecurrences(int loops) {
      return new Fixture(loops, new PayloadFactory() {
        @Override
        public boolean hasState(int index) {
          return true;
        }

        @Override
        public Value build(
            Fixture fixture, int index, IRBuilder builder, Instruction induction,
            Instruction state) {
          Value loaded = builder.createLoad(
              Type.INT, fixture.address(builder, fixture.input, induction));
          return builder.createAdd(
              builder.createMul(state, Constant.intConst(index * 2L + 3)), loaded);
        }
      });
    }

    Instruction address(IRBuilder builder, GlobalVariable global, Value index) {
      return builder.createGEP(
          ARRAY, global, new Value[] {Constant.int64Const(0), index}, true);
    }

    private static GlobalVariable global(String name) {
      return new GlobalVariable(name, ARRAY, Constant.zero(ARRAY), false);
    }
  }

  private interface PayloadFactory {
    default boolean hasState(int index) {
      return false;
    }

    Value build(
        Fixture fixture,
        int index,
        IRBuilder builder,
        Instruction induction,
        Instruction state);
  }
}
