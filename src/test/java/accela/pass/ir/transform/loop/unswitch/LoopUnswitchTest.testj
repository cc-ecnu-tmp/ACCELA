package accela.pass.ir.transform.loop.unswitch;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.Function;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Type;
import accela.ir.Value;
import accela.pass.ir.FunctionAnalysisManager;
import accela.pass.ir.analysis.DominatorTreeAnalysis;
import accela.pass.ir.analysis.LoopAnalysis;
import accela.pass.ir.verify.IRVerifier;
import org.junit.jupiter.api.Test;

final class LoopUnswitchTest {
  @Test
  void specializesBothInvariantBranchesAndMergesLiveOuts() {
    Function function = new Function("unswitch", Type.INT);
    Value flag = function.addArgument(Type.I1, "flag");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock body = function.addBlock("body");
    BasicBlock onTrue = function.addBlock("on.true");
    BasicBlock onFalse = function.addBlock("on.false");
    BasicBlock latch = function.addBlock("latch");
    BasicBlock exit = function.addBlock("exit");
    new IRBuilder(entry).createBr(header);

    IRBuilder headerBuilder = new IRBuilder(header);
    Instruction index = headerBuilder.createPhi(Type.INT);
    Instruction sum = headerBuilder.createPhi(Type.INT);
    headerBuilder.createCondBr(
        headerBuilder.createICmp("slt", index, Constant.intConst(4)), body, exit);
    new IRBuilder(body).createCondBr(flag, onTrue, onFalse);
    IRBuilder trueBuilder = new IRBuilder(onTrue);
    Instruction trueSum = trueBuilder.createAdd(sum, Constant.intConst(1));
    trueBuilder.createBr(latch);
    IRBuilder falseBuilder = new IRBuilder(onFalse);
    Instruction falseSum = falseBuilder.createAdd(sum, Constant.intConst(2));
    falseBuilder.createBr(latch);
    IRBuilder latchBuilder = new IRBuilder(latch);
    Instruction nextSum = latchBuilder.createPhi(Type.INT);
    Instruction nextIndex = latchBuilder.createAdd(index, Constant.intConst(1));
    latchBuilder.createBr(header);
    nextSum.addOperand(trueSum);
    nextSum.addOperand(onTrue);
    nextSum.addOperand(falseSum);
    nextSum.addOperand(onFalse);
    index.addOperand(Constant.intConst(0));
    index.addOperand(entry);
    index.addOperand(nextIndex);
    index.addOperand(latch);
    sum.addOperand(Constant.intConst(0));
    sum.addOperand(entry);
    sum.addOperand(nextSum);
    sum.addOperand(latch);

    Instruction liveOut = Instruction.createPhi(Type.INT);
    exit.addInstructionToFront(liveOut);
    liveOut.addOperand(sum);
    liveOut.addOperand(header);
    new IRBuilder(exit).createRet(liveOut);

    assertTrue(LoopUnswitch.run(function, analysisManager()));
    IRVerifier.verifyFunction(function);
    assertEquals(Instruction.Opcode.CONDBR, entry.getTerminator().getOpcode());
    assertEquals(flag, entry.getTerminator().getOperand(0));
    assertEquals(2, liveOut.getNumOperands() / 2);
    assertTrue(function.getBlocks().stream()
        .filter(block -> block.getLabel().startsWith("body"))
        .allMatch(block -> block.getTerminator().getOpcode() == Instruction.Opcode.BR));
  }

  private static FunctionAnalysisManager analysisManager() {
    FunctionAnalysisManager fam = new FunctionAnalysisManager();
    fam.registerPass(DominatorTreeAnalysis.class, new DominatorTreeAnalysis());
    fam.registerPass(LoopAnalysis.class, new LoopAnalysis());
    return fam;
  }
}
