package accela.pass.ir.transform;

import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertSame;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.Function;
import accela.ir.GlobalVariable;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Module;
import accela.ir.Type;
import accela.ir.Value;
import accela.pass.ir.FunctionAnalysisManager;
import accela.pass.ir.analysis.DominatorTreeAnalysis;
import accela.pass.ir.analysis.LoopAnalysis;
import accela.pass.ir.verify.IRVerifier;
import org.junit.jupiter.api.Test;

final class LICMTest {
  @Test
  void hoistsScalarLoadPastUnrelatedGlobalStore() {
    Module module = new Module();
    GlobalVariable limit = scalar(module, "limit");
    GlobalVariable output = scalar(module, "output");
    Function function = loopFunction(module, "read_limit");
    BasicBlock entry = function.getBlocks().get(0);
    BasicBlock header = function.getBlocks().get(1);
    BasicBlock body = function.getBlocks().get(2);
    IRBuilder headerBuilder = new IRBuilder();
    headerBuilder.setInsertPointBefore(header.getTerminator());
    Instruction load = headerBuilder.createLoad(Type.INT, limit);
    IRBuilder bodyBuilder = new IRBuilder();
    bodyBuilder.setInsertPointBefore(body.getTerminator());
    Instruction invariant = bodyBuilder.createAdd(load, Constant.intConst(1));
    bodyBuilder.createStore(invariant, output);

    assertTrue(LICM.runOnFunction(function, analysisManager()));
    IRVerifier.verifyFunction(function);
    assertSame(entry, load.getParent());
    assertSame(entry, invariant.getParent());
  }

  @Test
  void hoistsGuaranteedArrayElementLoad() {
    Module module = new Module();
    Type arrayType = Type.array(Type.INT, 4);
    GlobalVariable input =
        new GlobalVariable("input", arrayType, Constant.zero(arrayType), false);
    GlobalVariable output =
        new GlobalVariable("output", arrayType, Constant.zero(arrayType), false);
    module.addGlobal(input);
    module.addGlobal(output);
    Function function = loopFunction(module, "read_array");
    BasicBlock entry = function.getBlocks().get(0);
    BasicBlock header = function.getBlocks().get(1);
    BasicBlock body = function.getBlocks().get(2);

    IRBuilder headerBuilder = new IRBuilder();
    headerBuilder.setInsertPointBefore(header.getTerminator());
    Instruction address = headerBuilder.createGEP(
        arrayType,
        input,
        new Value[] {Constant.int64Const(0), Constant.int64Const(1)},
        true);
    Instruction load = headerBuilder.createLoad(Type.INT, address);
    IRBuilder bodyBuilder = new IRBuilder();
    bodyBuilder.setInsertPointBefore(body.getTerminator());
    Instruction destination = bodyBuilder.createGEP(
        arrayType,
        output,
        new Value[] {Constant.int64Const(0), Constant.int64Const(1)},
        true);
    bodyBuilder.createStore(load, destination);

    assertTrue(LICM.runOnFunction(function, analysisManager()));
    IRVerifier.verifyFunction(function);
    assertSame(entry, address.getParent());
    assertSame(entry, load.getParent());
  }

  @Test
  void promotesLoopLocalScalarLoadsAndStores() {
    Module module = new Module();
    GlobalVariable state = scalar(module, "state");
    Function function = loopFunction(module, "mutate");
    BasicBlock entry = function.getBlocks().get(0);
    BasicBlock header = function.getBlocks().get(1);
    BasicBlock body = function.getBlocks().get(2);
    IRBuilder headerBuilder = new IRBuilder();
    headerBuilder.setInsertPointBefore(header.getTerminator());
    Instruction load = headerBuilder.createLoad(Type.INT, state);
    IRBuilder bodyBuilder = new IRBuilder();
    bodyBuilder.setInsertPointBefore(body.getTerminator());
    bodyBuilder.createStore(load, state);

    assertTrue(LICM.runOnFunction(function, analysisManager()));
    IRVerifier.verifyFunction(function);
    assertTrue(hasAccess(entry, state, Instruction.Opcode.LOAD));
    assertTrue(hasPromotionWriteback(function, state));
    assertFalse(hasAccess(header, state, Instruction.Opcode.LOAD));
    assertFalse(hasAccess(body, state, Instruction.Opcode.STORE));
  }

  @Test
  void promotionAllocatesUniqueExitLabelsAcrossRepeatedOpportunities() {
    Module module = new Module();
    GlobalVariable state = scalar(module, "unique_exit_state");
    Function function = loopFunction(module, "unique_exit");
    BasicBlock header = function.getBlocks().get(1);
    BasicBlock body = function.getBlocks().get(2);
    BasicBlock existing = function.addBlock("header.promote.exit.0");
    new IRBuilder(existing).createRetVoid();
    IRBuilder headerBuilder = new IRBuilder();
    headerBuilder.setInsertPointBefore(header.getTerminator());
    Instruction loaded = headerBuilder.createLoad(Type.INT, state);
    IRBuilder bodyBuilder = new IRBuilder();
    bodyBuilder.setInsertPointBefore(body.getTerminator());
    bodyBuilder.createStore(loaded, state);

    assertTrue(LICM.runOnFunction(function, analysisManager()));
    IRVerifier.verifyFunction(function);
    assertTrue(function.getBlocks().stream()
        .anyMatch(block -> block.getLabel().equals("header.promote.exit.0.1")));
  }

  @Test
  void promotesOuterIndexedElementAcrossInnerReductionLoop() {
    NestedPromotionFixture fixture = new NestedPromotionFixture(false);

    assertTrue(LICM.runOnFunction(fixture.function, analysisManager()));
    IRVerifier.verifyFunction(fixture.function);

    assertFalse(hasAccess(fixture.innerHeader, fixture.pointer, Instruction.Opcode.LOAD));
    assertFalse(hasAccess(fixture.innerBody, fixture.pointer, Instruction.Opcode.STORE));
    assertTrue(hasAccess(fixture.outerHeader, fixture.pointer, Instruction.Opcode.LOAD));
    assertTrue(hasPromotionWriteback(fixture.function, fixture.pointer));
  }

  @Test
  void rejectsPromotionWhenAnotherArrayAccessMayAlias() {
    NestedPromotionFixture fixture = new NestedPromotionFixture(true);

    LICM.runOnFunction(fixture.function, analysisManager());
    IRVerifier.verifyFunction(fixture.function);

    assertTrue(hasAccess(fixture.innerHeader, fixture.pointer, Instruction.Opcode.LOAD));
    assertTrue(hasAccess(fixture.innerBody, fixture.pointer, Instruction.Opcode.STORE));
  }

  @Test
  void rejectsPromotionThatWouldSpeculativelyLoadAnArgument() {
    Module module = new Module();
    Function function = loopFunction(module, "guarded_pointer");
    Value pointer = function.addArgument(Type.PTR, "pointer");
    BasicBlock header = function.getBlocks().get(1);
    BasicBlock body = function.getBlocks().get(2);
    IRBuilder headerBuilder = new IRBuilder();
    headerBuilder.setInsertPointBefore(header.getTerminator());
    Instruction loaded = headerBuilder.createLoad(Type.INT, pointer);
    IRBuilder bodyBuilder = new IRBuilder();
    bodyBuilder.setInsertPointBefore(body.getTerminator());
    bodyBuilder.createStore(loaded, pointer);

    LICM.runOnFunction(function, analysisManager());
    IRVerifier.verifyFunction(function);

    assertTrue(hasAccess(header, pointer, Instruction.Opcode.LOAD));
    assertTrue(hasAccess(body, pointer, Instruction.Opcode.STORE));
  }

  @Test
  void splitsEveryPromotionExitAndRepairsExitPhi() {
    Module module = new Module();
    GlobalVariable state = scalar(module, "multi_exit_state");
    Function function = new Function("multi_exit_promotion", Type.VOID);
    Value enter = function.addArgument(Type.I1, "enter");
    Value early = function.addArgument(Type.I1, "early");
    module.addGlobal(state);
    module.addFunction(function);
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock body = function.addBlock("body");
    BasicBlock latch = function.addBlock("latch");
    BasicBlock exit = function.addBlock("exit");

    new IRBuilder(entry).createBr(header);
    new IRBuilder(header).createCondBr(enter, body, exit);
    IRBuilder bodyBuilder = new IRBuilder(body);
    Instruction loaded = bodyBuilder.createLoad(Type.INT, state);
    bodyBuilder.createStore(bodyBuilder.createAdd(loaded, Constant.intConst(1)), state);
    bodyBuilder.createCondBr(early, exit, latch);
    new IRBuilder(latch).createBr(header);
    Instruction result = Instruction.createPhi(Type.INT);
    result.addOperand(Constant.intConst(0));
    result.addOperand(header);
    result.addOperand(Constant.intConst(1));
    result.addOperand(body);
    exit.addInstructionToFront(result);
    new IRBuilder(exit).createRetVoid();

    assertTrue(LICM.runOnFunction(function, analysisManager()));
    IRVerifier.verifyFunction(function);

    long writebacks = function.getBlocks().stream()
        .filter(block -> block.getLabel().contains(".promote.exit."))
        .count();
    assertTrue(writebacks == 2);
    assertTrue(function.getBlocks().stream().filter(
        block -> block.getLabel().contains(".promote.exit."))
        .allMatch(block -> hasAccess(block, state, Instruction.Opcode.STORE)));
    assertFalse(phiHasPredecessor(result, header));
    assertFalse(phiHasPredecessor(result, body));
    assertTrue(header.getSuccessors().stream()
        .anyMatch(block -> block.getLabel().equals("header.promote.exit.0")));
    assertTrue(body.getSuccessors().stream()
        .anyMatch(block -> block.getLabel().equals("header.promote.exit.1")));
  }

  @Test
  void usesTransitiveModRefToRejectUnsafeLoads() {
    Module module = new Module();
    GlobalVariable state = scalar(module, "state");
    Function writer = new Function("writer", Type.VOID);
    module.addFunction(writer);
    IRBuilder writerBuilder = new IRBuilder(writer.addBlock("entry"));
    writerBuilder.createStore(Constant.intConst(1), state);
    writerBuilder.createRetVoid();

    Function function = loopFunction(module, "call_writer");
    BasicBlock header = function.getBlocks().get(1);
    BasicBlock body = function.getBlocks().get(2);
    IRBuilder headerBuilder = new IRBuilder();
    headerBuilder.setInsertPointBefore(header.getTerminator());
    Instruction load = headerBuilder.createLoad(Type.INT, state);
    IRBuilder bodyBuilder = new IRBuilder();
    bodyBuilder.setInsertPointBefore(body.getTerminator());
    bodyBuilder.createCall(writer, Type.VOID);

    assertFalse(LICM.runOnFunction(function, analysisManager()));
    assertSame(header, load.getParent());
  }

  @Test
  void keepsStoresVisibleToCallsThatReadTheObject() {
    Module module = new Module();
    GlobalVariable state = scalar(module, "state");
    Function reader = new Function("reader", Type.INT);
    module.addFunction(reader);
    IRBuilder readerBuilder = new IRBuilder(reader.addBlock("entry"));
    readerBuilder.createRet(readerBuilder.createLoad(Type.INT, state));

    Function function = loopFunction(module, "call_reader");
    BasicBlock body = function.getBlocks().get(2);
    IRBuilder builder = new IRBuilder();
    builder.setInsertPointBefore(body.getTerminator());
    builder.createStore(Constant.intConst(1), state);
    builder.createCall(reader, Type.INT);
    builder.createLoad(Type.INT, state);

    assertFalse(LICM.runOnFunction(function, analysisManager()));
    assertTrue(hasAccess(body, state, Instruction.Opcode.STORE));
  }

  @Test
  void hoistsPureCallsFromLoopHeaders() {
    Module module = new Module();
    Function pure = new Function("pure", Type.INT);
    module.addFunction(pure);
    Value argument = pure.addArgument(Type.INT, "argument");
    new IRBuilder(pure.addBlock("entry")).createRet(argument);

    Function function = loopFunction(module, "caller");
    BasicBlock entry = function.getBlocks().get(0);
    BasicBlock header = function.getBlocks().get(1);
    BasicBlock body = function.getBlocks().get(2);
    IRBuilder builder = new IRBuilder();
    builder.setInsertPointBefore(header.getTerminator());
    Instruction call = builder.createCall(pure, Type.INT, Constant.intConst(1));
    builder.setInsertPointBefore(body.getTerminator());
    Instruction conditional = builder.createCall(pure, Type.INT, Constant.intConst(2));

    assertTrue(LICM.runOnFunction(function, analysisManager()));
    assertSame(entry, call.getParent());
    assertSame(body, conditional.getParent());
  }

  @Test
  void speculatesSafeAddressesIntoParentLoop() {
    Module module = new Module();
    Function function = new Function("nested", Type.VOID);
    Value outerCondition = function.addArgument(Type.I1, "outer");
    Value innerCondition = function.addArgument(Type.I1, "inner");
    Value base = function.addArgument(Type.PTR, "base");
    module.addFunction(function);
    BasicBlock entry = function.addBlock("entry");
    BasicBlock outer = function.addBlock("outer");
    BasicBlock inner = function.addBlock("inner");
    BasicBlock body = function.addBlock("body");
    BasicBlock latch = function.addBlock("latch");
    BasicBlock exit = function.addBlock("exit");
    new IRBuilder(entry).createBr(outer);

    IRBuilder outerBuilder = new IRBuilder(outer);
    Instruction index = outerBuilder.createPhi(Type.INT);
    index.addOperand(Constant.intConst(0));
    index.addOperand(entry);
    outerBuilder.createCondBr(outerCondition, inner, exit);

    IRBuilder innerBuilder = new IRBuilder(inner);
    Instruction extended = innerBuilder.createSExt(index, Type.I64);
    Instruction address =
        innerBuilder.createGEP(Type.INT, base, new Value[] {extended}, false);
    innerBuilder.createCondBr(innerCondition, body, latch);
    new IRBuilder(body).createBr(inner);
    IRBuilder latchBuilder = new IRBuilder(latch);
    Instruction next = latchBuilder.createAdd(index, Constant.intConst(1));
    index.addOperand(next);
    index.addOperand(latch);
    latchBuilder.createBr(outer);
    new IRBuilder(exit).createRetVoid();

    assertTrue(LICM.runOnFunction(function, analysisManager()));
    IRVerifier.verifyFunction(function);
    assertSame(outer, extended.getParent());
    assertSame(outer, address.getParent());
  }

  private static Function loopFunction(Module module, String name) {
    Function function = new Function(name, Type.VOID);
    Value condition = function.addArgument(Type.I1, "condition");
    module.addFunction(function);
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock body = function.addBlock("body");
    BasicBlock exit = function.addBlock("exit");
    new IRBuilder(entry).createBr(header);
    new IRBuilder(header).createCondBr(condition, body, exit);
    new IRBuilder(body).createBr(header);
    new IRBuilder(exit).createRetVoid();
    return function;
  }

  private static GlobalVariable scalar(Module module, String name) {
    GlobalVariable global =
        new GlobalVariable(name, Type.INT, Constant.intConst(0), false);
    module.addGlobal(global);
    return global;
  }

  private static final class NestedPromotionFixture {
    private static final Type ARRAY = Type.array(Type.INT, 8);

    final Module module = new Module();
    final GlobalVariable values =
        new GlobalVariable("values", ARRAY, Constant.zero(ARRAY), false);
    final Function function = new Function("nested_promotion", Type.VOID);
    final BasicBlock entry = function.addBlock("entry");
    final BasicBlock outerHeader = function.addBlock("outer.header");
    final BasicBlock innerHeader = function.addBlock("inner.header");
    final BasicBlock innerBody = function.addBlock("inner.body");
    final BasicBlock outerLatch = function.addBlock("outer.latch");
    final BasicBlock exit = function.addBlock("exit");
    final Instruction pointer;

    NestedPromotionFixture(boolean conflictingAccess) {
      module.addGlobal(values);
      module.addFunction(function);
      new IRBuilder(entry).createBr(outerHeader);

      IRBuilder outerBuilder = new IRBuilder(outerHeader);
      Instruction outer = outerBuilder.createPhi(Type.INT);
      outer.addOperand(Constant.intConst(0));
      outer.addOperand(entry);
      pointer = outerBuilder.createGEP(
          ARRAY, values, new Value[] {Constant.int64Const(0), outer}, true);
      outerBuilder.createBr(innerHeader);

      IRBuilder innerBuilder = new IRBuilder(innerHeader);
      Instruction inner = innerBuilder.createPhi(Type.INT);
      inner.addOperand(Constant.intConst(0));
      inner.addOperand(outerHeader);
      Instruction loaded = innerBuilder.createLoad(Type.INT, pointer);
      innerBuilder.createCondBr(
          innerBuilder.createICmp("slt", inner, Constant.intConst(3)), innerBody, outerLatch);

      IRBuilder bodyBuilder = new IRBuilder(innerBody);
      bodyBuilder.createStore(bodyBuilder.createAdd(loaded, Constant.intConst(1)), pointer);
      if (conflictingAccess) {
        Value other = bodyBuilder.createGEP(
            ARRAY,
            values,
            new Value[] {Constant.int64Const(0), Constant.int64Const(7)},
            true);
        bodyBuilder.createStore(Constant.intConst(0), other);
      }
      Instruction nextInner = bodyBuilder.createAdd(inner, Constant.intConst(1));
      bodyBuilder.createBr(innerHeader);
      inner.addOperand(nextInner);
      inner.addOperand(innerBody);

      IRBuilder latchBuilder = new IRBuilder(outerLatch);
      Instruction nextOuter = latchBuilder.createAdd(outer, Constant.intConst(1));
      latchBuilder.createCondBr(
          latchBuilder.createICmp("slt", nextOuter, Constant.intConst(2)), outerHeader, exit);
      outer.addOperand(nextOuter);
      outer.addOperand(outerLatch);
      new IRBuilder(exit).createRetVoid();
    }
  }

  private static boolean hasAccess(
      BasicBlock block, Value pointer, Instruction.Opcode opcode) {
    int pointerIndex = opcode == Instruction.Opcode.LOAD ? 0 : 1;
    return block.getInstructions().stream().anyMatch(instruction ->
        instruction.getOpcode() == opcode
            && instruction.getOperand(pointerIndex) == pointer);
  }

  private static boolean hasPromotionWriteback(Function function, Value pointer) {
    return function.getBlocks().stream().anyMatch(block ->
        block.getLabel().contains(".promote.exit.")
            && hasAccess(block, pointer, Instruction.Opcode.STORE));
  }

  private static boolean phiHasPredecessor(Instruction phi, BasicBlock predecessor) {
    for (int index = 1; index < phi.getNumOperands(); index += 2) {
      if (phi.getOperand(index) == predecessor) return true;
    }
    return false;
  }

  private static FunctionAnalysisManager analysisManager() {
    FunctionAnalysisManager fam = new FunctionAnalysisManager();
    fam.registerPass(DominatorTreeAnalysis.class, new DominatorTreeAnalysis());
    fam.registerPass(LoopAnalysis.class, new LoopAnalysis());
    return fam;
  }
}
