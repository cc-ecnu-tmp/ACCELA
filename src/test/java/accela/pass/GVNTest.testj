package accela.pass;

import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertSame;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ir.BasicBlock;
import accela.ir.Constant;
import accela.ir.Function;
import accela.ir.GlobalVariable;
import accela.ir.IRBuilder;
import accela.ir.Instruction;
import accela.ir.Module;
import accela.ir.Type;
import accela.ir.Value;
import accela.pass.ir.transform.gvn.GVN;
import java.util.List;
import org.junit.jupiter.api.Test;

final class GVNTest {
  @Test
  void eliminatesPureCallsFromDominatingBlocks() {
    Module module = new Module();
    Function square = new Function("square", Type.INT);
    module.addFunction(square);
    Value value = square.addArgument(Type.INT, "value");
    IRBuilder squareBuilder = new IRBuilder(square.addBlock("entry"));
    squareBuilder.createRet(squareBuilder.createMul(value, value));

    Function function = new Function("f", Type.INT);
    module.addFunction(function);
    Value argument = function.addArgument(Type.INT, "argument");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock body = function.addBlock("body");
    IRBuilder entryBuilder = new IRBuilder(entry);
    Instruction first = entryBuilder.createCall(square, Type.INT, argument);
    entryBuilder.createBr(body);
    IRBuilder bodyBuilder = new IRBuilder(body);
    Instruction duplicate = bodyBuilder.createCall(square, Type.INT, argument);
    Instruction ret = bodyBuilder.createRet(duplicate);

    assertTrue(GVN.runOnFunction(function));
    assertSame(first, ret.getOperand(0));
    assertTrue(duplicate.getParent() == null);
  }

  @Test
  void eliminatesExpressionsFromDominatingBlocks() {
    Function function = new Function("f", Type.INT);
    Value left = function.addArgument(Type.INT, "left");
    Value right = function.addArgument(Type.INT, "right");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock body = function.addBlock("body");
    IRBuilder entryBuilder = new IRBuilder(entry);
    Instruction first = entryBuilder.createMul(left, right);
    entryBuilder.createBr(body);
    IRBuilder bodyBuilder = new IRBuilder(body);
    Instruction duplicate = bodyBuilder.createMul(left, right);
    Instruction secondDuplicate = bodyBuilder.createMul(left, right);
    Instruction ret = bodyBuilder.createRet(secondDuplicate);

    assertTrue(GVN.runOnFunction(function));
    assertSame(first, ret.getOperand(0));
    assertTrue(duplicate.getParent() == null);
    assertTrue(secondDuplicate.getParent() == null);
  }

  @Test
  void eliminatesLoadsAlongAUniqueDominatedPath() {
    Function function = new Function("f", Type.INT);
    BasicBlock entry = function.addBlock("entry");
    BasicBlock body = function.addBlock("body");
    IRBuilder entryBuilder = new IRBuilder(entry);
    Value pointer = entryBuilder.createAlloca(Type.INT);
    Instruction first = entryBuilder.createLoad(Type.INT, pointer);
    entryBuilder.createBr(body);
    IRBuilder bodyBuilder = new IRBuilder(body);
    Instruction duplicate = bodyBuilder.createLoad(Type.INT, pointer);
    Instruction ret = bodyBuilder.createRet(duplicate);

    assertTrue(GVN.runOnFunction(function));
    assertSame(first, ret.getOperand(0));
    assertTrue(duplicate.getParent() == null);
  }

  @Test
  void eliminatesDominatedVectorExpressions() {
    Function function = new Function("vector", Type.INT);
    Value lane = function.addArgument(Type.INT, "lane");
    Type int4 = Type.vector(Type.INT, 4);
    BasicBlock entry = function.addBlock("entry");
    BasicBlock body = function.addBlock("body");
    IRBuilder entryBuilder = new IRBuilder(entry);
    Instruction first = entryBuilder.createSplat(int4, lane);
    entryBuilder.createBr(body);
    IRBuilder bodyBuilder = new IRBuilder(body);
    Instruction duplicate = bodyBuilder.createSplat(int4, lane);
    Instruction extracted = bodyBuilder.createExtractElement(duplicate, Constant.intConst(0));
    bodyBuilder.createRet(extracted);

    assertTrue(GVN.runOnFunction(function));
    assertSame(first, extracted.getOperand(0));
    assertTrue(duplicate.getParent() == null);
  }

  @Test
  void forwardsVectorStoresToLoads() {
    Function function = new Function("vector_store_forwarding", Type.INT);
    Type int2 = Type.vector(Type.INT, 2);
    BasicBlock entry = function.addBlock("entry");
    IRBuilder builder = new IRBuilder(entry);
    Value pointer = builder.createAlloca(int2);
    Constant.Vector stored = Constant.vector(
        int2, List.of(Constant.intConst(4), Constant.intConst(9)));
    builder.createStore(stored, pointer);
    Instruction loaded = builder.createLoad(int2, pointer);
    Instruction extract = builder.createExtractElement(loaded, Constant.intConst(1));
    builder.createRet(extract);

    assertTrue(GVN.runOnFunction(function));
    assertSame(stored, extract.getOperand(0));
    assertTrue(loaded.getParent() == null);
  }

  @Test
  void invalidatesStoredValuesAfterMayAliasWrites() {
    Function function = new Function("store_clobber", Type.INT);
    Value pointer = function.addArgument(Type.PTR, "pointer");
    Value alias = function.addArgument(Type.PTR, "alias");
    IRBuilder builder = new IRBuilder(function.addBlock("entry"));
    builder.createStore(Constant.intConst(1), pointer);
    builder.createStore(Constant.intConst(2), alias);
    Instruction loaded = builder.createLoad(Type.INT, pointer);
    Instruction ret = builder.createRet(loaded);

    assertFalse(GVN.runOnFunction(function));
    assertSame(loaded, ret.getOperand(0));
  }

  @Test
  void preservesVectorLoadsAcrossDisjointGlobalArrayStores() {
    Module module = new Module();
    Type int2 = Type.vector(Type.INT, 2);
    Type arrayType = Type.array(int2, 2);
    GlobalVariable vectors =
        new GlobalVariable("vectors", arrayType, Constant.zero(arrayType), false);
    module.addGlobal(vectors);
    Function function = new Function("disjoint_vector_accesses", Type.INT);
    module.addFunction(function);
    IRBuilder builder = new IRBuilder(function.addBlock("entry"));
    Value firstPointer = builder.createGEP(
        arrayType,
        vectors,
        new Value[] {Constant.int64Const(0), Constant.int64Const(0)},
        true);
    Value secondPointer = builder.createGEP(
        arrayType,
        vectors,
        new Value[] {Constant.int64Const(0), Constant.int64Const(1)},
        true);
    Instruction firstLoad = builder.createLoad(int2, secondPointer);
    builder.createStore(Constant.zero(int2), firstPointer);
    Instruction duplicate = builder.createLoad(int2, secondPointer);
    Instruction extract = builder.createExtractElement(duplicate, Constant.intConst(0));
    builder.createRet(extract);

    assertTrue(GVN.runOnFunction(function));
    assertSame(firstLoad, extract.getOperand(0));
    assertTrue(duplicate.getParent() == null);
  }

  @Test
  void doesNotMergeLoadsWithDifferentTypesAndWidthsAtTheSameAddress() {
    Function function = new Function("typed_memory", Type.INT);
    BasicBlock entry = function.addBlock("entry");
    BasicBlock body = function.addBlock("body");
    IRBuilder entryBuilder = new IRBuilder(entry);
    Type int4 = Type.vector(Type.INT, 4);
    Value pointer = entryBuilder.createAlloca(int4);
    Instruction wideLoad = entryBuilder.createLoad(int4, pointer);
    entryBuilder.createBr(body);
    IRBuilder bodyBuilder = new IRBuilder(body);
    Instruction narrowLoad = bodyBuilder.createLoad(Type.INT, pointer);
    Instruction ret = bodyBuilder.createRet(narrowLoad);

    assertFalse(GVN.runOnFunction(function));
    assertSame(entry, wideLoad.getParent());
    assertSame(body, narrowLoad.getParent());
    assertSame(narrowLoad, ret.getOperand(0));
  }

  @Test
  void doesNotMergeSameWidthLoadsOfDifferentTypesAtTheSameAddress() {
    Function function = new Function("typed_memory", Type.INT);
    BasicBlock entry = function.addBlock("entry");
    BasicBlock body = function.addBlock("body");
    IRBuilder entryBuilder = new IRBuilder(entry);
    Value pointer = entryBuilder.createAlloca(Type.FLOAT);
    Instruction floatLoad = entryBuilder.createLoad(Type.FLOAT, pointer);
    entryBuilder.createBr(body);
    IRBuilder bodyBuilder = new IRBuilder(body);
    Instruction integerLoad = bodyBuilder.createLoad(Type.INT, pointer);
    Instruction ret = bodyBuilder.createRet(integerLoad);

    assertFalse(GVN.runOnFunction(function));
    assertSame(entry, floatLoad.getParent());
    assertSame(body, integerLoad.getParent());
    assertSame(integerLoad, ret.getOperand(0));
  }

  @Test
  void eliminatesGepExpressionsFromDominatingBlocks() {
    Function function = new Function("f", Type.PTR);
    Value index = function.addArgument(Type.I64, "index");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock body = function.addBlock("body");
    IRBuilder entryBuilder = new IRBuilder(entry);
    Type array = Type.array(Type.INT, 8);
    Value storage = entryBuilder.createAlloca(array);
    Instruction first =
        entryBuilder.createGEP(array, storage, new Value[] {Constant.int64Const(0), index}, true);
    entryBuilder.createBr(body);
    IRBuilder bodyBuilder = new IRBuilder(body);
    Instruction duplicate =
        bodyBuilder.createGEP(array, storage, new Value[] {Constant.int64Const(0), index}, true);
    Instruction ret = bodyBuilder.createRet(duplicate);

    assertTrue(GVN.runOnFunction(function));
    assertSame(first, ret.getOperand(0));
    assertTrue(duplicate.getParent() == null);
  }

  @Test
  void eliminatesCastExpressionsFromDominatingBlocks() {
    Function function = new Function("f", Type.I64);
    Value value = function.addArgument(Type.INT, "value");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock body = function.addBlock("body");
    IRBuilder entryBuilder = new IRBuilder(entry);
    Instruction first = entryBuilder.createSExt(value, Type.I64);
    entryBuilder.createBr(body);
    IRBuilder bodyBuilder = new IRBuilder(body);
    Instruction duplicate = bodyBuilder.createSExt(value, Type.I64);
    Instruction ret = bodyBuilder.createRet(duplicate);

    assertTrue(GVN.runOnFunction(function));
    assertSame(first, ret.getOperand(0));
    assertTrue(duplicate.getParent() == null);
  }

  @Test
  void preservesLoadsAcrossLoopBackedgeStores() {
    Function function = new Function("f", Type.INT);
    Value condition = function.addArgument(Type.I1, "condition");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock header = function.addBlock("header");
    BasicBlock body = function.addBlock("body");
    BasicBlock exit = function.addBlock("exit");
    IRBuilder entryBuilder = new IRBuilder(entry);
    Value pointer = entryBuilder.createAlloca(Type.INT);
    entryBuilder.createLoad(Type.INT, pointer);
    entryBuilder.createBr(header);
    IRBuilder headerBuilder = new IRBuilder(header);
    Instruction reloaded = headerBuilder.createLoad(Type.INT, pointer);
    headerBuilder.createCondBr(condition, body, exit);
    IRBuilder bodyBuilder = new IRBuilder(body);
    bodyBuilder.createStore(Constant.intConst(1), pointer);
    bodyBuilder.createBr(header);
    Instruction ret = new IRBuilder(exit).createRet(reloaded);

    assertFalse(GVN.runOnFunction(function));
    assertSame(reloaded, ret.getOperand(0));
  }

  @Test
  void doesNotMergeExpressionsFromSiblingBlocks() {
    Function function = new Function("f", Type.INT);
    Value value = function.addArgument(Type.INT, "value");
    Value condition = function.addArgument(Type.INT, "condition");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock left = function.addBlock("left");
    BasicBlock right = function.addBlock("right");
    new IRBuilder(entry).createCondBr(condition, left, right);
    Instruction leftValue =
        new IRBuilder(left).createSub(value, Constant.intConst(1));
    new IRBuilder(left).createRet(leftValue);
    Instruction rightValue =
        new IRBuilder(right).createSub(value, Constant.intConst(1));
    new IRBuilder(right).createRet(rightValue);

    assertFalse(GVN.runOnFunction(function));
    assertSame(left, leftValue.getParent());
    assertSame(right, rightValue.getParent());
  }

  @Test
  void translatesEquivalentExpressionsThroughPhi() {
    Function function = new Function("f", Type.INT);
    Value value = function.addArgument(Type.INT, "value");
    Value condition = function.addArgument(Type.I1, "condition");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock left = function.addBlock("left");
    BasicBlock right = function.addBlock("right");
    BasicBlock merge = function.addBlock("merge");
    new IRBuilder(entry).createCondBr(condition, left, right);
    Instruction leftValue = new IRBuilder(left).createAdd(value, Constant.intConst(1));
    new IRBuilder(left).createBr(merge);
    Instruction rightValue = new IRBuilder(right).createAdd(value, Constant.intConst(1));
    new IRBuilder(right).createBr(merge);
    IRBuilder builder = new IRBuilder(merge);
    Instruction phi = builder.createPhi(Type.INT);
    phi.addOperand(leftValue);
    phi.addOperand(left);
    phi.addOperand(rightValue);
    phi.addOperand(right);
    Instruction ret = builder.createRet(phi);

    assertTrue(GVN.runOnFunction(function));
    assertSame(merge, ((Instruction) ret.getOperand(0)).getParent());
    assertTrue(leftValue.getParent() == null);
    assertTrue(rightValue.getParent() == null);
  }

  @Test
  void leavesEquivalentGepExpressionsThroughPhiAlone() {
    Function function = new Function("f", Type.PTR);
    Value index = function.addArgument(Type.I64, "index");
    Value condition = function.addArgument(Type.I1, "condition");
    BasicBlock entry = function.addBlock("entry");
    BasicBlock left = function.addBlock("left");
    BasicBlock right = function.addBlock("right");
    BasicBlock merge = function.addBlock("merge");
    IRBuilder entryBuilder = new IRBuilder(entry);
    Type array = Type.array(Type.INT, 8);
    Value storage = entryBuilder.createAlloca(array);
    entryBuilder.createCondBr(condition, left, right);
    Instruction leftValue =
        new IRBuilder(left).createGEP(
            array, storage, new Value[] {Constant.int64Const(0), index}, true);
    new IRBuilder(left).createBr(merge);
    Instruction rightValue =
        new IRBuilder(right).createGEP(
            array, storage, new Value[] {Constant.int64Const(0), index}, true);
    new IRBuilder(right).createBr(merge);
    IRBuilder builder = new IRBuilder(merge);
    Instruction phi = builder.createPhi(Type.PTR);
    phi.addOperand(leftValue);
    phi.addOperand(left);
    phi.addOperand(rightValue);
    phi.addOperand(right);
    Instruction ret = builder.createRet(phi);

    assertFalse(GVN.runOnFunction(function));
    assertSame(phi, ret.getOperand(0));
    assertSame(left, leftValue.getParent());
    assertSame(right, rightValue.getParent());
  }
}
