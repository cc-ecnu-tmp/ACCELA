package accela.pass;

import accela.pass.candidate.ExtendedAffineSummarizationCandidate;
import accela.pass.ir.instrument.PassInstrumentation;
import java.util.ArrayList;
import java.util.Map;
import java.util.concurrent.atomic.AtomicInteger;

/** Test bridge that injects the real candidate without changing the permanent base registry. */
public final class ExtendedAffineCandidateTestSupport {
  private ExtendedAffineCandidateTestSupport() {}

  public static PassRegistry registry() {
    ArrayList<PassDescriptor> descriptors = new ArrayList<>(PassRegistry.standard().all());
    descriptors.add(ExtendedAffineSummarizationCandidate.descriptor());
    return PassRegistry.of(descriptors);
  }

  public static PassBuilder passBuilder(
      PassInstrumentation instrumentation, AtomicInteger factoryConstructions) {
    var factory = ExtendedAffineSummarizationCandidate.factory(instrumentation);
    return new PassBuilder(new PassBuilder.CandidatePassProvider(
        Map.of(ExtendedAffineSummarizationCandidate.ID, (descriptor, occurrence) -> {
          factoryConstructions.incrementAndGet();
          return factory.apply(descriptor, occurrence);
        }),
        Map.of()));
  }
}
