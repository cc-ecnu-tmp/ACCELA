package accela.pass;

import accela.pass.ir.FunctionPass;
import accela.pass.ir.instrument.PassInstrumentation;
import java.util.Map;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.function.BiFunction;

/** Test bridge proving lazy insertion of the production candidate in the real IR pipeline. */
public final class IntegerLinearTransitionCandidatePassBuilder {
  private IntegerLinearTransitionCandidatePassBuilder() {}

  public static PassBuilder create(
      PassInstrumentation instrumentation, AtomicInteger passFactoryInvocations) {
    BiFunction<PassDescriptor, Integer, FunctionPass> productionFactory =
        IntegerLinearTransitionCandidate.functionFactory(instrumentation);
    PassBuilder.CandidatePassProvider provider = new PassBuilder.CandidatePassProvider(
        Map.of(
            IntegerLinearTransitionCandidate.ID,
            (descriptor, occurrence) -> {
              passFactoryInvocations.incrementAndGet();
              return productionFactory.apply(descriptor, occurrence);
            }),
        Map.of());
    return new PassBuilder(provider);
  }
}
