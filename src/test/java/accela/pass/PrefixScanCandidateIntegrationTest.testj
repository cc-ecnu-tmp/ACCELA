package accela.pass;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.ast.Node;
import accela.ir.AST2IR;
import accela.parse.Lexer;
import accela.parse.Parser;
import accela.parse.Sema;
import accela.pass.instrument.DecisionRemark;
import accela.pass.instrument.DecisionStatus;
import accela.pass.instrument.OptimizationRemark;
import accela.pass.ir.instrument.PassInstrumentation;
import accela.pass.ir.transform.scan.PrefixScanReuse;
import accela.pass.ir.verify.IRVerifier;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;
import org.junit.jupiter.api.Test;

final class PrefixScanCandidateIntegrationTest {
  @Test
  void descriptorMatchesTheFrozenScreeningContract() {
    PassDescriptor descriptor = PrefixScanReuse.descriptor();
    assertEquals(PrefixScanReuse.ID, descriptor.id());
    assertEquals(PassDescriptor.Lifecycle.CANDIDATE, descriptor.lifecycle());
    assertEquals(PassDescriptor.Stage.IR_FUNCTION, descriptor.stage());
    assertEquals(1, descriptor.fullPipelineOccurrences());
    assertTrue(descriptor.decisionObservable());
    assertEquals(PrefixScanReuse.LEGALITY_OBLIGATIONS, descriptor.legalityObligationIds());
    assertEquals(PassRegistry.IR_INDVAR_DOMAIN_SIMPLIFY,
        descriptor.candidateAnchor().passId());
    assertEquals(PassDescriptor.AnchorPosition.BEFORE,
        descriptor.candidateAnchor().position());
  }

  @Test
  void passRejectsDisplayAndAnchorIdentityTampering() {
    try (PassInstrumentation instrumentation = PassInstrumentation.enabled(false)) {
      PassDescriptor expected = PrefixScanReuse.descriptor();
      PassDescriptor displayTampered = new PassDescriptor(
          expected.id(), expected.logicalFamilyId(), "Tampered display", expected.stage(),
          expected.fullPipelineOccurrences(), expected.lifecycle(), expected.decisionObservable(),
          expected.candidateAnchor(), expected.legalityObligationIds());
      PassDescriptor anchorTampered = new PassDescriptor(
          expected.id(), expected.logicalFamilyId(), expected.displayName(), expected.stage(),
          expected.fullPipelineOccurrences(), expected.lifecycle(), expected.decisionObservable(),
          new PassDescriptor.CandidateAnchor(
              PassRegistry.IR_INDVAR_DOMAIN_SIMPLIFY,
              1,
              PassDescriptor.AnchorPosition.AFTER),
          expected.legalityObligationIds());

      assertThrows(IllegalArgumentException.class,
          () -> new PrefixScanReuse.Pass(instrumentation, displayTampered, 1));
      assertThrows(IllegalArgumentException.class,
          () -> new PrefixScanReuse.Pass(instrumentation, anchorTampered, 1));
    }
  }

  @Test
  void disabledProfileEmitsNoCandidateEventsAndKeepsIrValid() throws Exception {
    PassRegistry registry = PassRegistry.standard();
    List<OptimizationRemark> remarks = new ArrayList<>();
    try (PassInstrumentation instrumentation =
        PassInstrumentation.observed(false, remarks::add)) {
      PassBuilder builder = PassBuilder.withStandardCandidateImplementations(instrumentation);
      var module = parse(oracle("forward_prefix"));
      builder.buildIRO0Pipeline(instrumentation, PipelineProfile.full(registry)).run(
          module, builder.buildModuleAnalysisManager(), builder.buildFunctionAnalysisManager());
      IRVerifier.verifyModule(module);
    }
    assertTrue(remarks.stream().noneMatch(remark -> remark.passId().startsWith("candidate.")));
  }

  @Test
  void fullPipelineTransformsAllThreeOracleStructuresAndPairsRemarks() throws Exception {
    for (String structure : List.of("forward_prefix", "reverse_suffix", "weighted_prefix")) {
      PassRegistry registry = PassRegistry.standard();
      List<OptimizationRemark> remarks = new ArrayList<>();
      try (PassInstrumentation instrumentation =
          PassInstrumentation.observed(false, remarks::add)) {
        PassBuilder builder = PassBuilder.withStandardCandidateImplementations(instrumentation);
        var module = parse(oracle(structure));
        PipelineProfile profile = PipelineProfile.builder(registry)
            .enableCandidate(PrefixScanReuse.ID)
            .build();
        builder.buildIRO0Pipeline(instrumentation, profile).run(
            module, builder.buildModuleAnalysisManager(), builder.buildFunctionAnalysisManager());
        IRVerifier.verifyModule(module);
      }
      List<DecisionStatus> decisions = remarks.stream()
          .filter(remark -> PrefixScanReuse.ID.equals(remark.passId()))
          .filter(DecisionRemark.class::isInstance)
          .map(DecisionRemark.class::cast)
          .map(DecisionRemark::decision)
          .toList();
      assertEquals(List.of(DecisionStatus.CANDIDATE, DecisionStatus.APPLIED),
          decisions, structure + ": " + remarks);
      assertTrue(remarks.stream()
          .filter(remark -> PrefixScanReuse.ID.equals(remark.passId()))
          .filter(accela.pass.instrument.PassRemark.class::isInstance)
          .map(accela.pass.instrument.PassRemark.class::cast)
          .allMatch(accela.pass.instrument.PassRemark::changed));
    }
  }

  private static accela.ir.Module parse(Path sourcePath) throws Exception {
    String source = Files.readString(sourcePath, StandardCharsets.UTF_8);
    Parser parser = new Parser(new Lexer(source, sourcePath.toString()).tokenize());
    Node unit = parser.parse();
    new Sema().analyze(unit);
    return new AST2IR().convert(unit);
  }

  private static Path oracle(String structure) {
    return Path.of("benchmarks", "oracles", "prefix_scan", structure, "baseline.sy");
  }
}
