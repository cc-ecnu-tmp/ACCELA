package accela.pass;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

import accela.util.StrictJson;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import org.junit.jupiter.api.Test;

final class PipelineProfileTest {
  @Test
  void checkedInActiveProfilesAreCanonicalV2Profiles() throws Exception {
    assertEquals(PipelineProfile.full().toJson() + "\n", Files.readString(
        Path.of("docs", "optimization", "profiles", "full.json"),
        StandardCharsets.UTF_8));
    assertEquals(PipelineProfile.mandatoryOnly().toJson() + "\n", Files.readString(
        Path.of("docs", "optimization", "profiles", "mandatory-only.json"),
        StandardCharsets.UTF_8));
  }

  @Test
  void bundledV2SchemaIsGenericRatherThanAFormalCandidateMatrixSchema() throws Exception {
    Map<?, ?> schema = (Map<?, ?>) StrictJson.parse(Files.readString(
        Path.of("tools", "benchmark", "schemas", "pipeline-profile.v2.json"),
        StandardCharsets.UTF_8));
    Map<?, ?> properties = (Map<?, ?>) schema.get("properties");
    assertEquals(List.of("FULL", "MANDATORY_ONLY"),
        ((Map<?, ?>) properties.get("base")).get("enum"));
    assertFalse(((Map<?, ?>) properties.get("disable")).containsKey("maxItems"));
    assertFalse(((Map<?, ?>) properties.get("enable_candidates")).containsKey("maxItems"));
  }

  @Test
  void parsesGlobalAndOccurrenceAblations() {
    PipelineProfile profile = PipelineProfile.fromJson("""
        {
          "schema_version": 2,
          "base": "FULL",
          "disable": [
            {"family": "backend.loop-optimization"},
            {"pass": "ir.loop-interchange"},
            {"pass": "ir.loop-unroll", "occurrence": 2}
          ],
          "enable_candidates": []
        }
        """);

    assertFalse(profile.isEnabled(PassRegistry.IR_LOOP_INTERCHANGE, 1));
    assertFalse(profile.isEnabled(PassRegistry.BACKEND_MACHINE_LICM, 1));
    assertFalse(profile.isEnabled(PassRegistry.BACKEND_LOOP_CONDITION_DUPLICATION, 1));
    assertTrue(profile.isEnabled(PassRegistry.IR_LOOP_UNROLL, 1));
    assertFalse(profile.isEnabled(PassRegistry.IR_LOOP_UNROLL, 2));
    assertTrue(profile.isEnabled(PassRegistry.IR_GVN, 1));
  }

  @Test
  void rejectsUnknownPassOccurrenceAndConfigurationKeys() {
    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.fromJson(
        "{\"schema_version\":2,\"base\":\"FULL\",\"disable\":[{\"pass\":\"ir.missing\"}],\"enable_candidates\":[]}"));
    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.fromJson(
        "{\"schema_version\":2,\"base\":\"FULL\",\"disable\":[{\"pass\":\"ir.loop-unroll\",\"occurrence\":3}],\"enable_candidates\":[]}"));
    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.fromJson(
        "{\"schema_version\":2,\"base\":\"FULL\",\"disable\":[],\"enable_candidates\":[],\"extra\":true}"));
  }

  @Test
  void rejectsLegacyV1ProfilesWithoutACompatibilityPath() {
    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.fromJson(
        "{\"schema_version\":1,\"base\":\"FULL\",\"disable\":[]}"));
  }

  @Test
  void rejectsRequiredAndConflictingAblations() {
    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.builder()
        .disable(PassRegistry.BACKEND_REGISTER_ALLOCATION));
    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.builder()
        .disable(PassRegistry.IR_MEM2REG));
    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.builder()
        .disableFamily(PassRegistry.FAMILY_IR_SSA_CONSTRUCTION));
    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.builder()
        .disableOccurrence(PassRegistry.IR_LOOP_UNROLL, 1)
        .disable(PassRegistry.IR_LOOP_UNROLL));
    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.fromJson(
        "{\"schema_version\":2,\"schema_version\":2,\"base\":\"FULL\",\"disable\":[],\"enable_candidates\":[]}"));
  }

  @Test
  void constructsAndRoundTripsMandatoryOnlyProfile() {
    PipelineProfile profile = PipelineProfile.mandatoryOnly();
    assertTrue(profile.isEnabled(PassRegistry.IR_MEM2REG, 1));
    assertTrue(profile.isEnabled(PassRegistry.BACKEND_REGISTER_ALLOCATION, 1));
    assertFalse(profile.isEnabled(PassRegistry.IR_SROA, 1));
    assertFalse(profile.isEnabled(PassRegistry.BACKEND_MACHINE_CSE, 1));

    PipelineProfile roundTrip = PipelineProfile.fromJson(profile.toJson());
    assertTrue(roundTrip.isEnabled(PassRegistry.IR_MEM2REG, 1));
    assertFalse(roundTrip.isEnabled(PassRegistry.IR_SROA, 1));
    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.fromJson(
        "{\"schema_version\":2,\"base\":\"MANDATORY_ONLY\","
            + "\"disable\":[{\"pass\":\"ir.sroa\"}],\"enable_candidates\":[]}"));
  }

  @Test
  void familyAndPassAblationsCannotOverlap() {
    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.builder()
        .disable(PassRegistry.IR_LOOP_UNROLL_AND_JAM)
        .disableFamily(PassRegistry.FAMILY_IR_LOOP_UNROLLING));
    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.builder()
        .disableFamily(PassRegistry.FAMILY_IR_LOOP_UNROLLING)
        .disableOccurrence(PassRegistry.IR_LOOP_UNROLL, 1));
  }

  @Test
  void crossStageConstantArithmeticFamilyDisablesBothImplementations() {
    PipelineProfile profile = PipelineProfile.builder()
        .disableFamily(
            PassRegistry.FAMILY_INTEGER_CONSTANT_ARITHMETIC_STRENGTH_REDUCTION)
        .build();

    assertFalse(profile.isEnabled(PassRegistry.IR_STRENGTH_REDUCTION, 1));
    assertFalse(profile.isEnabled(PassRegistry.BACKEND_RISCV_STRENGTH_REDUCTION, 1));
  }

  @Test
  void recognizesWhenEveryOccurrenceIsDisabledIndividually() {
    PipelineProfile profile = PipelineProfile.builder()
        .disableOccurrence(PassRegistry.IR_LOOP_UNROLL, 1)
        .disableOccurrence(PassRegistry.IR_LOOP_UNROLL, 2)
        .build();

    assertTrue(profile.disablesAll(PassRegistry.IR_LOOP_UNROLL));
  }

  @Test
  void candidatesAreDefaultOffAndRequireExplicitStrictProfileEnablement() {
    PassDescriptor candidate = new PassDescriptor(
        "candidate.ir.test-fold", "candidate.ir.test-fold", "Test fold",
        PassDescriptor.Stage.IR_FUNCTION, 1, PassDescriptor.Lifecycle.CANDIDATE, true,
        new PassDescriptor.CandidateAnchor(
            PassRegistry.IR_INST_COMBINE, 1, PassDescriptor.AnchorPosition.AFTER),
        List.of("candidate.ir.test-fold.no-overflow"));
    ArrayList<PassDescriptor> descriptors = new ArrayList<>(PassRegistry.standard().all());
    descriptors.add(candidate);
    PassRegistry registry = PassRegistry.of(descriptors);

    PipelineProfile full = PipelineProfile.full(registry);
    assertFalse(full.isEnabled(candidate.id(), 1));
    assertTrue(full.enabledCandidates().isEmpty());
    assertTrue(full.disablesAll(candidate.id()));

    PipelineProfile enabled = PipelineProfile.builder(registry)
        .enableCandidate(candidate.id())
        .build();
    assertTrue(enabled.isEnabled(candidate.id(), 1));
    assertTrue(enabled.enabledCandidates().contains(candidate.id()));
    PipelineProfile roundTrip = PipelineProfile.fromJson(enabled.toJson(), registry);
    assertTrue(roundTrip.isEnabled(candidate.id(), 1));

    assertThrows(IllegalArgumentException.class,
        () -> PipelineProfile.builder(registry).enableCandidate(PassRegistry.IR_INST_COMBINE));
    assertThrows(IllegalArgumentException.class,
        () -> PipelineProfile.builder(registry).enableCandidate(candidate.id())
            .enableCandidate(candidate.id()));
    assertThrows(IllegalArgumentException.class,
        () -> PipelineProfile.builder(registry).disable(candidate.id()));
    assertThrows(IllegalArgumentException.class,
        () -> PipelineProfile.builder(registry).disableFamily(candidate.logicalFamilyId()));
    assertThrows(IllegalArgumentException.class,
        () -> PipelineProfile.builder(registry, PipelineProfile.Base.MANDATORY_ONLY)
            .enableCandidate(candidate.id()));
    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.fromJson(
        "{\"schema_version\":2,\"base\":\"FULL\",\"disable\":[],"
            + "\"enable_candidates\":[\"candidate.ir.unknown\"]}", registry));
  }

  @Test
  void candidateEnablementMustFollowStableRegistryOrder() {
    PassDescriptor.CandidateAnchor anchor = new PassDescriptor.CandidateAnchor(
        PassRegistry.IR_INST_COMBINE, 1, PassDescriptor.AnchorPosition.AFTER);
    PassDescriptor first = new PassDescriptor(
        "candidate.ir.first", "candidate.ir.first", "First candidate",
        PassDescriptor.Stage.IR_FUNCTION, 1, PassDescriptor.Lifecycle.CANDIDATE, true,
        anchor, List.of("candidate.ir.first.valid-shape"));
    PassDescriptor second = new PassDescriptor(
        "candidate.ir.second", "candidate.ir.second", "Second candidate",
        PassDescriptor.Stage.IR_FUNCTION, 1, PassDescriptor.Lifecycle.CANDIDATE, true,
        anchor, List.of("candidate.ir.second.valid-shape"));
    ArrayList<PassDescriptor> descriptors = new ArrayList<>(PassRegistry.standard().all());
    descriptors.add(first);
    descriptors.add(second);
    PassRegistry registry = PassRegistry.of(descriptors);

    PipelineProfile ordered = PipelineProfile.builder(registry)
        .enableCandidate(first.id())
        .enableCandidate(second.id())
        .build();
    assertEquals(List.of(first.id(), second.id()), ordered.enabledCandidates());
    assertTrue(ordered.toJson().contains(
        "\"enable_candidates\":[\"candidate.ir.first\",\"candidate.ir.second\"]"));
    assertEquals(ordered.enabledCandidates(),
        PipelineProfile.fromJson(ordered.toJson(), registry).enabledCandidates());

    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.builder(registry)
        .enableCandidate(second.id())
        .enableCandidate(first.id())
        .build());
    assertThrows(IllegalArgumentException.class, () -> PipelineProfile.fromJson(
        "{\"schema_version\":2,\"base\":\"FULL\",\"disable\":[],"
            + "\"enable_candidates\":[\"candidate.ir.second\",\"candidate.ir.first\"]}",
        registry));
  }
}
