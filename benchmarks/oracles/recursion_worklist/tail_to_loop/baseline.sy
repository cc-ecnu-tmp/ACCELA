// Provenance: ACCELA clean-room original; no upstream benchmark source copied.
// Family description: semantic oracle for recursion_worklist/tail_to_loop: tail recursion eliminated to a loop; role=baseline
// Input contract: two decimal integers, problem size n and deterministic seed.


int rng_state;

int next_small() {
  rng_state = (rng_state * 25173 + 13849) % 65521;
  return rng_state % 31 - 15;
}

int checksum_step(int acc, int value, int index) {
  return acc * 65599 + value + index * 17;
}
int tail_step(int remaining,int value){if(remaining==0){return value;}return tail_step(remaining-1,value*3+1);}

int main() {
  int n = getint();
  int seed = getint();
  rng_state = seed % 65521;
  int value=tail_step(n,seed);putint(value);putch(10);return 0;
}
