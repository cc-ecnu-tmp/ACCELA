// Provenance: ACCELA clean-room original; no upstream benchmark source copied.
// Family description: semantic oracle for recursion_worklist/divide_conquer_sum: divide-and-conquer recursion flattened to iteration; role=optimized
// Input contract: two decimal integers, problem size n and deterministic seed.


int rng_state;

int next_small() {
  rng_state = (rng_state * 25173 + 13849) % 65521;
  return rng_state % 31 - 15;
}

int checksum_step(int acc, int value, int index) {
  return acc * 65599 + value + index * 17;
}


int main() {
  int n = getint();
  int seed = getint();
  rng_state = seed % 65521;
  int value=0;int i=0;int bias=seed%7;while(i<n){value=value+i*i+bias;i=i+1;}putint(value);putch(10);return 0;
}
