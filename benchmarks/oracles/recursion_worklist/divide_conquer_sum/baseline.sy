// Provenance: ACCELA clean-room original; no upstream benchmark source copied.
// Family description: semantic oracle for recursion_worklist/divide_conquer_sum: divide-and-conquer recursion flattened to iteration; role=baseline
// Input contract: two decimal integers, problem size n and deterministic seed.


int rng_state;

int next_small() {
  rng_state = (rng_state * 25173 + 13849) % 65521;
  return rng_state % 31 - 15;
}

int checksum_step(int acc, int value, int index) {
  return acc * 65599 + value + index * 17;
}
int sum_range(int lo,int hi,int bias){if(lo>=hi){return 0;}if(lo+1==hi){return lo*lo+bias;}int mid=lo+(hi-lo)/2;return sum_range(lo,mid,bias)+sum_range(mid,hi,bias);}

int main() {
  int n = getint();
  int seed = getint();
  rng_state = seed % 65521;
  int value=sum_range(0,n,seed%7);putint(value);putch(10);return 0;
}
