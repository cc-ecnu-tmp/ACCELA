const int N = 16;
int factors[N];
int input[N];
int output[N][N];

int main() {
  int n = getint();
  int i = 0;
  int j = 0;
  while (i < n) {
    factors[i] = i + 2;
    input[i] = i + 1;
    j = 0;
    while (j < n) {
      output[i][j] = i * 10 + j;
      j = j + 1;
    }
    i = i + 1;
  }
  factors[5] = 1;

  i = 0;
  while (i < n) {
    if (factors[i] == 1) {
      i = i + 1;
      continue;
    }
    j = 0;
    while (j < n) {
      output[i][j] = output[i][j] * factors[i] + input[j];
      j = j + 1;
    }
    i = i + 1;
  }

  int checksum = 0;
  i = 0;
  while (i < n) {
    j = 0;
    while (j < n) {
      checksum = checksum + output[i][j];
      j = j + 1;
    }
    i = i + 1;
  }
  putint(checksum);
  putch(10);
  return 0;
}
