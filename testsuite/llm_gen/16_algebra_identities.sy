// Corner: algebraic identities in expressions with runtime values
int main() {
    int x = getint();
    int a = x + 0;
    int b = 0 + x;
    int c = x * 1;
    int d = 1 * x;
    int e = x - 0;
    int f = x - x;
    int g = x * 0;
    int h = 0 * x;
    putint(a);
    putch(10);
    putint(f);
    putch(10);
    putint(g);
    putch(10);
    return a + b + c + d + e + f + g + h;
}
