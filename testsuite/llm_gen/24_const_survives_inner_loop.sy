int main() {
    int x = 42;
    int i = 0;
    while (i < 5) {
        int j = 0;
        while (j < 3) {
            if (x == 42) {
                j = j + 1;
            } else {
                x = 0;
                j = j + 1;
            }
        }
        i = i + 1;
    }
    putint(x);
    return x;
}
