{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/candidate-fast-diagnostic-study.v1.json",
  "title": "ACCELA deterministic fast campaign Top3 diagnostic study v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "diagnostic_study_id", "campaign_id", "generated_at",
    "bootstrap_sha256", "plan_sha256", "index_sha256", "b3_study",
    "top3_candidate_ids", "pairs", "cache_full", "cache_candidates",
    "diagnostic_study_commitment_sha256"
  ],
  "properties": {
    "schema_version": {"const": "candidate-fast-diagnostic-study.v1"},
    "diagnostic_study_id": {"$ref": "#/$defs/id"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "generated_at": {"type": "string", "format": "date-time"},
    "bootstrap_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "index_sha256": {"$ref": "#/$defs/sha256"},
    "b3_study": {"$ref": "#/$defs/artifact"},
    "top3_candidate_ids": {
      "type": "array", "maxItems": 3, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "pairs": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/pair"}},
    "cache_full": {"$ref": "#/$defs/cache_full"},
    "cache_candidates": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/cache_candidate"}},
    "diagnostic_study_commitment_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_positive": {"oneOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]},
    "nullable_number": {"oneOf": [{"type": "null"}, {"type": "number"}]},
    "nullable_reason": {
      "oneOf": [
        {"type": "null"},
        {"enum": ["terminal_failure", "correctness_failure", "metrics_incomplete", "no_comparable_cases"]}
      ]
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "canonical_sha256", "physical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "receipt_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "task_id", "run_id", "receipt", "terminal_commitment_sha256"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "task_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "receipt": {"$ref": "#/$defs/artifact"},
        "terminal_commitment_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "terminal_state": {"enum": ["completed", "failed", "cancelled"]},
    "pair": {
      "type": "object", "additionalProperties": false,
      "required": [
        "candidate_ids", "receipt", "terminal_state", "correctness_passed",
        "metrics_complete", "comparable_case_count", "pair_geometric_mean_speedup",
        "expected_multiplicative_speedup", "delta_ln_geometric_mean", "eligible",
        "ineligibility_reason"
      ],
      "properties": {
        "candidate_ids": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "receipt": {"$ref": "#/$defs/receipt_ref"},
        "terminal_state": {"$ref": "#/$defs/terminal_state"},
        "correctness_passed": {"type": "boolean"},
        "metrics_complete": {"type": "boolean"},
        "comparable_case_count": {"type": "integer", "minimum": 0},
        "pair_geometric_mean_speedup": {"$ref": "#/$defs/nullable_positive"},
        "expected_multiplicative_speedup": {"$ref": "#/$defs/nullable_positive"},
        "delta_ln_geometric_mean": {"$ref": "#/$defs/nullable_number"},
        "eligible": {"type": "boolean"},
        "ineligibility_reason": {"$ref": "#/$defs/nullable_reason"}
      }
    },
    "cache_result": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt", "terminal_state", "correctness_passed", "metrics_complete"],
      "properties": {
        "receipt": {"$ref": "#/$defs/receipt_ref"},
        "terminal_state": {"$ref": "#/$defs/terminal_state"},
        "correctness_passed": {"type": "boolean"},
        "metrics_complete": {"type": "boolean"}
      }
    },
    "cache_full": {"$ref": "#/$defs/cache_result"},
    "cache_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "receipt", "terminal_state", "correctness_passed", "metrics_complete"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "receipt": {"$ref": "#/$defs/receipt_ref"},
        "terminal_state": {"$ref": "#/$defs/terminal_state"},
        "correctness_passed": {"type": "boolean"},
        "metrics_complete": {"type": "boolean"}
      }
    }
  }
}
