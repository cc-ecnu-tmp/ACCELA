{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/candidate-fast-campaign-plan.v1.json",
  "title": "ACCELA bounded-parallel fast candidate campaign plan v1",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "campaign_id", "created_at", "bootstrap_id",
    "bootstrap", "repository", "max_parallel_runs", "jobs_per_run",
    "candidate_ids", "tasks", "plan_commitment_sha256"
  ],
  "properties": {
    "schema_version": {"const": "candidate-fast-campaign-plan.v1"},
    "plan_id": {"$ref": "#/$defs/id"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "bootstrap_id": {"$ref": "#/$defs/id"},
    "bootstrap": {"$ref": "#/$defs/artifact"},
    "repository": {"$ref": "#/$defs/repository_identity"},
    "max_parallel_runs": {"const": 4},
    "jobs_per_run": {"const": 4},
    "candidate_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "plan_commitment_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_id": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "canonical_sha256", "physical_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "repository_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "tree", "dirty"],
      "properties": {
        "commit": {"$ref": "#/$defs/object_id"},
        "tree": {"$ref": "#/$defs/object_id"},
        "dirty": {"const": false}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": [
        "ordinal", "task_id", "kind", "stage", "candidate_ids", "data_role",
        "run_kind",
        "measurement_mode", "dependencies", "terminal_dependencies", "gate",
        "static_bindings", "output_path", "receipt_path", "run_id",
        "logical_profile_id", "expected_configuration_template_sha256",
        "reference_profile_id", "reference_profile_sha256",
        "baseline_task_id", "baseline_artifact", "ranking_evidence",
        "suite_id", "expected_case_count", "manifest", "profile",
        "measurement_protocol", "compiler_artifact",
        "execution_environment_sha256"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "task_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["run", "study", "audit", "diagnostic", "final"]},
        "run_kind": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["candidate_empty", "single", "reference"]}
          ]
        },
        "stage": {"enum": ["bootstrap", "B1", "B2", "B3", "B4", "B5", "B6", "diagnostic", "final"]},
        "candidate_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "data_role": {"enum": ["bootstrap", "B1", "B2", "B3", "B4", "B5", "B6", "diagnostic", "final"]},
        "measurement_mode": {"enum": ["qemu_correctness", "standard_proxy", "cache_hotblock", "analysis", "none"]},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "terminal_dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "gate": {"enum": ["always", "dependencies_succeeded", "dependencies_terminal", "candidate_eligible", "diagnostic_top3", "final_ready"]},
        "static_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/named_artifact"}},
        "output_path": {"$ref": "#/$defs/path"},
        "receipt_path": {"$ref": "#/$defs/nullable_path"},
        "run_id": {"$ref": "#/$defs/nullable_id"},
        "logical_profile_id": {"$ref": "#/$defs/nullable_id"},
        "reference_profile_id": {"$ref": "#/$defs/nullable_id"},
        "reference_profile_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "expected_configuration_template_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "baseline_task_id": {"$ref": "#/$defs/nullable_id"},
        "baseline_artifact": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
        "ranking_evidence": {"type": "boolean"},
        "suite_id": {"$ref": "#/$defs/nullable_id"},
        "expected_case_count": {
          "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]
        },
        "manifest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
        "profile": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
        "measurement_protocol": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
        "compiler_artifact": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
        "execution_environment_sha256": {"$ref": "#/$defs/nullable_sha256"}
      }
    },
    "nullable_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "nullable_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "nullable_path": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
    "named_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    }
  }
}
