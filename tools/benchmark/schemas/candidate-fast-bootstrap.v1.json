{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/candidate-fast-bootstrap.v1.json",
  "title": "ACCELA fast campaign immutable bootstrap v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bootstrap_id", "campaign_id", "created_at",
    "source_revision", "evaluation_revision", "source_artifacts",
    "static_artifacts", "imported_receipts", "bootstrap_commitment_sha256"
  ],
  "properties": {
    "schema_version": {"const": "candidate-fast-bootstrap.v1"},
    "bootstrap_id": {"$ref": "#/$defs/id"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_revision": {"$ref": "#/$defs/repository_identity"},
    "evaluation_revision": {"$ref": "#/$defs/repository_identity"},
    "source_artifacts": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/named_artifact"}
    },
    "static_artifacts": {
      "type": "array", "minItems": 4,
      "items": {"$ref": "#/$defs/named_artifact"}
    },
    "imported_receipts": {
      "type": "array", "items": {"$ref": "#/$defs/imported_receipt"}
    },
    "bootstrap_commitment_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_id": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "repository_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "tree", "dirty"],
      "properties": {
        "commit": {"$ref": "#/$defs/object_id"},
        "tree": {"$ref": "#/$defs/object_id"},
        "dirty": {"const": false}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "canonical_sha256", "physical_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "named_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact", "verification_commitment_sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "verification_commitment_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "imported_receipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_id", "run_id", "run_artifact",
        "terminal_commitment_sha256", "verification_commitment_sha256"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "run_artifact": {"$ref": "#/$defs/artifact"},
        "terminal_commitment_sha256": {"$ref": "#/$defs/sha256"},
        "verification_commitment_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
