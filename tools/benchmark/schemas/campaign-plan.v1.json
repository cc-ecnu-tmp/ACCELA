{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/campaign-plan.v1.json",
  "title": "ACCELA 72-hour phased benchmark campaign plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "campaign_id", "initial_matrix_sha256", "matrix_sha256",
    "parent_plan_sha256", "promotion_status_sha256", "run_record_schema_sha256",
    "total_budget_seconds",
    "max_workers", "measurement_protocols", "reference_toolchain", "suites",
    "oracle_plan", "promotion", "phases", "final_pair_families", "tasks"
  ],
  "properties": {
    "schema_version": {"const": "campaign-plan.v1"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "initial_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "matrix_sha256": {"$ref": "#/$defs/sha256"},
    "parent_plan_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "promotion_status_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "run_record_schema_sha256": {"$ref": "#/$defs/sha256"},
    "total_budget_seconds": {"const": 259200},
    "max_workers": {"type": "integer", "minimum": 1, "maximum": 4},
    "measurement_protocols": {
      "type": "object", "additionalProperties": false,
      "required": ["standard_proxy", "cache_hotblock"],
      "properties": {
        "standard_proxy": {"$ref": "#/$defs/measurement_protocol"},
        "cache_hotblock": {"$ref": "#/$defs/measurement_protocol"}
      }
    },
    "reference_toolchain": {"$ref": "#/$defs/reference_toolchain"},
    "suites": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {"$ref": "#/$defs/suite"}
    },
    "oracle_plan": {"$ref": "#/$defs/oracle_plan"},
    "promotion": {"$ref": "#/$defs/promotion"},
    "phases": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/phase"}
    },
    "final_pair_families": {
      "type": "array", "minItems": 0, "maxItems": 5, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "tasks": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "measurement_protocol": {
      "type": "object", "additionalProperties": false,
      "required": [
        "protocol_id", "measurement_mode", "protocol_sha256", "runner_command_sha256",
        "runner_adapter", "profile_plugin_sha256", "cache_plugin_sha256",
        "hotblocks_plugin_sha256", "cache_model_sha256"
      ],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/id"},
        "measurement_mode": {"enum": ["standard_proxy", "cache_hotblock"]},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "runner_command_sha256": {"$ref": "#/$defs/sha256"},
        "runner_adapter": {"enum": ["host", "wsl"]},
        "profile_plugin_sha256": {"$ref": "#/$defs/sha256"},
        "cache_plugin_sha256": {"$ref": "#/$defs/sha256"},
        "hotblocks_plugin_sha256": {"$ref": "#/$defs/sha256"},
        "cache_model_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tool_versions": {
      "type": "object", "additionalProperties": false,
      "required": ["qemu-system-riscv64", "bare-metal-linker", "python", "glib"],
      "properties": {
        "qemu-system-riscv64": {"type": "string", "minLength": 1, "maxLength": 256},
        "bare-metal-linker": {"type": "string", "minLength": 1, "maxLength": 256},
        "python": {"type": "string", "minLength": 1, "maxLength": 256},
        "glib": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "reference_baseline": {
      "type": "object", "additionalProperties": false,
      "required": [
        "compiler_baseline", "profile_id", "profile_sha256", "tool", "version",
        "optimization", "compiler_executable", "compiler_command_sha256",
        "compiler_argv_sha256"
      ],
      "properties": {
        "compiler_baseline": {"enum": ["gcc_13_3_o2", "clang_18_o3"]},
        "profile_id": {"enum": ["gcc-13.3-o2", "clang-18-o3"]},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "tool": {"enum": ["riscv-gcc", "clang"]},
        "version": {"enum": ["13.3.0", "18.1.3"]},
        "optimization": {"enum": ["-O2", "-O3"]},
        "compiler_executable": {"const": "sh"},
        "compiler_command_sha256": {"$ref": "#/$defs/sha256"},
        "compiler_argv_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reference_toolchain": {
      "type": "object", "additionalProperties": false,
      "required": [
        "snapshot_sha256", "compile_driver_sha256", "source_adapter_sha256",
        "builtin_header_sha256", "image_id", "common_tool_versions",
        "accela_jdk_version", "baselines"
      ],
      "properties": {
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "compile_driver_sha256": {"$ref": "#/$defs/sha256"},
        "source_adapter_sha256": {"$ref": "#/$defs/sha256"},
        "builtin_header_sha256": {"$ref": "#/$defs/sha256"},
        "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "named_volume_contract": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "required_labels"],
          "properties": {
            "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,254}$"},
            "required_labels": {
              "type": "object", "additionalProperties": false,
              "required": ["org.accela.campaign", "org.accela.purpose"],
              "properties": {
                "org.accela.campaign": {"type": "string", "minLength": 1, "maxLength": 255},
                "org.accela.purpose": {"type": "string", "minLength": 1, "maxLength": 255}
              }
            }
          }
        },
        "candidate_toolchain": {"$ref": "#/$defs/candidate_toolchain"},
        "common_tool_versions": {"$ref": "#/$defs/tool_versions"},
        "accela_jdk_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "baselines": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/reference_baseline"}
        }
      }
    },
    "candidate_toolchain": {
      "type": "object", "additionalProperties": false,
      "required": [
        "base_image_tag", "base_image_id", "dockerfile_path", "dockerfile_sha256",
        "docker_cli", "image_tag", "image_id", "rootfs_layers"
      ],
      "properties": {
        "base_image_tag": {"type": "string", "minLength": 1, "maxLength": 256},
        "base_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "dockerfile_path": {"const": "tools/benchmark/candidate-toolchain.Dockerfile"},
        "dockerfile_sha256": {"$ref": "#/$defs/sha256"},
        "docker_cli": {
          "type": "object", "additionalProperties": false,
          "required": ["install_path_id", "sha256", "version", "version_output"],
          "properties": {
            "install_path_id": {"const": "usr-local-bin-docker-v1"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){2}$"},
            "version_output": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "image_tag": {"type": "string", "minLength": 1, "maxLength": 256},
        "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "rootfs_layers": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "metric_spec": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_id", "source", "pattern_sha256", "unit"],
      "properties": {
        "metric_id": {"$ref": "#/$defs/id"},
        "source": {"const": "file"},
        "pattern_sha256": {"$ref": "#/$defs/sha256"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "measurement_contract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "metric_profile_id", "compile_repetitions", "reuse_compile_cache",
        "additional_metric_specs"
      ],
      "properties": {
        "metric_profile_id": {
          "oneOf": [{"type": "null"}, {"const": "rv64gc-qemu-v1"}]
        },
        "compile_repetitions": {"const": 5},
        "reuse_compile_cache": {"const": false},
        "additional_metric_specs": {
          "type": "array", "maxItems": 3, "uniqueItems": true,
          "items": {"$ref": "#/$defs/metric_spec"}
        }
      }
    },
    "suite": {
      "type": "object", "additionalProperties": false,
      "required": ["data_role", "suite_id", "manifest_sha256", "case_count"],
      "properties": {
        "data_role": {"enum": ["B1", "B2", "B3", "B4", "B5", "B6", "oracle"]},
        "suite_id": {"$ref": "#/$defs/id"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "case_count": {"type": "integer", "minimum": 1}
      }
    },
    "promotion": {
      "type": "object", "additionalProperties": false,
      "required": [
        "smoke_geometric_mean_minimum", "smoke_any_case_minimum",
        "smoke_regression_ratio_below", "promote_correctness_anomaly",
        "minimum_promoted_profiles", "final_profile_count",
        "required_pair_profiles", "required_evidence_level"
      ],
      "properties": {
        "smoke_geometric_mean_minimum": {"const": 1.005},
        "smoke_any_case_minimum": {"const": 1.1},
        "smoke_regression_ratio_below": {"const": 0.97},
        "promote_correctness_anomaly": {"const": true},
        "minimum_promoted_profiles": {"const": 8},
        "final_profile_count": {"const": 5},
        "required_pair_profiles": {"const": 10},
        "required_evidence_level": {"const": "qemu_proxy"}
      }
    },
    "oracle_plan": {
      "type": "object", "additionalProperties": false,
      "required": [
        "plan_sha256", "suite_id", "manifest_sha256", "baseline_run_id",
        "optimized_run_id", "pipeline_profile_id", "pipeline_profile_sha256"
      ],
      "properties": {
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "suite_id": {"$ref": "#/$defs/id"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_run_id": {"$ref": "#/$defs/id"},
        "optimized_run_id": {"$ref": "#/$defs/id"},
        "pipeline_profile_id": {"$ref": "#/$defs/id"},
        "pipeline_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "phase": {
      "type": "object", "additionalProperties": false,
      "required": ["phase_id", "budget_seconds", "unused_budget_destination"],
      "properties": {
        "phase_id": {"enum": ["baseline_validation", "singleton_b2", "promotion_b3", "final_validation"]},
        "budget_seconds": {"enum": [43200, 86400]},
        "unused_budget_destination": {
          "oneOf": [{"type": "null"}, {"const": "final_validation"}]
        }
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_id", "suite_role", "suite_id", "manifest_sha256",
        "profile_id", "profile_sha256", "profile_path", "kind", "logical_families",
        "phase_id", "selection_rule", "measurement_mode", "measurement_contract",
        "required_evidence_level", "run_id", "dependencies", "compiler_baseline",
        "reference_compiler_contract", "oracle_leg"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "suite_role": {"enum": ["B1", "B2", "B3", "B4", "B5", "B6", "oracle"]},
        "suite_id": {"$ref": "#/$defs/id"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "profile_id": {"$ref": "#/$defs/id"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "profile_path": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 4096}]},
        "kind": {"enum": ["full", "mandatory", "family_ablation", "pair_ablation", "toolchain_baseline"]},
        "logical_families": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}
        },
        "phase_id": {"enum": ["baseline_validation", "singleton_b2", "promotion_b3", "final_validation"]},
        "selection_rule": {
          "enum": ["always", "smoke_promoted", "confirmation_available", "confirmation_top5", "pair_of_confirmation_top5"]
        },
        "measurement_mode": {"enum": ["correctness", "standard_proxy", "cache_hotblock"]},
        "measurement_contract": {"$ref": "#/$defs/measurement_contract"},
        "required_evidence_level": {"enum": ["qemu_correctness", "qemu_proxy"]},
        "run_id": {"$ref": "#/$defs/id"},
        "dependencies": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}
        },
        "compiler_baseline": {"enum": ["accela_full", "accela_mandatory", "gcc_13_3_o2", "clang_18_o3", "oracle_accela_full"]},
        "reference_compiler_contract": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference_baseline"}]
        },
        "oracle_leg": {"oneOf": [{"type": "null"}, {"enum": ["baseline", "optimized"]}]}
      }
    }
  }
}
