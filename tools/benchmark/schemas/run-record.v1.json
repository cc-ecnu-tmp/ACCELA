{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/run-record.v1.json",
  "title": "ACCELA benchmark run record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "suite_id", "manifest_sha256",
    "manifest_case_count", "manifest_case_ids_sha256",
    "configuration_sha256", "started_at", "updated_at", "completed_at",
    "state", "provenance", "configuration", "cases", "summary"
  ],
  "properties": {
    "schema_version": {"const": "run-record.v1"},
    "run_id": {"$ref": "#/$defs/id"},
    "suite_id": {"$ref": "#/$defs/id"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_case_count": {"type": "integer", "minimum": 1},
    "manifest_case_ids_sha256": {"$ref": "#/$defs/sha256"},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "started_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "completed_at": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
    "state": {"enum": ["running", "completed", "failed", "interrupted"]},
    "provenance": {"$ref": "#/$defs/provenance"},
    "configuration": {"$ref": "#/$defs/configuration"},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "git_oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "timestamp_or_null": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "duration_ns", "exit_code", "stdout", "stderr", "diagnostic"],
      "properties": {
        "status": {"enum": ["ok", "error", "timeout", "cancelled"]},
        "duration_ns": {"type": "integer", "minimum": 0},
        "exit_code": {"oneOf": [{"type": "null"}, {"type": "integer"}]},
        "stdout": {"$ref": "#/$defs/stream"},
        "stderr": {"$ref": "#/$defs/stream"},
        "diagnostic": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 4096}]}
      }
    },
    "compile_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "duration_ns", "exit_code", "stdout", "stderr", "diagnostic",
        "artifact_sha256", "artifact_size_bytes", "remarks_sha256", "remarks_event_count"
      ],
      "properties": {
        "status": {"enum": ["ok", "error", "timeout", "cancelled"]},
        "duration_ns": {"type": "integer", "minimum": 0},
        "exit_code": {"oneOf": [{"type": "null"}, {"type": "integer"}]},
        "stdout": {"$ref": "#/$defs/stream"},
        "stderr": {"$ref": "#/$defs/stream"},
        "diagnostic": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 4096}]},
        "artifact_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "artifact_size_bytes": {
          "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]
        },
        "remarks_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "remarks_event_count": {
          "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "adapter", "command_sha256", "executable", "environment_keys"],
      "properties": {
        "kind": {"enum": ["benchmark-compiler", "external", "qemu", "boom", "oracle", "analyzer", "none"]},
        "adapter": {"enum": ["host", "wsl"]},
        "command_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "executable": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 256}]},
        "environment_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        }
      }
    },
    "metric_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "source", "pattern_sha256", "unit"],
      "properties": {
        "metric_id": {"$ref": "#/$defs/id"},
        "source": {
          "enum": [
            "wall_time", "stdout", "stderr", "file", "compile_time", "link_time",
            "artifact_size", "binary_size", "compile_stdout", "compile_stderr",
            "link_stdout", "link_stderr", "analyzer"
          ]
        },
        "pattern_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "value", "unit", "origin", "availability", "reason"],
      "properties": {
        "metric_id": {"$ref": "#/$defs/id"},
        "value": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0}]},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "origin": {"enum": ["observed", "cached", "derived"]},
        "availability": {"enum": ["measured", "unavailable"]},
        "reason": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["not_supported_by_toolchain", "not_emitted_by_compiler", "not_applicable", "not_collected_by_protocol", "remarks_not_available"]}
          ]
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler", "linker", "analyzer", "runner", "primary_metric_id", "metric_profile_id", "metrics", "compile_timeout_seconds",
        "link_timeout_seconds", "analyze_timeout_seconds", "run_timeout_seconds", "timeout_policy",
        "baseline_timeout_run_sha256", "baseline_timeout_run_id", "timeout_minimum_seconds", "timeout_multiplier", "timeout_cap_seconds",
        "compile_repetitions", "reuse_compile_cache", "compile_storage_contract", "repetitions",
        "max_workers", "keep_going", "retry_failures", "seed", "artifact_suffix", "binary_suffix",
        "wsl_distribution_sha256", "environment_label", "tool_versions",
        "evidence_level", "consistency_fraction", "consistency_repetitions", "metric_file_sha256", "analysis_file_sha256",
        "output_contract", "result_file_sha256", "remarks_file_sha256"
      ],
      "properties": {
        "compiler": {"$ref": "#/$defs/stage"},
        "pipeline_profile_file_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "linker": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stage"}]},
        "analyzer": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stage"}]},
        "runner": {"$ref": "#/$defs/stage"},
        "primary_metric_id": {"$ref": "#/$defs/id"},
        "metric_profile_id": {"oneOf": [{"type": "null"}, {"const": "rv64gc-qemu-v1"}]},
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/metric_spec"}
        },
        "compile_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "compile_repetitions": {"type": "integer", "minimum": 1, "maximum": 100},
        "reuse_compile_cache": {"type": "boolean"},
        "compile_storage_contract": {"enum": ["attempt_local_v1", "reusable_cache_v2"]},
        "link_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "analyze_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "run_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "timeout_policy": {"enum": ["fixed", "initial", "baseline_derived"]},
        "baseline_timeout_run_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "baseline_timeout_run_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "timeout_minimum_seconds": {"type": "number", "exclusiveMinimum": 0},
        "timeout_multiplier": {"type": "number", "exclusiveMinimum": 0},
        "timeout_cap_seconds": {"type": "number", "exclusiveMinimum": 0},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_workers": {"type": "integer", "minimum": 1, "maximum": 4},
        "keep_going": {"type": "boolean"},
        "retry_failures": {"type": "boolean"},
        "seed": {"type": "integer", "minimum": 0},
        "artifact_suffix": {"type": "string", "pattern": "^\\.[A-Za-z0-9._-]+$"},
        "binary_suffix": {"type": "string", "pattern": "^\\.[A-Za-z0-9._-]+$"},
        "wsl_distribution_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "metric_file_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "analysis_file_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "remarks_file_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "result_file_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "output_contract": {"enum": ["lf_return_trailer", "process_exit", "result_file", "raw_stdout"]},
        "environment_label": {"enum": ["official", "local_reference", "proxy"]},
        "evidence_level": {"enum": ["compile_only", "qemu_correctness", "qemu_proxy", "boom_hardware"]},
        "consistency_fraction": {"const": 0.1},
        "consistency_repetitions": {"const": 3},
        "tool_versions": {
          "type": "array",
          "items": {"$ref": "#/$defs/tool_version"}
        }
      }
    },
    "tool_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "actual", "official_expected", "comparison"],
      "properties": {
        "tool": {"$ref": "#/$defs/id"},
        "actual": {"type": "string", "minLength": 1, "maxLength": 256},
        "official_expected": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 256}]},
        "comparison": {"enum": ["exact", "mismatch", "unknown"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_commit", "repo_dirty", "tracked_diff_sha256", "pipeline_profile_id",
        "pipeline_profile_sha256", "compiler_artifact_sha256",
        "measurement_protocol_id", "measurement_protocol_sha256"
      ],
      "properties": {
        "repo_commit": {"$ref": "#/$defs/git_oid"},
        "repo_dirty": {"type": "boolean"},
        "tracked_diff_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "pipeline_profile_id": {"$ref": "#/$defs/id"},
        "pipeline_profile_sha256": {"$ref": "#/$defs/sha256"},
        "compiler_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "measurement_protocol_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "measurement_protocol_sha256": {"$ref": "#/$defs/nullable_sha256"}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index", "status", "duration_ns", "exit_code", "measurements",
        "censoring", "censor_bound", "censor_unit", "censor_metric_id",
        "stdout", "program_stdout", "stderr", "expected_return_uint8", "observed_return_uint8",
        "first_mismatch_offset", "diagnostic"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "status": {"enum": ["passed", "wrong_output", "runtime_error", "timeout", "cancelled"]},
        "duration_ns": {"type": "integer", "minimum": 0},
        "exit_code": {"oneOf": [{"type": "null"}, {"type": "integer"}]},
        "measurements": {
          "type": "array",
          "items": {"$ref": "#/$defs/measurement"}
        },
        "censoring": {"enum": ["none", "right"]},
        "censor_bound": {"oneOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]},
        "censor_unit": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 64}]},
        "censor_metric_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "stdout": {"$ref": "#/$defs/stream"},
        "program_stdout": {"$ref": "#/$defs/stream"},
        "stderr": {"$ref": "#/$defs/stream"},
        "expected_return_uint8": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 255}]},
        "observed_return_uint8": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 255}]},
        "first_mismatch_offset": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
        "diagnostic": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 4096}]}
      }
    },
    "compile_statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "median_duration_ns", "mad_duration_ns"],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 1},
        "median_duration_ns": {"type": "number", "minimum": 0},
        "mad_duration_ns": {"type": "number", "minimum": 0}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "family", "source_group", "target", "weight", "tags", "data_role", "oracle_pair",
        "effective_timeout_seconds", "attempt_index", "attempt_started_at", "attempt_configuration_sha256",
        "source_sha256", "input_sha256",
        "artifact_sha256", "binary_sha256", "remarks_sha256", "remarks_event_count", "analysis_sha256",
        "expected_output_sha256", "status", "cache_hit", "compile", "compile_samples", "compile_statistics", "link", "analyze",
        "measurements", "samples", "consistency_selected", "consistency_passed",
        "consistency_mismatched_metrics", "diagnostic", "attempts"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "family": {"$ref": "#/$defs/id"},
        "source_group": {"$ref": "#/$defs/id"},
        "target": {"const": "rv64gc"},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "tags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "data_role": {"enum": ["B1", "B2", "B3", "B4", "B5", "B6", "oracle"]},
        "oracle_pair": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["pair_id", "leg", "counterpart_case_id"],
              "properties": {
                "pair_id": {"$ref": "#/$defs/id"},
                "leg": {"enum": ["baseline", "optimized"]},
                "counterpart_case_id": {"$ref": "#/$defs/id"}
              }
            }
          ]
        },
        "effective_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "attempt_index": {"type": "integer", "minimum": 0},
        "attempt_started_at": {
          "oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
        },
        "attempt_configuration_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "timeout_derivation": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "baseline_run_id", "baseline_run_sha256", "baseline_case_status",
                "baseline_median_duration_ns"
              ],
              "properties": {
                "baseline_run_id": {"$ref": "#/$defs/id"},
                "baseline_run_sha256": {"$ref": "#/$defs/sha256"},
                "baseline_case_status": {"enum": ["passed", "timeout"]},
                "baseline_median_duration_ns": {
                  "oneOf": [{"type": "null"}, {"type": "number", "minimum": 0}]
                }
              }
            }
          ]
        },
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "input_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "expected_output_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "binary_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "remarks_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "remarks_event_count": {
          "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]
        },
        "analysis_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "status": {"enum": ["pending", "passed", "wrong_output", "compile_error", "link_error", "analyze_error", "runtime_error", "timeout", "measurement_inconsistent", "cancelled"]},
        "cache_hit": {"type": "boolean"},
        "compile": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/phase"}]},
        "compile_samples": {"type": "array", "items": {"$ref": "#/$defs/compile_sample"}},
        "compile_statistics": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/compile_statistics"}]},
        "link": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/phase"}]},
        "analyze": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/phase"}]},
        "measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}},
        "samples": {"type": "array", "items": {"$ref": "#/$defs/sample"}},
        "consistency_selected": {"type": "boolean"},
        "consistency_passed": {"oneOf": [{"type": "null"}, {"type": "boolean"}]},
        "consistency_mismatched_metrics": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "diagnostic": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 4096}]}
        ,"attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_index", "started_at", "archived_at", "configuration_sha256", "status", "failure_summary", "cache_hit",
        "artifact_sha256", "binary_sha256", "remarks_sha256", "remarks_event_count", "analysis_sha256",
        "compile", "compile_samples", "compile_statistics", "link", "analyze",
        "measurements", "samples", "consistency_passed",
        "consistency_mismatched_metrics", "diagnostic"
      ],
      "properties": {
        "attempt_index": {"type": "integer", "minimum": 0},
        "started_at": {"type": "string", "format": "date-time"},
        "archived_at": {"type": "string", "format": "date-time"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["wrong_output", "compile_error", "link_error", "analyze_error", "runtime_error", "timeout", "measurement_inconsistent", "cancelled"]},
        "failure_summary": {
          "enum": [
            "compiler_stage_failed", "linker_stage_failed", "analyzer_stage_failed",
            "runtime_execution_failed", "correctness_mismatch", "runtime_timeout",
            "deterministic_measurement_mismatch", "scheduler_cancelled"
          ]
        },
        "cache_hit": {"type": "boolean"},
        "artifact_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "binary_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "remarks_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "remarks_event_count": {
          "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]
        },
        "analysis_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "compile": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/phase"}]},
        "compile_samples": {"type": "array", "items": {"$ref": "#/$defs/compile_sample"}},
        "compile_statistics": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/compile_statistics"}]},
        "link": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/phase"}]},
        "analyze": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/phase"}]},
        "measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}},
        "samples": {"type": "array", "items": {"$ref": "#/$defs/sample"}},
        "consistency_passed": {"oneOf": [{"type": "null"}, {"type": "boolean"}]},
        "consistency_mismatched_metrics": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "diagnostic": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 4096}]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_cases", "passed_cases", "failed_cases", "pending_cases", "censored_cases",
        "consistency_selected_cases", "consistency_passed_cases"
      ],
      "properties": {
        "total_cases": {"type": "integer", "minimum": 0},
        "passed_cases": {"type": "integer", "minimum": 0},
        "failed_cases": {"type": "integer", "minimum": 0},
        "pending_cases": {"type": "integer", "minimum": 0},
        "censored_cases": {"type": "integer", "minimum": 0},
        "consistency_selected_cases": {"type": "integer", "minimum": 0},
        "consistency_passed_cases": {"type": "integer", "minimum": 0}
      }
    }
  }
}
