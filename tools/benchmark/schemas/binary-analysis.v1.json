{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/binary-analysis.v1.json",
  "title": "ACCELA post-link binary analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "measurements"],
  "properties": {
    "schema_version": {"const": "binary-analysis.v1"},
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/measurement"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "value", "unit", "availability", "reason"],
      "properties": {
        "metric_id": {"$ref": "#/$defs/id"},
        "value": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0}]},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "availability": {"enum": ["measured", "unavailable"]},
        "reason": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["not_supported_by_toolchain", "not_emitted_by_compiler", "not_applicable", "not_collected_by_protocol", "remarks_not_available"]}
          ]
        }
      }
    }
  }
}
