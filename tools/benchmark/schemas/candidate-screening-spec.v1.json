{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/candidate-screening-spec.v1.json",
  "title": "ACCELA candidate structural screening inputs v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_id", "pass_registry_sha256", "candidates"],
  "properties": {
    "schema_version": {"const": "candidate-screening-spec.v1"},
    "spec_id": {"$ref": "#/$defs/id"},
    "pass_registry_sha256": {"$ref": "#/$defs/sha256"},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "candidate_id", "oracle_family_id", "implementation_candidate_id",
        "family_kind", "overlaps_existing_pass_ids", "duplicate_of",
        "eligible_oracle_structure_refs", "structural_disposition", "structural_reason"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "oracle_family_id": {"$ref": "#/$defs/id"},
        "implementation_candidate_id": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]
        },
        "family_kind": {"enum": ["standard", "bitset", "mixed"]},
        "overlaps_existing_pass_ids": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}
        },
        "duplicate_of": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "eligible_oracle_structure_refs": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/oracle_structure_ref"}
        },
        "structural_disposition": {"enum": ["eligible", "blocked", "rejected"]},
        "structural_reason": {
          "oneOf": [
            {"type": "null"},
            {"enum": [
              "duplicate_candidate", "overlaps_existing_pipeline",
              "unsupported_ir_or_backend", "requires_unavailable_boom_feature",
              "blocked_locked_bitset_capability_gap", "mixed_family_no_unified_transform"
            ]}
          ]
        }
      }
    },
    "oracle_structure_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["oracle_family_id", "structure_id"],
      "properties": {
        "oracle_family_id": {"$ref": "#/$defs/id"},
        "structure_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
