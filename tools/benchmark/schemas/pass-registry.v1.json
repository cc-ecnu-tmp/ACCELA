{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/pass-registry.v1.json",
  "title": "ACCELA pass registry snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "passes"],
  "properties": {
    "schema_version": {"const": "pass-registry.v1"},
    "passes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pass"}}
  },
  "$defs": {
    "pass_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "logical_family_id", "display_name", "stage", "full_pipeline_occurrences",
        "required", "decision_observable"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/pass_id"},
        "logical_family_id": {"$ref": "#/$defs/pass_id"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "stage": {"enum": ["ir_function", "ir_module", "backend_function", "backend_module"]},
        "full_pipeline_occurrences": {"type": "integer", "minimum": 1},
        "required": {"type": "boolean"},
        "decision_observable": {"type": "boolean"}
      }
    }
  }
}
