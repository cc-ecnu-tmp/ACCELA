{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/ablation-study.v1.json",
  "title": "ACCELA optimization ablation study v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "title", "generated_at", "suite_id", "data_role", "manifest_sha256",
    "matrix_sha256", "registry_sha256",
    "baseline_run_id", "baseline_profile_id", "baseline_profile_sha256",
    "primary_metric_id", "metric_unit", "bootstrap_samples", "seed", "variants", "interactions", "notes"
  ],
  "properties": {
    "schema_version": {"const": "ablation-study.v1"},
    "study_id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "generated_at": {"type": "string", "format": "date-time"},
    "suite_id": {"$ref": "#/$defs/id"},
    "data_role": {"enum": ["B2", "B3", "B4", "B5", "B6"]},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "matrix_sha256": {"$ref": "#/$defs/sha256"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_run_id": {"$ref": "#/$defs/id"},
    "baseline_profile_id": {"const": "full"},
    "baseline_profile_sha256": {"$ref": "#/$defs/sha256"},
    "primary_metric_id": {"$ref": "#/$defs/id"},
    "metric_unit": {"type": "string", "minLength": 1, "maxLength": 64},
    "bootstrap_samples": {"const": 10000},
    "seed": {"const": 20260809},
    "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variant"}},
    "interactions": {"type": "array", "items": {"$ref": "#/$defs/interaction"}},
    "notes": {"type": "array", "items": {"type": "string", "maxLength": 4096}}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_positive": {"oneOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]},
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": {"type": "number", "exclusiveMinimum": 0},
        "high": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "comparable_cases", "geometric_mean_speedup"],
      "properties": {
        "family": {"$ref": "#/$defs/id"},
        "comparable_cases": {"type": "integer", "minimum": 0},
        "geometric_mean_speedup": {"$ref": "#/$defs/nullable_positive"}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optimization_id", "profile_id", "profile_sha256", "run_id", "comparable_cases", "comparable_source_groups", "correctness_failures",
        "censored_cases", "excluded_cases", "eligible_for_ranking", "ineligibility_reason",
        "case_geometric_mean_contribution", "source_group_geometric_mean_contribution",
        "confidence_interval_95", "per_cases", "families",
        "leave_one_family_out"
      ],
      "properties": {
        "optimization_id": {"$ref": "#/$defs/id"},
        "profile_id": {"$ref": "#/$defs/id"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "run_id": {"$ref": "#/$defs/id"},
        "comparable_cases": {"type": "integer", "minimum": 0},
        "comparable_source_groups": {"type": "integer", "minimum": 0},
        "correctness_failures": {"type": "integer", "minimum": 0},
        "censored_cases": {"type": "integer", "minimum": 0},
        "excluded_cases": {"type": "integer", "minimum": 0},
        "eligible_for_ranking": {"type": "boolean"},
        "ineligibility_reason": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["correctness_failure", "incomplete_profile", "right_censored", "no_comparable_cases"]}
          ]
        },
        "case_geometric_mean_contribution": {"$ref": "#/$defs/nullable_positive"},
        "source_group_geometric_mean_contribution": {"$ref": "#/$defs/nullable_positive"},
        "confidence_interval_95": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ci"}]},
        "per_cases": {"type": "array", "items": {"$ref": "#/$defs/per_case"}},
        "families": {"type": "array", "items": {"$ref": "#/$defs/family"}},
        "leave_one_family_out": {"type": "array", "items": {"$ref": "#/$defs/lofo"}}
      }
    },
    "per_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "source_group", "family", "target", "weight",
        "metric_without", "metric_full", "contribution_ratio"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "source_group": {"$ref": "#/$defs/id"},
        "family": {"$ref": "#/$defs/id"},
        "target": {"const": "rv64gc"},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "metric_without": {"type": "number", "exclusiveMinimum": 0},
        "metric_full": {"type": "number", "exclusiveMinimum": 0},
        "contribution_ratio": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "lofo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "metric_without", "metric_full", "contribution_ratio"],
      "properties": {
        "family": {"$ref": "#/$defs/id"},
        "metric_without": {"$ref": "#/$defs/nullable_positive"},
        "metric_full": {"$ref": "#/$defs/nullable_positive"},
        "contribution_ratio": {"$ref": "#/$defs/nullable_positive"}
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left", "right", "profile_id", "profile_sha256", "run_id", "comparable_cases", "comparable_source_groups",
        "correctness_failures", "censored_cases", "excluded_cases", "eligible_for_ranking", "ineligibility_reason",
        "observed_case_geometric_mean_contribution",
        "expected_multiplicative_contribution", "interaction_factor", "delta_ln_geometric_mean"
      ],
      "properties": {
        "left": {"$ref": "#/$defs/id"},
        "right": {"$ref": "#/$defs/id"},
        "profile_id": {"$ref": "#/$defs/id"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "run_id": {"$ref": "#/$defs/id"},
        "comparable_cases": {"type": "integer", "minimum": 0},
        "comparable_source_groups": {"type": "integer", "minimum": 0},
        "correctness_failures": {"type": "integer", "minimum": 0},
        "censored_cases": {"type": "integer", "minimum": 0},
        "excluded_cases": {"type": "integer", "minimum": 0},
        "eligible_for_ranking": {"type": "boolean"},
        "ineligibility_reason": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["correctness_failure", "incomplete_profile", "right_censored", "no_comparable_cases", "constituent_ineligible"]}
          ]
        },
        "observed_case_geometric_mean_contribution": {"$ref": "#/$defs/nullable_positive"},
        "expected_multiplicative_contribution": {"$ref": "#/$defs/nullable_positive"},
        "interaction_factor": {"$ref": "#/$defs/nullable_positive"},
        "delta_ln_geometric_mean": {"oneOf": [{"type": "null"}, {"type": "number"}]}
      }
    }
  }
}
