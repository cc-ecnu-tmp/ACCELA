{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/candidate-fast-current-head.v1.json",
  "title": "ACCELA atomically published fast campaign head v1",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "campaign_id", "generation", "updated_at", "bootstrap_sha256",
    "plan_sha256", "status_id", "status", "index_id", "index", "head_commitment_sha256"
  ],
  "properties": {
    "schema_version": {"const": "candidate-fast-current-head.v1"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "generation": {"type": "integer", "minimum": 0},
    "updated_at": {"type": "string", "format": "date-time"},
    "bootstrap_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "status_id": {"$ref": "#/$defs/id"},
    "status": {"$ref": "#/$defs/artifact"},
    "index_id": {"$ref": "#/$defs/id"},
    "index": {"$ref": "#/$defs/artifact"},
    "head_commitment_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "canonical_sha256", "physical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
