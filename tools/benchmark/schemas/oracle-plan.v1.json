{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/oracle-plan.v1.json",
  "title": "ACCELA clean-room paired-source oracle plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_class", "manifest_data_role", "suite_id", "manifest_sha256", "pipeline_profile",
    "baseline_run_id", "optimized_run_id", "pairs"
  ],
  "properties": {
    "schema_version": {"const": "oracle-plan.v1"},
    "evidence_class": {"enum": ["cleanroom", "official", "holdout_or_mature"]},
    "manifest_data_role": {"enum": ["B3", "B4", "B6", "oracle"]},
    "suite_id": {"$ref": "#/$defs/id"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "pipeline_profile": {"$ref": "#/$defs/profile"},
    "baseline_run_id": {"$ref": "#/$defs/id"},
    "optimized_run_id": {"$ref": "#/$defs/id"},
    "pairs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pair"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "profile_sha256"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/id"},
        "profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "leg": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "source_group", "source_sha256"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "source_group": {"$ref": "#/$defs/id"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pair": {
      "type": "object", "additionalProperties": false,
      "required": [
        "pair_id", "family", "target", "input_sha256", "expected_output_sha256",
        "baseline", "optimized"
      ],
      "properties": {
        "pair_id": {"$ref": "#/$defs/id"},
        "family": {"$ref": "#/$defs/id"},
        "target": {"const": "rv64gc"},
        "input_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "expected_output_sha256": {"$ref": "#/$defs/sha256"},
        "baseline": {"$ref": "#/$defs/leg"},
        "optimized": {"$ref": "#/$defs/leg"}
      }
    }
  }
}
