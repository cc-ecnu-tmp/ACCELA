{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/candidate-fast-study.v1.json",
  "title": "ACCELA fast campaign bound stage study v1",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "campaign_id", "generated_at", "stage",
    "bootstrap_sha256", "plan_sha256", "index_sha256", "baseline",
    "primary_metric_id", "metric_unit", "planned_candidate_ids",
    "evaluated_candidate_ids", "candidates", "study_commitment_sha256"
  ],
  "properties": {
    "schema_version": {"const": "candidate-fast-study.v1"},
    "study_id": {"$ref": "#/$defs/id"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "generated_at": {"type": "string", "format": "date-time"},
    "stage": {"enum": ["B2", "B3", "B4", "B5", "B6"]},
    "bootstrap_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "index_sha256": {"$ref": "#/$defs/sha256"},
    "baseline": {"$ref": "#/$defs/receipt_ref"},
    "primary_metric_id": {"$ref": "#/$defs/id"},
    "metric_unit": {"type": "string", "minLength": 1, "maxLength": 64},
    "planned_candidate_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "evaluated_candidate_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate_result"}},
    "study_commitment_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_positive": {"oneOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]},
    "nullable_reason": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 256}]},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "canonical_sha256", "physical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "receipt_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "task_id", "run_id", "receipt", "terminal_commitment_sha256"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "task_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "receipt": {"$ref": "#/$defs/artifact"},
        "terminal_commitment_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate_result": {
      "type": "object", "additionalProperties": false,
      "required": [
        "candidate_id", "receipt", "correctness_passed", "metrics_complete",
        "comparable_case_count", "geometric_mean_speedup", "eligible", "ineligibility_reason",
        "per_cases", "static_text_bytes_full", "static_text_bytes_full_plus_candidate",
        "static_text_ratio"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "receipt": {"$ref": "#/$defs/receipt_ref"},
        "correctness_passed": {"type": "boolean"},
        "metrics_complete": {"type": "boolean"},
        "comparable_case_count": {"type": "integer", "minimum": 0},
        "geometric_mean_speedup": {"$ref": "#/$defs/nullable_positive"},
        "eligible": {"type": "boolean"},
        "ineligibility_reason": {"$ref": "#/$defs/nullable_reason"}
        ,"per_cases": {"type": "array", "items": {"$ref": "#/$defs/per_case"}}
        ,"static_text_bytes_full": {"$ref": "#/$defs/nullable_positive"}
        ,"static_text_bytes_full_plus_candidate": {"$ref": "#/$defs/nullable_positive"}
        ,"static_text_ratio": {"$ref": "#/$defs/nullable_positive"}
      }
    },
    "per_case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "weight", "speedup"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "speedup": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
