{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/candidate-campaign-status.v1.json",
  "title": "ACCELA authoritative B1-B6 candidate campaign status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "campaign_id", "plan_sha256", "execution_environment_sha256", "analyzer", "previous_status_sha256",
    "state", "started_at", "as_of", "raw_evidence_registry", "tasks", "ready_tasks", "diagnostic_plan"
  ],
  "properties": {
    "schema_version": {"const": "candidate-campaign-status.v1"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "execution_environment_sha256": {"$ref": "#/$defs/sha256"},
    "analyzer": {"$ref": "#/$defs/analyzer_contract"},
    "previous_status_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "state": {"enum": ["pending", "running", "completed", "failed", "interrupted"]},
    "started_at": {"type": "string", "format": "date-time"},
    "as_of": {"type": "string", "format": "date-time"},
    "raw_evidence_registry": {"$ref": "#/$defs/artifact"},
    "tasks": {"type": "array", "minItems": 16, "items": {"$ref": "#/$defs/task_status"}},
    "ready_tasks": {
      "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}
    },
    "diagnostic_plan": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/diagnostic_plan"}]
    }
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "nullable_time": {
      "oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
    },
    "nullable_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "analyzer_command": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "command_sha256", "executable"],
      "properties": {
        "argv": {
          "type": "array", "minItems": 15, "maxItems": 19,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "command_sha256": {"$ref": "#/$defs/sha256"},
        "executable": {"const": "python"}
      }
    },
    "analyzer_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "adapter", "environment_keys", "commands"],
      "properties": {
        "contract_version": {"const": "candidate-binary-analyzer.v1"},
        "adapter": {"const": "host"},
        "environment_keys": {"type": "array", "maxItems": 0},
        "commands": {
          "type": "object", "additionalProperties": false,
          "required": ["accela", "gcc", "clang"],
          "properties": {
            "accela": {"$ref": "#/$defs/analyzer_command"},
            "gcc": {"$ref": "#/$defs/analyzer_command"},
            "clang": {"$ref": "#/$defs/analyzer_command"}
          }
        }
      }
    },
    "task_status": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_id", "status", "evidence_kind", "evidence_sha256", "evidence_physical_sha256", "evidence_path", "started_at",
        "completed_at", "ineligibility_reason"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["pending", "running", "completed", "failed", "interrupted", "ineligible"]},
        "evidence_kind": {
          "oneOf": [{"type": "null"}, {"enum": ["run-record.v1", "candidate-study.v1", "candidate-freeze.v1", "candidate-final.v1"]}]
        },
        "evidence_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "evidence_physical_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "evidence_path": {"$ref": "#/$defs/nullable_path"},
        "started_at": {"$ref": "#/$defs/nullable_time"},
        "completed_at": {"$ref": "#/$defs/nullable_time"},
        "ineligibility_reason": {"$ref": "#/$defs/nullable_id"}
      }
    },
    "diagnostic_task": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_id", "kind", "candidate_ids", "run_id", "data_role",
        "measurement_mode", "logical_profile_id", "profile_sha256", "configuration_sha256", "profile_path",
        "ranking_evidence", "dependencies", "status", "evidence_sha256",
        "evidence_physical_sha256", "evidence_path", "started_at", "completed_at", "failure_reason"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["pair", "cache_hotblock"]},
        "candidate_ids": {
          "type": "array", "maxItems": 2, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "run_id": {"$ref": "#/$defs/id"},
        "data_role": {"const": "B3"},
        "measurement_mode": {"enum": ["standard_proxy", "cache_hotblock"]},
        "logical_profile_id": {"$ref": "#/$defs/id"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "profile_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "ranking_evidence": {"const": false},
        "dependencies": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "status": {"enum": ["pending", "running", "completed", "failed", "interrupted"]},
        "evidence_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "evidence_physical_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "evidence_path": {"$ref": "#/$defs/nullable_path"},
        "started_at": {"$ref": "#/$defs/nullable_time"},
        "completed_at": {"$ref": "#/$defs/nullable_time"},
        "failure_reason": {
          "oneOf": [{"type": "null"}, {"enum": ["correctness_failure", "timeout", "tool_failure"]}]
        }
      }
    },
    "diagnostic_study_task": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_id", "dependencies", "status", "evidence_kind",
        "evidence_sha256", "evidence_physical_sha256", "evidence_path", "started_at",
        "completed_at", "ineligibility_reason"
      ],
      "properties": {
        "task_id": {"const": "diagnostic.study"},
        "dependencies": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"$ref": "#/$defs/id"}
        },
        "status": {"enum": ["pending", "completed", "ineligible"]},
        "evidence_kind": {
          "oneOf": [{"type": "null"}, {"const": "candidate-study.v1"}]
        },
        "evidence_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "evidence_physical_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "evidence_path": {"$ref": "#/$defs/nullable_path"},
        "started_at": {"$ref": "#/$defs/nullable_time"},
        "completed_at": {"$ref": "#/$defs/nullable_time"},
        "ineligibility_reason": {
          "oneOf": [
            {"type": "null"},
            {"const": "fewer_than_two_top3"}
          ]
        }
      }
    },
    "diagnostic_plan": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_freeze_sha256", "source_study_sha256", "matrix",
        "top3_candidate_ids", "tasks", "study"
      ],
      "properties": {
        "source_freeze_sha256": {"$ref": "#/$defs/sha256"},
        "source_study_sha256": {"$ref": "#/$defs/sha256"},
        "matrix": {"$ref": "#/$defs/artifact"},
        "top3_candidate_ids": {
          "type": "array", "maxItems": 3, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "tasks": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"$ref": "#/$defs/diagnostic_task"}},
        "study": {"$ref": "#/$defs/diagnostic_study_task"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "canonical_sha256", "physical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullable_path": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 4096}
      ]
    }
  }
}
