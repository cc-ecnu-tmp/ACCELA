{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/benchmark-manifest.v1.json",
  "title": "ACCELA benchmark manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "provenance", "cases", "data_quality"],
  "properties": {
    "schema_version": {"const": "benchmark-manifest.v1"},
    "suite_id": {"$ref": "#/$defs/id"},
    "captured_at": {"type": "string", "format": "date-time"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    },
    "data_quality": {"$ref": "#/$defs/data_quality"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\\\]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["included", "included_with_exclusions", "excluded"]},
        "reason": {"enum": ["verified", "packaging_defect", "unsupported", "manual_exclusion", "unknown"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_role", "validity", "origin", "license", "derived_from"],
      "properties": {
        "data_role": {"enum": ["B1", "B2", "B3", "B4", "B5", "B6", "oracle"]},
        "validity": {"$ref": "#/$defs/validity"},
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "snapshot_sha256"],
          "properties": {
            "source_id": {"$ref": "#/$defs/id"},
            "snapshot_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx_expression"],
          "properties": {
            "spdx_expression": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "derived_from": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["suite_id", "manifest_sha256", "origin_source_id", "origin_snapshot_sha256"],
              "properties": {
                "suite_id": {"$ref": "#/$defs/id"},
                "manifest_sha256": {"$ref": "#/$defs/sha256"},
                "origin_source_id": {"$ref": "#/$defs/id"},
                "origin_snapshot_sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          ]
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "logical_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_id", "suffix", "role", "sha256", "size_bytes", "provenance"],
      "properties": {
        "logical_id": {"$ref": "#/$defs/relative_path"},
        "suffix": {"type": "string", "pattern": "^\\.[A-Za-z0-9._-]+$"},
        "role": {"enum": ["source", "input", "expected_output", "orphan"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "duplicate_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes", "members"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "members": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/logical_file"}
        }
      }
    },
    "source_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_group", "source_sha256", "case_count", "members", "families"],
      "properties": {
        "source_group": {"$ref": "#/$defs/id"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "case_count": {"type": "integer", "minimum": 1},
        "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "family_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "target", "case_count", "distinct_source_groups"],
      "properties": {
        "family": {"$ref": "#/$defs/id"},
        "target": {"const": "rv64gc"},
        "case_count": {"type": "integer", "minimum": 1},
        "distinct_source_groups": {"type": "integer", "minimum": 1}
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orphan_count", "duplicate_group_count", "source_group_count",
        "orphan_sidecars", "duplicate_file_groups", "source_groups", "family_groups"
      ],
      "properties": {
        "orphan_count": {"type": "integer", "minimum": 0},
        "duplicate_group_count": {"type": "integer", "minimum": 0},
        "source_group_count": {"type": "integer", "minimum": 1},
        "orphan_sidecars": {
          "type": "array",
          "items": {"$ref": "#/$defs/logical_file"}
        },
        "duplicate_file_groups": {
          "type": "array",
          "items": {"$ref": "#/$defs/duplicate_group"}
        },
        "source_groups": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_group"}
        },
        "family_groups": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/family_group"}
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "family", "source_group", "target", "weight", "source", "input",
        "expected_output", "tags", "provenance"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "family": {"$ref": "#/$defs/id"},
        "source_group": {"$ref": "#/$defs/id"},
        "target": {"const": "rv64gc"},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "source": {"$ref": "#/$defs/file"},
        "input": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/file"}]},
        "expected_output": {"$ref": "#/$defs/file"},
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "oracle_pair": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pair_id", "leg", "counterpart_case_id"],
          "properties": {
            "pair_id": {"$ref": "#/$defs/id"},
            "leg": {"enum": ["baseline", "optimized"]},
            "counterpart_case_id": {"$ref": "#/$defs/id"}
          }
        }
      }
    }
  }
}
