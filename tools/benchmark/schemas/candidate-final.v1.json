{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/candidate-final.v1.json",
  "title": "ACCELA multi-suite candidate final ranking v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "final_id", "generated_at", "screening_sha256",
    "candidate_registry_sha256", "executable_pass_registry_sha256",
    "matrix_sha256", "expected_combined_case_count",
    "campaign", "b1_full_correctness", "freeze", "studies", "diagnostics", "candidates", "ranking", "winner_candidate_id", "winner_reason"
  ],
  "properties": {
    "schema_version": {"const": "candidate-final.v1"},
    "final_id": {"$ref": "#/$defs/id"},
    "generated_at": {"type": "string", "format": "date-time"},
    "screening_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_registry_sha256": {"$ref": "#/$defs/sha256"},
    "executable_pass_registry_sha256": {"$ref": "#/$defs/sha256"},
    "matrix_sha256": {"$ref": "#/$defs/sha256"},
    "expected_combined_case_count": {"const": 267},
    "campaign": {"$ref": "#/$defs/campaign"},
    "b1_full_correctness": {"$ref": "#/$defs/b1_correctness"},
    "freeze": {"$ref": "#/$defs/freeze"},
    "winner_candidate_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "winner_reason": {"enum": ["top_combined_gm_above_one", "no_winning_candidate"]},
    "studies": {
      "type": "object", "additionalProperties": false,
      "required": ["B2", "B3", "B4", "B5", "B6"],
      "properties": {
        "B2": {"$ref": "#/$defs/study_ref"},
        "B3": {"$ref": "#/$defs/study_ref"},
        "B4": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/study_ref"}]},
        "B5": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/study_ref"}]},
        "B6": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/study_ref"}]}
      }
    },
    "diagnostics": {"$ref": "#/$defs/diagnostic_plan"},
    "candidates": {
      "type": "array", "minItems": 11, "maxItems": 11,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "ranking": {"type": "array", "items": {"$ref": "#/$defs/rank"}}
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_digest": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "canonical_sha256", "physical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "binary_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "physical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "campaign_run": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "run_id", "run_sha256", "run_physical_sha256", "state"],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "run_sha256": {"$ref": "#/$defs/sha256"},
        "run_physical_sha256": {"$ref": "#/$defs/sha256"},
        "state": {"enum": ["completed", "failed", "interrupted"]}
      }
    },
    "campaign": {
      "type": "object", "additionalProperties": false,
      "required": [
        "plan_sha256", "status_sha256", "status_ledger_entry_count",
        "status_ledger_head_sha256", "status_ledger_sha256", "raw_evidence_registry", "run_records"
      ],
      "properties": {
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "status_sha256": {"$ref": "#/$defs/sha256"},
        "status_ledger_entry_count": {"type": "integer", "minimum": 1},
        "status_ledger_head_sha256": {"$ref": "#/$defs/sha256"},
        "status_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "raw_evidence_registry": {"$ref": "#/$defs/artifact_digest"},
        "run_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/campaign_run"}}
      }
    },
    "diagnostic_task": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_id", "kind", "candidate_ids", "run_id", "data_role",
        "measurement_mode", "logical_profile_id", "profile_sha256",
        "configuration_sha256", "profile_path", "ranking_evidence", "dependencies", "status",
        "evidence_sha256", "evidence_physical_sha256", "started_at",
        "completed_at", "failure_reason"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["pair", "cache_hotblock"]},
        "candidate_ids": {
          "type": "array", "maxItems": 2, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "run_id": {"$ref": "#/$defs/id"},
        "data_role": {"const": "B3"},
        "measurement_mode": {"enum": ["standard_proxy", "cache_hotblock"]},
        "logical_profile_id": {"$ref": "#/$defs/id"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "profile_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "ranking_evidence": {"const": false},
        "dependencies": {
          "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "status": {"enum": ["completed", "failed", "interrupted"]},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_physical_sha256": {"$ref": "#/$defs/sha256"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "failure_reason": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["correctness_failure", "timeout", "tool_failure"]}
          ]
        }
      }
    },
    "diagnostic_plan": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_freeze_sha256", "source_study_sha256", "matrix",
        "top3_candidate_ids", "tasks", "study_status",
        "study_ineligibility_reason", "study"
      ],
      "properties": {
        "source_freeze_sha256": {"$ref": "#/$defs/sha256"},
        "source_study_sha256": {"$ref": "#/$defs/sha256"},
        "matrix": {"$ref": "#/$defs/artifact_digest"},
        "top3_candidate_ids": {
          "type": "array", "maxItems": 3, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "tasks": {
          "type": "array", "minItems": 1, "maxItems": 7,
          "items": {"$ref": "#/$defs/diagnostic_task"}
        },
        "study_status": {"enum": ["completed", "ineligible"]},
        "study_ineligibility_reason": {
          "oneOf": [
            {"type": "null"},
            {"const": "fewer_than_two_top3"}
          ]
        },
        "study": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/diagnostic_study_ref"}]
        }
      }
    },
    "diagnostic_study_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["study_id", "path", "canonical_sha256", "physical_sha256"],
      "properties": {
        "study_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullable_positive": {"oneOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]},
    "nullable_rank": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
    "freeze": {
      "type": "object", "additionalProperties": false,
      "required": [
        "freeze_id", "freeze_sha256", "artifact", "campaign_id", "run_namespace",
        "repo_commit", "repo_tree", "compiler_artifact",
        "candidate_registry", "executable_pass_registry",
        "screening_base_pass_registry", "matrix", "screening",
        "oracle_capture", "run_record_schema", "candidate_study_schema",
        "base_pipeline_profile", "suite_manifests", "standard_measurement_protocol",
        "hotblock_measurement_protocol", "reference_toolchain",
        "raw_evidence_registry",
        "frozen_candidate_ids_sha256",
        "b2_study_sha256", "freeze_status_ledger_entry_count",
        "freeze_status_ledger_head_sha256", "freeze_status_ledger_sha256", "b1_full_run_sha256", "b1_passed_candidate_ids",
        "b1_failed_candidate_ids", "oracle_threshold", "b3_strict_threshold",
        "combined_case_count", "ranking_rule"
      ],
      "properties": {
        "freeze_id": {"$ref": "#/$defs/id"},
        "freeze_sha256": {"$ref": "#/$defs/sha256"},
        "artifact": {"$ref": "#/$defs/artifact_digest"},
        "campaign_id": {"$ref": "#/$defs/id"},
        "run_namespace": {"type": "string", "minLength": 2, "maxLength": 512},
        "repo_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "repo_tree": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "compiler_artifact": {"$ref": "#/$defs/binary_artifact"},
        "candidate_registry": {"$ref": "#/$defs/artifact_digest"},
        "executable_pass_registry": {"$ref": "#/$defs/artifact_digest"},
        "screening_base_pass_registry": {"$ref": "#/$defs/artifact_digest"},
        "matrix": {"$ref": "#/$defs/artifact_digest"},
        "screening": {"$ref": "#/$defs/artifact_digest"},
        "oracle_capture": {"$ref": "#/$defs/artifact_digest"},
        "run_record_schema": {"$ref": "#/$defs/artifact_digest"},
        "candidate_study_schema": {"$ref": "#/$defs/artifact_digest"},
        "base_pipeline_profile": {"$ref": "#/$defs/artifact_digest"},
        "suite_manifests": {
          "type": "object", "additionalProperties": false,
          "required": ["B1", "B2", "B3", "B4", "B5", "B6"],
          "properties": {
            "B1": {"$ref": "#/$defs/artifact_digest"},
            "B2": {"$ref": "#/$defs/artifact_digest"},
            "B3": {"$ref": "#/$defs/artifact_digest"},
            "B4": {"$ref": "#/$defs/artifact_digest"},
            "B5": {"$ref": "#/$defs/artifact_digest"},
            "B6": {"$ref": "#/$defs/artifact_digest"}
          }
        },
        "standard_measurement_protocol": {"$ref": "#/$defs/artifact_digest"},
        "hotblock_measurement_protocol": {"$ref": "#/$defs/artifact_digest"},
        "reference_toolchain": {"$ref": "#/$defs/reference_toolchain_context"},
        "raw_evidence_registry": {"$ref": "#/$defs/artifact_digest"},
        "frozen_candidate_ids_sha256": {"$ref": "#/$defs/sha256"},
        "b2_study_sha256": {"$ref": "#/$defs/sha256"},
        "freeze_status_ledger_entry_count": {"type": "integer", "minimum": 1},
        "freeze_status_ledger_head_sha256": {"$ref": "#/$defs/sha256"},
        "freeze_status_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "b1_full_run_sha256": {"$ref": "#/$defs/sha256"},
        "b1_passed_candidate_ids": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}
        },
        "b1_failed_candidate_ids": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}
        },
        "oracle_threshold": {"const": 1.1},
        "b3_strict_threshold": {"const": 1.0},
        "combined_case_count": {"const": 267},
        "ranking_rule": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "prefixItems": [
            {"const": "combined_geometric_mean_desc"},
            {"const": "b3_geometric_mean_desc"},
            {"const": "static_text_bytes_asc"},
            {"const": "stable_candidate_id_asc"}
          ]
        }
      }
    },
    "reference_toolchain_context": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot", "common_tool_versions", "accela_jdk_version", "baselines"],
      "properties": {
        "snapshot": {"$ref": "#/$defs/artifact_digest"},
        "common_tool_versions": {
          "type": "object", "additionalProperties": false,
          "required": ["qemu-system-riscv64", "bare-metal-linker", "python", "glib"],
          "properties": {
            "qemu-system-riscv64": {"type": "string", "minLength": 1, "maxLength": 256},
            "bare-metal-linker": {"type": "string", "minLength": 1, "maxLength": 256},
            "python": {"type": "string", "minLength": 1, "maxLength": 256},
            "glib": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "accela_jdk_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "baselines": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/reference_baseline_context"}
        }
      }
    },
    "reference_baseline_context": {
      "type": "object", "additionalProperties": false,
      "required": [
        "compiler_baseline", "profile_id", "profile_sha256", "tool", "version",
        "optimization", "compiler_command_sha256", "compiler_argv_sha256"
      ],
      "properties": {
        "compiler_baseline": {"enum": ["gcc_13_3_o2", "clang_18_o3"]},
        "profile_id": {"enum": ["gcc-13.3-o2", "clang-18-o3"]},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "tool": {"enum": ["riscv-gcc", "clang"]},
        "version": {"enum": ["13.3.0", "18.1.3"]},
        "optimization": {"enum": ["-O2", "-O3"]},
        "compiler_command_sha256": {"$ref": "#/$defs/sha256"},
        "compiler_argv_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "study_ref": {
      "type": "object", "additionalProperties": false,
      "required": [
        "study_id", "path", "study_sha256", "physical_sha256", "suite_id", "manifest_sha256", "candidate_count",
        "baseline_run_id", "baseline_run_sha256", "baseline_configuration_sha256"
      ],
      "properties": {
        "study_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "study_sha256": {"$ref": "#/$defs/sha256"},
        "physical_sha256": {"$ref": "#/$defs/sha256"},
        "suite_id": {"$ref": "#/$defs/id"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_count": {"type": "integer", "minimum": 0},
        "baseline_run_id": {"$ref": "#/$defs/id"},
        "baseline_run_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_configuration_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": [
        "study_id", "run_id", "run_sha256", "configuration_sha256",
        "suite_id", "manifest_sha256", "expected_case_count",
        "eligible_for_ranking", "ineligibility_reason", "comparable_cases",
        "comparable_source_groups", "correctness_failures", "censored_cases",
        "excluded_cases", "case_geometric_mean_speedup",
        "source_group_geometric_mean_speedup", "confidence_interval_95",
        "static_text_bytes_full", "static_text_bytes_full_plus_candidate",
        "static_text_ratio"
      ],
      "properties": {
        "study_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "run_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "suite_id": {"$ref": "#/$defs/id"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "expected_case_count": {"enum": [20, 59, 60, 88]},
        "eligible_for_ranking": {"type": "boolean"},
        "ineligibility_reason": {
          "oneOf": [
            {"type": "null"},
            {"enum": [
              "correctness_failure", "incomplete_profile", "right_censored",
              "no_comparable_cases", "no_candidate_observation"
            ]}
          ]
        },
        "comparable_cases": {"type": "integer", "minimum": 0},
        "comparable_source_groups": {"type": "integer", "minimum": 0},
        "correctness_failures": {"type": "integer", "minimum": 0},
        "censored_cases": {"type": "integer", "minimum": 0},
        "excluded_cases": {"type": "integer", "minimum": 0},
        "case_geometric_mean_speedup": {"$ref": "#/$defs/nullable_positive"},
        "source_group_geometric_mean_speedup": {"$ref": "#/$defs/nullable_positive"},
        "confidence_interval_95": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["low", "high"],
              "properties": {
                "low": {"type": "number", "exclusiveMinimum": 0},
                "high": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          ]
        },
        "static_text_bytes_full": {"$ref": "#/$defs/nullable_positive"},
        "static_text_bytes_full_plus_candidate": {"$ref": "#/$defs/nullable_positive"},
        "static_text_ratio": {"$ref": "#/$defs/nullable_positive"}
      }
    },
    "b1_correctness": {
      "type": "object", "additionalProperties": false,
      "required": [
        "run_id", "run_sha256", "configuration_sha256", "suite_id",
        "manifest_sha256", "case_count", "evidence_level", "state",
        "passed_cases", "failed_cases", "pending_cases", "censored_cases",
        "all_correct", "failure_reason"
      ],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "run_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "suite_id": {"$ref": "#/$defs/id"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "case_count": {"const": 140},
        "evidence_level": {"const": "qemu_correctness"},
        "state": {"enum": ["completed", "failed", "interrupted"]},
        "passed_cases": {"type": "integer", "minimum": 0, "maximum": 140},
        "failed_cases": {"type": "integer", "minimum": 0, "maximum": 140},
        "pending_cases": {"type": "integer", "minimum": 0, "maximum": 140},
        "censored_cases": {"type": "integer", "minimum": 0, "maximum": 140},
        "all_correct": {"type": "boolean"},
        "failure_reason": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["correctness_failure", "timeout", "tool_failure"]}
          ]
        }
      }
    },
    "suite_outcomes": {
      "type": "object", "additionalProperties": false,
      "required": ["B3", "B4", "B5", "B6"],
      "properties": {
        "B3": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/outcome"}]},
        "B4": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/outcome"}]},
        "B5": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/outcome"}]},
        "B6": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/outcome"}]}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "candidate_id", "oracle_family_id", "implementation_candidate_id",
        "screening_status", "screening_rejection_reasons",
        "b1_correctness", "b2_tuning", "suite_outcomes",
        "eligible_for_final", "final_ineligibility_reasons", "combined_case_count",
        "combined_case_geometric_mean_speedup", "b3_case_geometric_mean_speedup",
        "combined_static_text_bytes_full_plus_candidate", "combined_static_text_ratio", "rank"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "oracle_family_id": {"$ref": "#/$defs/id"},
        "implementation_candidate_id": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]
        },
        "screening_status": {"enum": ["qualified", "blocked", "rejected"]},
        "screening_rejection_reasons": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "b1_correctness": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/b1_correctness"}]
        },
        "b2_tuning": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/outcome"}]
        },
        "suite_outcomes": {"$ref": "#/$defs/suite_outcomes"},
        "eligible_for_final": {"type": "boolean"},
        "final_ineligibility_reasons": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": [
            "screening_not_qualified", "b1_not_correct", "missing_b3_evidence", "b3_not_above_one",
            "missing_validation_suite", "suite_ineligible", "combined_case_count_not_267",
            "missing_static_text_evidence"
          ]}
        },
        "combined_case_count": {"type": "integer", "minimum": 0},
        "combined_case_geometric_mean_speedup": {"$ref": "#/$defs/nullable_positive"},
        "b3_case_geometric_mean_speedup": {"$ref": "#/$defs/nullable_positive"},
        "combined_static_text_bytes_full_plus_candidate": {"$ref": "#/$defs/nullable_positive"},
        "combined_static_text_ratio": {"$ref": "#/$defs/nullable_positive"},
        "rank": {"$ref": "#/$defs/nullable_rank"}
      }
    },
    "rank": {
      "type": "object", "additionalProperties": false,
      "required": [
        "rank", "candidate_id", "combined_case_geometric_mean_speedup",
        "b3_case_geometric_mean_speedup", "combined_static_text_bytes_full_plus_candidate",
        "combined_static_text_ratio",
        "stable_id_tiebreak"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "candidate_id": {"$ref": "#/$defs/id"},
        "combined_case_geometric_mean_speedup": {"type": "number", "exclusiveMinimum": 0},
        "b3_case_geometric_mean_speedup": {"type": "number", "exclusiveMinimum": 0},
        "combined_static_text_bytes_full_plus_candidate": {"type": "number", "exclusiveMinimum": 0},
        "combined_static_text_ratio": {"type": "number", "exclusiveMinimum": 0},
        "stable_id_tiebreak": {"$ref": "#/$defs/id"}
      }
    }
  }
}
