{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/cross-suite-audit.v1.json",
  "title": "ACCELA cross-suite content audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "left", "right", "identical_content_multiset", "renamed", "counts", "mappings"],
  "properties": {
    "schema_version": {"const": "cross-suite-audit.v1"},
    "left": {"$ref": "#/$defs/suite"},
    "right": {"$ref": "#/$defs/suite"},
    "identical_content_multiset": {"type": "boolean"},
    "renamed": {"type": "boolean"},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["left_cases", "right_cases", "shared_content_groups", "matched_cases", "left_only_cases", "right_only_cases"],
      "properties": {
        "left_cases": {"type": "integer", "minimum": 0},
        "right_cases": {"type": "integer", "minimum": 0},
        "shared_content_groups": {"type": "integer", "minimum": 0},
        "matched_cases": {"type": "integer", "minimum": 0},
        "left_only_cases": {"type": "integer", "minimum": 0},
        "right_only_cases": {"type": "integer", "minimum": 0}
      }
    },
    "mappings": {"type": "array", "items": {"$ref": "#/$defs/mapping"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "suite": {
      "type": "object", "additionalProperties": false,
      "required": ["suite_id", "manifest_sha256"],
      "properties": {"suite_id": {"$ref": "#/$defs/id"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["source_sha256", "input_sha256", "expected_output_sha256", "left_case_ids", "right_case_ids", "matched_count", "left_only_count", "right_only_count", "status"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "input_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "expected_output_sha256": {"$ref": "#/$defs/sha256"},
        "left_case_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "right_case_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "matched_count": {"type": "integer", "minimum": 0},
        "left_only_count": {"type": "integer", "minimum": 0},
        "right_only_count": {"type": "integer", "minimum": 0},
        "status": {"enum": ["identical", "multiplicity_mismatch", "left_only", "right_only"]}
      }
    }
  }
}
