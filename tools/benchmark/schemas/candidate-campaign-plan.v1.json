{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/candidate-campaign-plan.v1.json",
  "title": "ACCELA authoritative B1-B6 candidate campaign DAG v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "campaign_id", "run_namespace", "repository", "measurement_protocol", "artifacts",
    "reference_toolchain",
    "run_record_schema_sha256", "candidate_study_schema_sha256",
    "candidate_freeze_schema_sha256", "candidate_raw_evidence_schema_sha256",
    "raw_state_root", "base_pipeline_profile", "suites",
    "study_ids", "qualified_candidate_ids", "tasks"
  ],
  "properties": {
    "schema_version": {"const": "candidate-campaign-plan.v1"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "run_namespace": {"type": "string", "minLength": 2, "maxLength": 512},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["repo_commit", "repo_tree", "compiler_artifact"],
      "properties": {
        "repo_commit": {"$ref": "#/$defs/object_id"},
        "repo_tree": {"$ref": "#/$defs/object_id"},
        "compiler_artifact": {"$ref": "#/$defs/binary_artifact"}
      }
    },
    "measurement_protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_id", "protocol_sha256", "artifact"],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/id"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "reference_toolchain": {"$ref": "#/$defs/reference_toolchain"},
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "candidate_registry", "executable_pass_registry",
        "screening_base_pass_registry", "matrix", "screening"
      ],
      "properties": {
        "candidate_registry": {"$ref": "#/$defs/artifact"},
        "executable_pass_registry": {"$ref": "#/$defs/artifact"},
        "screening_base_pass_registry": {"$ref": "#/$defs/artifact"},
        "matrix": {"$ref": "#/$defs/artifact"},
        "screening": {"$ref": "#/$defs/artifact"}
      }
    },
    "run_record_schema_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_study_schema_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_freeze_schema_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_raw_evidence_schema_sha256": {"$ref": "#/$defs/sha256"},
    "raw_state_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "base_pipeline_profile": {"$ref": "#/$defs/profile"},
    "suites": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {"$ref": "#/$defs/suite"}
    },
    "study_ids": {
      "type": "object", "additionalProperties": false,
      "required": ["B2", "B3", "B4", "B5", "B6"],
      "properties": {
        "B2": {"$ref": "#/$defs/id"}, "B3": {"$ref": "#/$defs/id"},
        "B4": {"$ref": "#/$defs/id"}, "B5": {"$ref": "#/$defs/id"},
        "B6": {"$ref": "#/$defs/id"}
      }
    },
    "qualified_candidate_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "tasks": {"type": "array", "minItems": 16, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_id": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "nullable_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "nullable_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "nullable_path": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 4096}
      ]
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "canonical_sha256", "physical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "binary_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "physical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "profile_sha256", "path", "physical_sha256"],
      "properties": {
        "profile_id": {"const": "candidate-empty"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tool_versions": {
      "type": "object", "additionalProperties": false,
      "required": ["qemu-system-riscv64", "bare-metal-linker", "python", "glib"],
      "properties": {
        "qemu-system-riscv64": {"type": "string", "minLength": 1, "maxLength": 256},
        "bare-metal-linker": {"type": "string", "minLength": 1, "maxLength": 256},
        "python": {"type": "string", "minLength": 1, "maxLength": 256},
        "glib": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "reference_baseline": {
      "type": "object", "additionalProperties": false,
      "required": [
        "compiler_baseline", "profile_id", "profile_sha256", "tool", "version",
        "optimization", "compiler_executable", "compiler_command_sha256",
        "compiler_argv_sha256"
      ],
      "properties": {
        "compiler_baseline": {"enum": ["gcc_13_3_o2", "clang_18_o3"]},
        "profile_id": {"enum": ["gcc-13.3-o2", "clang-18-o3"]},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "tool": {"enum": ["riscv-gcc", "clang"]},
        "version": {"enum": ["13.3.0", "18.1.3"]},
        "optimization": {"enum": ["-O2", "-O3"]},
        "compiler_executable": {"const": "sh"},
        "compiler_command_sha256": {"$ref": "#/$defs/sha256"},
        "compiler_argv_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reference_toolchain": {
      "type": "object", "additionalProperties": false,
      "required": [
        "snapshot", "compile_driver_sha256", "source_adapter_sha256",
        "builtin_header_sha256", "image_id", "named_volume_contract",
        "candidate_toolchain", "common_tool_versions",
        "accela_jdk_version", "baselines"
      ],
      "properties": {
        "snapshot": {"$ref": "#/$defs/artifact"},
        "compile_driver_sha256": {"$ref": "#/$defs/sha256"},
        "source_adapter_sha256": {"$ref": "#/$defs/sha256"},
        "builtin_header_sha256": {"$ref": "#/$defs/sha256"},
        "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "named_volume_contract": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "required_labels"],
          "properties": {
            "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,254}$"},
            "required_labels": {
              "type": "object", "additionalProperties": false,
              "required": ["org.accela.campaign", "org.accela.purpose"],
              "properties": {
                "org.accela.campaign": {"type": "string", "minLength": 1, "maxLength": 255},
                "org.accela.purpose": {"type": "string", "minLength": 1, "maxLength": 255}
              }
            }
          }
        },
        "candidate_toolchain": {"$ref": "#/$defs/candidate_toolchain"},
        "common_tool_versions": {"$ref": "#/$defs/tool_versions"},
        "accela_jdk_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "baselines": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/reference_baseline"}
        }
      }
    },
    "candidate_toolchain": {
      "type": "object", "additionalProperties": false,
      "required": [
        "base_image_tag", "base_image_id", "dockerfile_path", "dockerfile_sha256",
        "docker_cli", "image_tag", "image_id", "rootfs_layers"
      ],
      "properties": {
        "base_image_tag": {"type": "string", "minLength": 1, "maxLength": 256},
        "base_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "dockerfile_path": {"const": "tools/benchmark/candidate-toolchain.Dockerfile"},
        "dockerfile_sha256": {"$ref": "#/$defs/sha256"},
        "docker_cli": {
          "type": "object", "additionalProperties": false,
          "required": ["install_path_id", "sha256", "version", "version_output"],
          "properties": {
            "install_path_id": {"const": "usr-local-bin-docker-v1"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){2}$"},
            "version_output": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "image_tag": {"type": "string", "minLength": 1, "maxLength": 256},
        "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "rootfs_layers": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "suite": {
      "type": "object", "additionalProperties": false,
      "required": ["data_role", "suite_id", "manifest", "case_count"],
      "properties": {
        "data_role": {"enum": ["B1", "B2", "B3", "B4", "B5", "B6"]},
        "suite_id": {"$ref": "#/$defs/id"},
        "manifest": {"$ref": "#/$defs/artifact"},
        "case_count": {"enum": [20, 59, 60, 88, 140]}
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "candidate_id"],
      "properties": {
        "kind": {"enum": ["always", "b1_completed", "b2_formal_complete", "b3_promoted", "b3_has_promoted"]},
        "candidate_id": {"$ref": "#/$defs/nullable_id"}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_id", "task_type", "stage", "kind", "candidate_ids", "data_role",
        "run_id", "logical_profile_id", "candidate_profile_sha256",
        "candidate_profile_path", "reference_profile_id", "dependencies",
        "terminal_dependencies", "gate", "ranking_evidence"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "task_type": {"enum": ["run", "study", "freeze", "final"]},
        "stage": {"enum": ["B1", "B2", "freeze", "B3", "B4", "B5", "B6", "final"]},
        "kind": {"enum": ["candidate_empty", "single", "reference", "study", "freeze", "final"]},
        "candidate_ids": {
          "type": "array", "maxItems": 2, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "data_role": {"oneOf": [{"type": "null"}, {"enum": ["B1", "B2", "B3", "B4", "B5", "B6"]}]},
        "run_id": {"$ref": "#/$defs/nullable_id"},
        "logical_profile_id": {"$ref": "#/$defs/nullable_id"},
        "candidate_profile_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "candidate_profile_path": {"$ref": "#/$defs/nullable_path"},
        "reference_profile_id": {
          "oneOf": [{"type": "null"}, {"enum": ["gcc-13.3-o2", "clang-18-o3"]}]
        },
        "dependencies": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}
        },
        "terminal_dependencies": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}
        },
        "gate": {"$ref": "#/$defs/gate"},
        "ranking_evidence": {"type": "boolean"}
      }
    }
  }
}
