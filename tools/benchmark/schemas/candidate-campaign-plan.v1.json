{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/candidate-campaign-plan.v1.json",
  "title": "ACCELA authoritative B1-B6 candidate campaign DAG v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "campaign_id", "run_namespace", "repository", "measurement_protocol", "artifacts",
    "run_record_schema_sha256", "candidate_study_schema_sha256",
    "candidate_freeze_schema_sha256", "candidate_raw_evidence_schema_sha256",
    "raw_state_root", "base_pipeline_profile", "suites",
    "study_ids", "qualified_candidate_ids", "tasks"
  ],
  "properties": {
    "schema_version": {"const": "candidate-campaign-plan.v1"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "run_namespace": {"type": "string", "minLength": 2, "maxLength": 512},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["repo_commit", "repo_tree", "compiler_artifact"],
      "properties": {
        "repo_commit": {"$ref": "#/$defs/object_id"},
        "repo_tree": {"$ref": "#/$defs/object_id"},
        "compiler_artifact": {"$ref": "#/$defs/binary_artifact"}
      }
    },
    "measurement_protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_id", "protocol_sha256", "artifact"],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/id"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "candidate_registry", "executable_pass_registry",
        "screening_base_pass_registry", "matrix", "screening"
      ],
      "properties": {
        "candidate_registry": {"$ref": "#/$defs/artifact"},
        "executable_pass_registry": {"$ref": "#/$defs/artifact"},
        "screening_base_pass_registry": {"$ref": "#/$defs/artifact"},
        "matrix": {"$ref": "#/$defs/artifact"},
        "screening": {"$ref": "#/$defs/artifact"}
      }
    },
    "run_record_schema_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_study_schema_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_freeze_schema_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_raw_evidence_schema_sha256": {"$ref": "#/$defs/sha256"},
    "raw_state_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "base_pipeline_profile": {"$ref": "#/$defs/profile"},
    "suites": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {"$ref": "#/$defs/suite"}
    },
    "study_ids": {
      "type": "object", "additionalProperties": false,
      "required": ["B2", "B3", "B4", "B5", "B6"],
      "properties": {
        "B2": {"$ref": "#/$defs/id"}, "B3": {"$ref": "#/$defs/id"},
        "B4": {"$ref": "#/$defs/id"}, "B5": {"$ref": "#/$defs/id"},
        "B6": {"$ref": "#/$defs/id"}
      }
    },
    "qualified_candidate_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "tasks": {"type": "array", "minItems": 16, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_id": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "nullable_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "nullable_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "nullable_path": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 4096}
      ]
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "canonical_sha256", "physical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "binary_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "physical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "profile_sha256", "path", "physical_sha256"],
      "properties": {
        "profile_id": {"const": "candidate-empty"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "suite": {
      "type": "object", "additionalProperties": false,
      "required": ["data_role", "suite_id", "manifest", "case_count"],
      "properties": {
        "data_role": {"enum": ["B1", "B2", "B3", "B4", "B5", "B6"]},
        "suite_id": {"$ref": "#/$defs/id"},
        "manifest": {"$ref": "#/$defs/artifact"},
        "case_count": {"enum": [20, 59, 60, 88, 140]}
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "candidate_id"],
      "properties": {
        "kind": {"enum": ["always", "b1_completed", "b2_formal_complete", "b3_promoted", "b3_has_promoted"]},
        "candidate_id": {"$ref": "#/$defs/nullable_id"}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_id", "task_type", "stage", "kind", "candidate_ids", "data_role",
        "run_id", "logical_profile_id", "candidate_profile_sha256",
        "candidate_profile_path", "reference_profile_id", "dependencies",
        "terminal_dependencies", "gate", "ranking_evidence"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "task_type": {"enum": ["run", "study", "freeze", "final"]},
        "stage": {"enum": ["B1", "B2", "freeze", "B3", "B4", "B5", "B6", "final"]},
        "kind": {"enum": ["candidate_empty", "single", "reference", "study", "freeze", "final"]},
        "candidate_ids": {
          "type": "array", "maxItems": 2, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "data_role": {"oneOf": [{"type": "null"}, {"enum": ["B1", "B2", "B3", "B4", "B5", "B6"]}]},
        "run_id": {"$ref": "#/$defs/nullable_id"},
        "logical_profile_id": {"$ref": "#/$defs/nullable_id"},
        "candidate_profile_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "candidate_profile_path": {"$ref": "#/$defs/nullable_path"},
        "reference_profile_id": {
          "oneOf": [{"type": "null"}, {"enum": ["gcc-13.3-o2", "clang-18-o3"]}]
        },
        "dependencies": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}
        },
        "terminal_dependencies": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}
        },
        "gate": {"$ref": "#/$defs/gate"},
        "ranking_evidence": {"type": "boolean"}
      }
    }
  }
}
