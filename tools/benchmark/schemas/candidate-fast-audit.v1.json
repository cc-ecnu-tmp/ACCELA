{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accela.invalid/schemas/candidate-fast-audit.v1.json",
  "title": "ACCELA fast campaign bounded checkpoint audit v1",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "audit_id", "campaign_id", "generated_at", "checkpoint",
    "bootstrap_sha256", "plan_sha256", "index_sha256", "status", "status_sha256",
    "scope_receipts", "checks", "passed", "audit_commitment_sha256"
  ],
  "properties": {
    "schema_version": {"const": "candidate-fast-audit.v1"},
    "audit_id": {"$ref": "#/$defs/id"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "generated_at": {"type": "string", "format": "date-time"},
    "checkpoint": {"enum": ["bootstrap", "B2", "B3", "final"]},
    "bootstrap_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "index_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"$ref": "#/$defs/artifact"},
    "status_sha256": {"$ref": "#/$defs/sha256"},
    "scope_receipts": {"type": "array", "items": {"$ref": "#/$defs/receipt_ref"}},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "passed": {"type": "boolean"},
    "audit_commitment_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "canonical_sha256", "physical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "physical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "receipt_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "task_id", "run_id", "receipt", "terminal_commitment_sha256"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "task_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "receipt": {"$ref": "#/$defs/artifact"},
        "terminal_commitment_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "outcome", "details_sha256"],
      "properties": {
        "check_id": {"$ref": "#/$defs/id"},
        "outcome": {"enum": ["passed", "failed"]},
        "details_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
